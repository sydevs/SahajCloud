{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:payloadcms.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:guides.scalar.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebSearch",
      "Bash(npx playwright test --list)",
      "Bash(pnpm exec playwright test --list)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(pnpm exec playwright install:*)",
      "Bash(pnpm vitest list:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test:int:*)",
      "Bash(pnpm test:e2e:*)",
      "Bash(NODE_ENV=test pnpm vitest:*)",
      "Bash(NODE_ENV=test pnpm vitest run:*)",
      "Bash(NODE_ENV=test pnpm test:int:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm tsx migration:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm eslint:*)",
      "Bash(pnpm build)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm rebuild:*)",
      "Bash(pnpm tsc:*)",
      "Bash(npx tsc:*)",
      "Bash(pnpm generate:types)",
      "Bash(pnpm generate:types:*)",
      "Bash(pnpm generate:importmap)",
      "Bash(pnpm generate:importmap:*)",
      "Bash(pnpm payload migrate:status:*)",
      "Bash(pnpm db:migrations:create:*)",
      "Bash(pnpm payload generate:types:*)",
      "Bash(NODE_ENV=development pnpm generate:types)",
      "Bash(NODE_ENV=development pnpm payload generate:types:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr close:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git log:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fetch:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(echo:*)",
      "Bash(awk:*)",
      "Bash(tee:*)",
      "Bash(lsof:*)",
      "Bash(which:*)",
      "Bash(nohup:*)",
      "Bash(sleep:*)",
      "Bash(sed:*)",
      "Bash(.claude/skills/dev-server/dev-server.sh:*)",
      "Bash(timeout 600 pnpm build:*)",
      "Bash(timeout 300 pnpm test:*)",
      "Bash(timeout 120 pnpm generate:*)",
      "Bash(time pnpm build:*)",
      "mcp__payloadcms-docs__*",
      "mcp__cloudflare-docs__*",
      "mcp__sentry__*",
      "mcp__github__*",
      "WebFetch(domain:mapi.nirmalavidya.org)",
      "mcp__puppeteer__puppeteer_navigate",
      "mcp__puppeteer__puppeteer_fill",
      "mcp__puppeteer__puppeteer_screenshot",
      "mcp__puppeteer__puppeteer_click",
      "mcp__puppeteer__puppeteer_evaluate",
      "Bash(npm view:*)",
      "Edit(.claude/docs/**)",
      "Write(.claude/docs/**)",
      "Bash(pnpm test:unit *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/status-line.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated-files.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-wrong-bash.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prettier-format.mjs"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-fix.mjs"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/payload-types-gen.mjs"
          }
        ]
      }
    ]
  }
}
