# ============================================
# REQUIRED ENVIRONMENT VARIABLES
# ============================================

# Payload CMS Secret Key
# VALIDATION: Minimum 32 characters for security
# Used for: JWT token signing, session encryption, API key hashing
PAYLOAD_SECRET=your-payload-secret-key-here-minimum-32-characters

# Live Preview URLs (required in all environments — no trailing slash; restart
# the dev server after changing: the CSP frame-src is baked at server boot)
WEMEDITATE_WEB_URL=http://localhost:5173
# Path the Atlas widget is mounted at on We Meditate. The canonical webUrl
# fallback for any region no client owns (#634). Optional, defaults to /map.
WEMEDITATE_ATLAS_BASE_PATH=/map
SAHAJATLAS_URL=http://localhost:5174

# Shared secret for trusted preview requests to read draft content (min 16 chars)
SAHAJCLOUD_PREVIEW_SECRET=your-preview-secret-here

# Database — Postgres in every environment (Railway in prod, local Postgres in dev).
# Required: `src/lib/env/server.ts` rejects a missing or empty value.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sahajcloud

# Postgres connection pool max (node-postgres pool.max). Size to the Railway
# Postgres connection limit divided across running instances. Default 10.
# DATABASE_POOL_MAX=10

# Drizzle query logging (SQL + params to console). Opt-in, force-disabled when
# NODE_ENV=production (so effectively local dev only). Captures the query trail
# behind a slow admin operation. WARNING: logs bound params (emails, tokens, API
# keys) — never enable against real or cloned prod data; use Railway
# log_min_duration_statement for server-side timings there instead.
# DB_QUERY_LOGGING=false

# ============================================
# OPTIONAL - DEVELOPMENT (Local Fallbacks)
# ============================================

# Logging Configuration
# Controls both Payload's Pino logger and client-side logger
# VALIDATION: 'silent' | 'error' | 'warn' | 'info' | 'debug'
NEXT_PUBLIC_LOG_LEVEL=info

# Wrangler Environment Selection
# Tells getPlatformProxy() to use [env.dev] configuration from wrangler.toml
CLOUDFLARE_ENV=dev

# ============================================
# OPTIONAL - PRODUCTION (Cloudflare Workers)
# ============================================

# Sentry Configuration (Optional - Production Only)
# Single DSN used for both client-side and server-side error tracking
# Only active when NODE_ENV=production
# VALIDATION: Must be a valid URL
# Get your DSN from: https://sentry.io/settings/projects/your-project/keys/
NEXT_PUBLIC_SENTRY_DSN=your-public-sentry-dsn-here
# SENTRY_AUTH_TOKEN=your-sentry-auth-token-here # Optional: Only needed for source map uploads
# Performance-tracing sample rate (0–1). Low non-zero (default 0.1) samples admin
# transactions with their DB-span breakdown. Set to 0 to disable tracing.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Mapbox (address autocomplete in the admin address field)
# Public token from https://account.mapbox.com — exposed to the browser.
# When unset, the address field falls back to plain manual entry.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-public-mapbox-token-here

# Email Configuration (Production - Resend)
# VALIDATION: Minimum 20 characters
# Free tier: 3,000 emails/month
RESEND_API_KEY=your-resend-api-key-here

# Public support / contact address — shown in admin mailto links and used as the
# transactional from/to address. Exposed to the browser (NEXT_PUBLIC_).
# Defaults to contact@sydevelopers.com when unset.
NEXT_PUBLIC_CONTACT_EMAIL=contact@sydevelopers.com

# Cloudflare Turnstile secret key — server-side captcha verification for
# POST /api/contact-admin. Required in production (set it in Railway); the
# endpoint fails closed with a 500 when it is unset, never a silent pass.
# The value below is Cloudflare's "always passes" TEST key — fine for local dev
# and CI, never for production. Always-fails test key: 2x0000000000000000000000000000000AA
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Application URLs
# Development: SAHAJCLOUD_URL is automatically derived from PORT env var
# via src/lib/serverUrl.ts - no need to set it manually for development
# Production: Set explicitly for deployment
# SAHAJCLOUD_URL=https://cloud.sydevelopers.com

# Live Preview URLs (Production)
# Update the required URLs above to point to production frontends.
# Example:
# WEMEDITATE_WEB_URL=https://wemeditate.com
# SAHAJATLAS_URL=https://atlas.sydevelopers.com

# ============================================
# CLOUDFLARE STORAGE (Production Only)
# ============================================
# Development: Automatically falls back to local file storage (no config needed)
# Production: Required when deploying to Cloudflare Workers

# Cloudflare Account Information
# Find in Dashboard → Account Home → right sidebar
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Unified API Token for Images & Stream
# API Token with "Account.Cloudflare Images:Edit" and "Account.Stream:Edit" permissions
# VALIDATION: Minimum 20 characters
# In production, set via: wrangler secret put CLOUDFLARE_API_KEY
CLOUDFLARE_API_KEY=your-unified-api-token

# Cloudflare Images Delivery URL
# Find in Images dashboard → copy full delivery URL including hash
# VALIDATION: Must be valid HTTPS URL
# Format: https://imagedelivery.net/<hash>
CLOUDFLARE_IMAGES_DELIVERY_URL=https://imagedelivery.net/your-hash

# Cloudflare Stream Delivery URL
# Find in Stream dashboard → copy full player URL base
# VALIDATION: Must be valid HTTPS URL
# Format: https://customer-<code>.cloudflarestream.com
CLOUDFLARE_STREAM_DELIVERY_URL=https://customer-your-code.cloudflarestream.com

# Cloudflare R2 Delivery URL
# Custom domain configured in Cloudflare R2 + CDN
# VALIDATION: Must be valid HTTPS URL
# Format: https://assets.yourdomain.com
# Development: Falls back to local file storage (not needed)
# Production: https://assets.sydevelopers.com
CLOUDFLARE_R2_DELIVERY_URL=https://assets.sydevelopers.com

# Cloudflare Stream Webhook Signing Secret (production only)
# Returned when registering the webhook via scripts/setup-stream-webhook.ts.
# Used to verify HMAC-SHA256 signatures on inbound webhooks.
# VALIDATION: At least 32 characters
# Set via: wrangler secret put CLOUDFLARE_STREAM_WEBHOOK_SECRET
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# ============================================
# NIRMALA VIDYA API (Required)
# ============================================
# Used for fetching lecture metadata from Vimeo when creating new lectures
# VALIDATION: Minimum 20 characters
NIRMALA_VIDYA_API_KEY=your-nirmala-vidya-api-key-here

# ============================================
# SEED SCRIPTS (Optional)
# ============================================
# Required only when running data import/seed scripts

# Admin User Credentials (for seed scripts authentication)
# VALIDATION: ADMIN_EMAIL must be valid email, ADMIN_PASSWORD min 8 chars
ADMIN_EMAIL=contact@sydevelopers.com
ADMIN_PASSWORD=your-admin-password-here

# Storyblok CMS Import
# Required only for importing content from Storyblok (pnpm seed storyblok)
# STORYBLOK_ACCESS_TOKEN=your-storyblok-token-here

# R2 S3-Compatible API Credentials (for reset-storage script)
# Create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Permissions: Object Read & Write for the bucket
# Required for: pnpm reset:prod, pnpm reset:all
# CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ============================================
# API DOCUMENTATION PROTECTION (Optional)
# ============================================
# When set, password-protects the /api/docs endpoint via HTTP Basic Auth.
# Any username is accepted; only the password is checked.
# Omit or leave blank to keep docs publicly accessible (e.g. local dev).
# VALIDATION: Minimum 8 characters
# Production: set via wrangler secret put DOCS_PASSWORD
# DOCS_PASSWORD=your-docs-password-here

# ============================================
# VALIDATION NOTES
# ============================================
# All environment variables are validated at module load time using Zod schemas (src/lib/env.ts)
#
# Validation errors will show:
# - Which variable failed validation
# - What the validation rule is (e.g., "String must contain at least 32 character(s)")
# - Clear error messages to help you fix the issue
#
# Optional variables:
# - Cloudflare variables are optional in development (falls back to local storage)
# - Email variables are optional in development (uses Ethereal Email)
# - Sentry DSN is optional (error tracking disabled when not set)
#
# Required vs Optional strategy:
# - DEVELOPMENT: Only PAYLOAD_SECRET is required
# - PRODUCTION: PAYLOAD_SECRET + Cloudflare credentials (when env binding provided)
