{
  "name": "sy-devs-cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . --max-warnings 0",
    "postinstall": "node scripts/postinstall.cjs",
    "test": "pnpm run test:unit && pnpm run test:int",
    "test:smoke": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project int --config ./vitest.config.mts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project unit --config ./vitest.config.mts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx seeds/run.ts",
    "seed:dev": "cross-env NODE_OPTIONS=--no-deprecation ADMIN_EMAIL=contact@sydevelopers.com ADMIN_PASSWORD=evk1VTH5dxz_nhg-mzk tsx seeds/run.ts",
    "seed:prod": "cross-env NODE_OPTIONS=--no-deprecation SAHAJCLOUD_URL=https://cloud.sydevelopers.com ADMIN_EMAIL=contact@sydevelopers.com tsx seeds/run.ts",
    "reset": "cross-env NODE_OPTIONS=--no-deprecation tsx seeds/reset-storage.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types && pnpm generate:statusConfig",
    "generate:statusConfig": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/generate-status-config.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:migrations:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "deploy:prod": "pnpm run db:migrate && pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/lib-storage": "^3.1055.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@lexical/react": "0.41.0",
    "@lexical/rich-text": "0.41.0",
    "@payloadcms/db-postgres": "^3.85.0",
    "@payloadcms/email-nodemailer": "^3.85.0",
    "@payloadcms/next": "^3.85.0",
    "@payloadcms/plugin-cloud-storage": "^3.85.0",
    "@payloadcms/plugin-form-builder": "^3.85.0",
    "@payloadcms/plugin-seo": "^3.85.0",
    "@payloadcms/richtext-lexical": "^3.85.0",
    "@payloadcms/ui": "^3.85.0",
    "@sentry/nextjs": "^10.29.0",
    "@sentry/react": "^10.29.0",
    "@types/styled-components": "^5.1.35",
    "aws-crt": "^1.27.5",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "i18n-iso-countries": "^7.14.0",
    "image-size": "^2.0.2",
    "iso-639-1": "^3.1.5",
    "lexical": "0.41.0",
    "music-metadata": "^11.12.3",
    "next": "^16.2.6",
    "payload": "^3.85.0",
    "payload-oapi": "^0.2.5",
    "pg": "^8.16.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-inlinesvg": "^4.2.0",
    "react-range": "^1.10.0",
    "resend": "^6.5.2",
    "rrule-temporal": "^1.4.5",
    "slugify": "^1.6.6",
    "styled-components": "^6.1.19",
    "swr": "^2.3.8",
    "tmp": "^0.2.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@payloadcms/typescript-plugin": "^3.85.0",
    "@playwright/test": "1.57.0",
    "@testing-library/react": "16.3.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.18.13",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "@types/tmp": "^0.2.6",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "26.1.0",
    "nodemailer": "^7.0.10",
    "playwright": "1.57.0",
    "playwright-core": "1.57.0",
    "prettier": "^3.6.2",
    "qs-esm": "8.0.1",
    "tsx": "^4.20.6",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "ignoreMissing": []
    }
  }
}
