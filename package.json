{
  "name": "sy-devs-cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -rf .next/cache/turbopack && NODE_OPTIONS=--max-old-space-size=8000 next build && node scripts/standalone-postbuild.mjs",
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "start": "HOSTNAME=0.0.0.0 NODE_OPTIONS=--max-http-header-size=65536 node .next/standalone/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "audit": "pnpm audit --audit-level=high",
    "postinstall": "node scripts/postinstall.cjs",
    "test": "pnpm run test:unit && pnpm run test:int",
    "test:smoke": "pnpm exec playwright test",
    "test:int": "vitest run --project int --config ./vitest.config.mts",
    "test:unit": "vitest run --project unit --config ./vitest.config.mts",
    "test:coverage": "vitest run --coverage --config ./vitest.config.mts",
    "seed": "tsx seeds/run.ts",
    "seed:prod": "SAHAJCLOUD_URL=https://cloud.sydevelopers.com tsx seeds/run.ts",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types && pnpm generate:statusConfig",
    "generate:statusConfig": "tsx scripts/generate-status-config.ts",
    "generate:preview-keypair": "tsx scripts/generate-live-preview-keypair.ts",
    "payload": "payload",
    "db:migrate": "payload migrate",
    "db:migrations:create": "payload migrate:create"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@lexical/react": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@mapbox/search-js-react": "^1.6.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-cloud-storage": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-import-export": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@photostructure/tz-lookup": "^11.7.0",
    "@sentry/nextjs": "^10.76.2",
    "@touch4it/ical-timezones": "^1.9.0",
    "@types/styled-components": "^5.1.36",
    "@vvo/tzdb": "6.198.0",
    "country-region-data": "^4.1.0",
    "csv-stringify": "^6.9.0",
    "diff": "^9.0.0",
    "dotenv": "16.4.7",
    "ical-generator": "^11.1.2",
    "iso-639-1": "^3.1.6",
    "jose": "5.10.0",
    "lexical": "0.50.0",
    "lucide-react": "^1.59.0",
    "mailchecker": "^6.0.21",
    "microdiff": "^1.6.0",
    "music-metadata": "^11.16.1",
    "next": "^16.4.2",
    "p-map": "^7.1.1",
    "p-retry": "^8.0.1",
    "payload": "3.90.2",
    "payload-oapi": "^0.2.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.3",
    "react-inlinesvg": "^4.5.0",
    "react-range": "^1.10.0",
    "resend": "^6.34.1",
    "rrule-temporal": "1.4.5",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "styled-components": "^6.6.0",
    "swr": "^2.5.1",
    "tmp": "^0.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@payloadcms/typescript-plugin": "3.90.2",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tmp": "^0.2.6",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "4.1.12",
    "csv-parse": "5.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "26.1.0",
    "nodemailer": "^10.1.7",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "qs-esm": "8.0.2",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@11.5.2"
}
