,"end":398.32},{"text":"massage","start":398.32,"end":398.78},{"text":"it","start":398.78,"end":399.02},{"text":"clockwise,","start":399.02,"end":399.76}]},{"text":"pressing down quite firmly.","start":400.2,"end":401.8,"words":[{"text":"pressing","start":400.2,"end":400.54},{"text":"down","start":400.54,"end":400.84},{"text":"quite","start":400.84,"end":401.06},{"text":"firmly.","start":401.06,"end":401.8}]},{"text":"Mother Kundalini, please awaken on top of my head.","start":409.68,"end":412.16,"words":[{"text":"Mother","start":409.68,"end":409.96},{"text":"Kundalini,","start":409.96,"end":410.74},{"text":"please","start":410.74,"end":410.74},{"text":"awaken","start":410.74,"end":411.2},{"text":"on","start":411.2,"end":411.42},{"text":"top","start":411.42,"end":411.56},{"text":"of","start":411.56,"end":411.8},{"text":"my","start":411.8,"end":411.8},{"text":"head.","start":411.8,"end":412.16}]},{"text":"Let me feel your guiding light of love and let that love guide me to be the self-confident person that I am and nothing else.","start":418.14,"end":432.62,"words":[{"text":"Let","start":418.14,"end":418.38},{"text":"me","start":418.38,"end":418.58},{"text":"feel","start":418.58,"end":418.8},{"text":"your","start":418.8,"end":419.04},{"text":"guiding","start":419.04,"end":419.32},{"text":"light","start":419.32,"end":419.66},{"text":"of","start":419.66,"end":419.9},{"text":"love","start":419.9,"end":420.28},{"text":"and","start":423.68,"end":424},{"text":"let","start":424,"end":424.2},{"text":"that","start":424.2,"end":424.44},{"text":"love","start":424.44,"end":424.86},{"text":"guide","start":424.86,"end":425.36},{"text":"me","start":425.36,"end":425.58},{"text":"to","start":425.58,"end":425.78},{"text":"be","start":425.78,"end":426.16},{"text":"the","start":427.5,"end":427.88},{"text":"self-confident","start":427.88,"end":428.66},{"text":"person","start":428.66,"end":429.46},{"text":"that","start":429.72,"end":430.02},{"text":"I","start":430.02,"end":430.14},{"text"