}]},{"text":"My family, my nationality, my job, my education.","start":142.2,"end":149.7,"words":[{"text":"My","start":142.2,"end":142.44},{"text":"family,","start":142.44,"end":143.54},{"text":"my","start":144.38,"end":144.52},{"text":"nationality,","start":144.52,"end":145.96},{"text":"my","start":146.28,"end":146.48},{"text":"job,","start":146.48,"end":147.5},{"text":"my","start":148.48,"end":148.62},{"text":"education.","start":148.62,"end":149.7}]},{"text":"Please take away all these false identities so that I may feel the reality of myself.","start":152.52,"end":161.34,"words":[{"text":"Please","start":152.52,"end":153.06},{"text":"take","start":153.06,"end":153.8},{"text":"away","start":154.06,"end":154.34},{"text":"all","start":154.34,"end":154.64},{"text":"these","start":154.64,"end":154.82},{"text":"false","start":154.82,"end":155.18},{"text":"identities","start":155.18,"end":155.94},{"text":"so","start":155.94,"end":156.72},{"text":"that","start":158.06,"end":158.28},{"text":"I","start":158.28,"end":158.44},{"text":"may","start":158.44,"end":158.66},{"text":"feel","start":158.66,"end":159.16},{"text":"the","start":159.16,"end":159.54},{"text":"reality","start":159.54,"end":159.96},{"text":"of","start":159.96,"end":160.62},{"text":"myself.","start":160.62,"end":161.34}]},{"text":"Mother Kundalini, please enable me to dive","start":176.42,"end":182.04,"words":[{"text":"Mother","start":176.42,"end":176.8},{"text":"Kundalini,","start":176.8,"end":177.94},{"text":"please","start":178.86,"end":179.12},{"text":"enable","start":179.12,"end":179.56},{"text":"me","start":179.56,"end":180.1},{"text":"to","start":180.1,"end":180.48},{"text":"dive","start":181.6,"end":182.04}]},{"text":"Into the depths of my being where I will find pure unconditional love for myself and for all others.","start":183.32,"end":196,"words":[{"text":"Into","start":183.32,"end":183.32},{"text":"the","start":183.32,"end":183.6},{"text":"depths","start":183.6,"end":183.98},{"text":"of","start":183.98,"end":184.28},{"text":"my","start":184.28,"end":184.5},{"text":"being","start":184.5,"end":184.86},{"text":"where","start":184.86,"end":185.4},{"text":"I","start":188.84,"end":189.06},{"text":"will","start":189.06,"end":189.26},{"text":"find","start":189.26,"end":189.88},{"text":"pure","start":189.88,"end":190.56},{"text":"unconditional","start":191.5,"end":192.42},{"text":"love","start":192.42,"end":193.04},{"text":"for","start":193.04,"end":193.34},{"text":"myself","start":193.34,"end":193.9},{"text":"and","start":193.9,"end":194.66},{"text":"for","start":194.66,"end":194.9},{"text":"all","start":194.9,"end":195.14},{"text":"others.","start":195.14,"end":196}]},{"text":"Please help me to enjoy myself and others so that I can appreciate them and love them.","start":202.82,"end":214.06,"words":[{"text":"Please","start":202.82,"end":202.98},{"text":"help","start":202.98,"end":203.22},{"text":"me","start":203.22,"end":203.42},{"text":"to","start":203.42,"end":203.6},{"text":"enjoy","start":203.6,"end":203.96},{"text":"myself","start":203.96,"end":205.1},{"text":"and","start":205.94,"end":206.62},{"text":"others","start":206.94,"end":207.52},{"text":"so","start":207.52,"end":208.08},{"text":"that","start":211.08,"end":211.28},{"text":"I","start":211.28,"end":211.4},{"text":"can","start":211.4,"end":211.52},{"text":"appreciate","start":211.52,"end":211.96},{"text":"them","start":211.96,"end":212.66},{"text":"and","start":212.66,"end":213.12},{"text":"love","start":213.12,"end":213.32},{"text":"them.","start":213.32,"end":214.06}]},{"text":"We can bring the right hand onto the forehead and ask, Mother please remove all thoughts","start":225.44,"end":237.38,"words":[{"text":"We","start":225.44,"end":225.54},{"text":"can","start":225.54,"end":225.78},{"text":"bring","start":225.78,"end":226.04},{"text":"the","start":226.04,"end":226.24},{"text":"right","start":226.24,"end":226.48},{"text":"hand","start":226.48,"end":226.9},{"text":"onto","start":226.9,"end":227.22},{"text":"the","start":227.22,"end":227.46},{"text":"forehead","start":227.46,"end":227.78},{"text":"and","start":227.78,"end":228.44},{"text":"ask,","start":233.7,"end":234.32},{"text":"Mother","start":234.32,"end":234.86},{"text":"please","start":235.46,"end":235.94},{"text":"remove","start":235.94,"end":236.38},{"text":"all","start":236.38,"end":236.82},{"text":"thoughts","start":236.82,"end":237.38}]},{"text":"that prevent me from being completely absorbed by love and led by my heart.","start":238.26,"end":246.24,"words":[{"text":"that","start":238.26,"end":238.26},{"text":"prevent","start":238.26,"end":238.58},{"text":"me","start":238.58,"end":239.16},{"text":"from","start":240.26,"end":240.66},{"text":"being","start":240.66,"end":241.18},{"text":"completely","start":241.18,"end":242.06},{"text":"absorbed","start":242.06,"end":243.02},{"text":"by","start":243.02,"end":243.42},{"text":"love","start":243.42,"end":243.9},{"text":"and","start":244.82,"end":245.14},{"text":"led","start":245.14,"end":245.4},{"text":"by","start":245.4,"end":245.7},{"text":"my","start":245.7,"end":245.86},{"text":"heart.","start":245.86,"end":246.24}]},{"text":"Finally, we can bring the right palm on the top of the head and press down slightly and ask,","start":261.54,"end":272.64,"words":[{"text":"Finally,","start":261.54,"end":262.78},{"text":"we","start":263.42,"end":263.44},{"text":"can","start":263.44,"end":263.6},{"text":"bring","start":263.6,"end":264},{"text":"the","start":264,"end":264.3},{"text":"right","start":264.3,"end":264.5},{"text":"palm","start":264.5,"end":264.98},{"text":"on","start":264.98,"end":265.44},{"text":"the","start":265.44,"end":265.6},{"text":"top","start":265.6,"end":265.74},{"text":"of","start":265.74,"end":265.94},{"text":"the","start":265.94,"end":266.12},{"text":"head","start":266.12,"end":266.42},{"text":"and","start":266.42,"end":266.86},{"text":"press","start":267.42,"end":267.68},{"text":"down","start":267.68,"end":268},{"text":"slightly","start"