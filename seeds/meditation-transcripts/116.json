":"I","start":292.46,"end":292.64},{"text":"am","start":292.64,"end":292.86},{"text":"absolutely","start":292.86,"end":293.32},{"text":"not","start":293.32,"end":293.68},{"text":"guilty.","start":293.68,"end":294.52}]},{"text":"And I will face myself. Then we can raise our right hand onto our forehead.","start":296.36,"end":333.68,"words":[{"text":"And","start":296.36,"end":296.58},{"text":"I","start":296.58,"end":296.6},{"text":"will","start":296.6,"end":296.78},{"text":"face","start":296.78,"end":297.26},{"text":"myself.","start":297.26,"end":298.36},{"text":"Then","start":299.06,"end":299.46},{"text":"we","start":331.44,"end":331.58},{"text":"can","start":331.58,"end":331.76},{"text":"raise","start":331.76,"end":332.1},{"text":"our","start":332.1,"end":332.44},{"text":"right","start":332.44,"end":332.6},{"text":"hand","start":332.6,"end":332.84},{"text":"onto","start":332.84,"end":333.1},{"text":"our","start":333.1,"end":333.36},{"text":"forehead.","start":333.36,"end":333.68}]},{"text":"Keeping our palm pressed against our forehead and slightly bowing our head into our hand.","start":334.9,"end":340.64,"words":[{"text":"Keeping","start":334.9,"end":334.94},{"text":"our","start":334.94,"end":335.22},{"text":"palm","start":335.22,"end":335.7},{"text":"pressed","start":335.7,"end":336.12},{"text":"against","start":336.12,"end":336.4},{"text":"our","start":336.4,"end":336.6},{"text":"forehead","start":336.6,"end":336.92},{"text":"and","start":336.92,"end":337.58},{"text":"slightly","start":338.54,"end":338.9},{"text":"bowing","start":338.9,"end":339.4},{"text":"our","start":339.4,"end":339.52},{"text":"head","start":339.52,"end":339.7},{"text":"into","start":339.7,"end":339.94},{"text":"our","start":339.94,"end":340.22},{"text":"hand.","start":340.22,"end":340.64}]},{"text":"Here we can ask this mothering energy.","start":349.22,"end":351.98,"words":[{"text":"Here","start":349.22,"end":349.44},{"text":"we","start":349.44,"end":349.58},{"text":"can","start":349.58,"end":349.84},{"text":"ask","start":349.84,"end":350.22},{"text":"this","start":350.22,"end":350.82},{"text":"mothering","start":350.82,"end":351.22},{"text":"energy.","start":351.22,"end":351.98}]},{"text":"Mother Kundalini, please make me humble. Please make me humble.","start":352.38,"end":366.98,"words":[{"text":"Mother","start":352.38,"end":352.64},{"text":"Kundalini,","start":352.64,"end":353.66},{"text":"please","start":354.16,"end":354.34},{"text":"make","start":354.34,"end":354.6},{"text":"me","start":354.6,"end":354.8},{"text":"humble.","start":354.8,"end":355.5},{"text":"Please","start":365.44,"end":365.62},{"text":"make","start":365.62,"end":365.98},{"text":"me","start":365.98,"end":366.2},{"text":"humble.","start":366.2,"end":366.98}]},{"text":"I forgive any thoughts that I may have. I forgive any wrong ideas I've had.","start":386.2,"end":393.4,"words":[{"text":"I","start":386.2,"end":386.36},{"text":"forgive","start":386.36,"end":386.76},{"text":"any","start":386.76,"end":387.52},{"text":"thoughts","start":388.1,"end":388.62},{"text":"that","start":388.62,"end":389.3},{"text":"I","start":389.3,"end":389.42},{"text":"may","start":389.42,"end":389.56},{"text":"have.","start":389.56,"end":390.22},{"text":"I","start":391.18,"end":391.32},{"text":"forgive","start":391.32,"end":391.64},{"text":"any","start":391.64,"end":391.94},{"text":"wrong","start":391.94,"end":392.18},{"text":"ideas","start":392.18,"end":392.52},{"text":"I've","start":392.52,"end":392.96},{"text":"had.","start":392.96,"end":393.4}]},{"text":"I forgive everyone and I forgive everything and I also forgive myself.","start":405.02,"end":411.02,"words":[{"text":"I","start":405.02,"end":405.1},{"text":"forgive","start":405.1,"end":405.4},{"text":"everyone","start":405.4,"end":405.88},{"text":"and","start":405.88,"end":406.66},{"text":"I","start":406.66,"end":406.78},{"text":"forgive","start":406.78,"end":407},{"text":"everything","start":407,"end":407.54},{"text":"and","start":407.54,"end":408.