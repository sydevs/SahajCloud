,"end":186.54},{"text":"mouth","start":186.54,"end":186.74},{"text":"and","start":186.74,"end":187.1},{"text":"again","start":190.94,"end":191.28},{"text":"hold","start":191.28,"end":191.72},{"text":"it","start":191.72,"end":192.16},{"text":"once","start":192.16,"end":192.22},{"text":"we've","start":192.22,"end":192.56},{"text":"exhaled","start":192.56,"end":192.92},{"text":"all","start":192.92,"end":192.92},{"text":"our","start":192.92,"end":193.22},{"text":"air","start":193.22,"end":193.58},{"text":"and","start":193.58,"end":194},{"text":"breathe","start":196.18,"end":196.42},{"text":"in.","start":196.42,"end":196.82}]},{"text":"Breathe out. We can repeat this process.","start":206.62,"end":213.64,"words":[{"text":"Breathe","start":206.62,"end":207.14},{"text":"out.","start":207.14,"end":208.04},{"text":"We","start":211.98,"end":211.98},{"text":"can","start":211.98,"end":212.16},{"text":"repeat","start":212.16,"end":212.4},{"text":"this","start":212.4,"end":212.66},{"text":"process.","start":212.66,"end":213.64}]},{"text":"Then we can bring our right hand onto the left side of our neck and rotate our head a little bit to the right.","start":250.98,"end":257.78,"words":[{"text":"Then","start":250.98,"end":251.1},{"text":"we","start":251.1,"end":251.12},{"text":"can","start":251.12,"end":251.3},{"text":"bring","start":251.3,"end":251.54},{"text":"our","start":251.54,"end":251.76},{"text":"right","start":251.76,"end":252.02},{"text":"hand","start":252.02,"end":252.22},{"text":"onto","start":252.22,"end":252.48},{"text":"the","start":252.48,"end":252.68},{"text":"left","start":252.68,"end":252.84},{"text":"side","start":252.84,"end":253.1},{"text":"of","start":253.1,"end":253.3},{"text":"our","start":253.3,"end":253.4},{"text":"neck","start":253.4,"end":253.66},{"text":"and","start":254.56,"end":255.02},{"text":"rotate","start":255.02,"end":255.34},{"text":"our","start":255.34,"end":255.74},{"text":"head","start":255.74,"end":256.12},{"text":"a","start":256.12,"end":2