"start":81.2,"end":81.6}]},{"text":"And now we can affirm.","start":96.7,"end":97.66,"words":[{"text":"And","start":96.7,"end":96.88},{"text":"now","start":96.88,"end":97.06},{"text":"we","start":97.06,"end":97.12},{"text":"can","start":97.12,"end":97.28},{"text":"affirm.","start":97.28,"end":97.66}]},{"text":"Mother, I am the pure spirit. I am nothing more, nothing less.","start":98.96,"end":103.88,"words":[{"text":"Mother,","start":98.96,"end":99.26},{"text":"I","start":99.26,"end":99.3},{"text":"am","start":99.3,"end":99.44},{"text":"the","start":99.44,"end":99.58},{"text":"pure","start":99.58,"end":99.8},{"text":"spirit.","start":99.8,"end":100.74},{"text":"I","start":101.46,"end":101.56},{"text":"am","start":101.56,"end":101.62},{"text":"nothing","start":101.62,"end":101.9},{"text":"more,","start":101.9,"end":102.8},{"text":"nothing","start":102.8,"end":103},{"text":"less.","start":103,"end":103.88}]},{"text":"Nor this mind, nor this ego, nor these thoughts, emotions, nor this body or these actions.","start":119.62,"end":134.2,"words":[{"text":"Nor","start":119.62,"end":119.76},{"text":"this","start":119.76,"end":120},{"text":"mind,","start":120,"end":120.84},{"text":"nor","start":120.84,"end":120.94},{"text":"this","start":120.94,"end":121.12},{"text":"ego,","start":121.12,"end":122},{"text":"nor","start":126,"end":126.12},{"text":"these","start":126.12,"end":126.3},{"text":"thoughts,","start":126.3,"end":126.96},{"text":"emotions,","start":126.96,"end":127.98},{"text":"nor","start":131.98,"end":132.14},{"text":"this","start":132.14,"end":132.36},{"text":"body","start":132.36,"end":132.7},{"text":"or","start":132.7,"end":133.14},{"text":"these","start":133.14,"end":133.38},{"text":"actions.","start":133.38,"end":134.2}]},{"text":"I am nothing but the pure spirit. Mother, I am the spirit.","start":138.4,"end":151.52,"words":[{"text":"I","start":138.4,"end":138.5},{"text":"am","start":138.5,"end":138.52},{"text":"nothing","start":138.52,"end":138.78},{"text":"bu