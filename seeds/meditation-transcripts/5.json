","start":73.64,"end":73.78},{"text":"are.","start":73.78,"end":74.42},{"text":"It","start":81.52,"end":81.64},{"text":"brings","start":81.64,"end":82.06},{"text":"our","start":82.06,"end":82.4},{"text":"attention","start":82.4,"end":82.88},{"text":"inside.","start":82.88,"end":84.08}]},{"text":"Take a few deep breaths to calm down and bring yourself into the present moment.","start":93.24,"end":103.8,"words":[{"text":"Take","start":93.24,"end":93.5},{"text":"a","start":93.5,"end":93.74},{"text":"few","start":93.74,"end":93.94},{"text":"deep","start":93.94,"end":94.2},{"text":"breaths","start":94.2,"end":94.74},{"text":"to","start":94.74,"end":95.26},{"text":"calm","start":97.5,"end":97.82},{"text":"down","start":97.82,"end":98.46},{"text":"and","start":100.98,"end":101.4},{"text":"bring","start":101.4,"end":101.7},{"text":"yourself","start":101.7,"end":102.02},{"text":"into","start":102.02,"end":102.44},{"text":"the","start":102.44,"end":102.68},{"text":"present","start":102.68,"end":102.94},{"text":"moment.","start":102.94,"end":103.8}]},{"text":"Place your right hand on the heart on the left hand side.","start":116.4,"end":122.4,"words":[{"text":"Place","start":116.4,"end":116.68},{"text":"your","start":116.68,"end":116.96},{"text":"right","start":116.96,"end":117.22},{"text":"hand","start":117.22,"end":117.72},{"text":"on","start":117.72,"end":118.2},{"text":"the","start":119.86,"end":120.04},{"text":"heart","start":120.04,"end":120.44},{"text":"on","start":120.44,"end":120.86},{"text":"the","start":121.14,"end":121.32},{"text":"left","start":121.32,"end":121.52},{"text":"hand","start":121.52,"end":121.82},{"text":"side.","start":121.82,"end":122.4}]},{"text":"The spirit is the most precious thing we have within ourselves.","start":128.26,"end":131.84,"words":[{"text":"The","start":128.26,"end":128.28},{"text":"spirit","start":128.28,"end":128.56},{"text":"is","start":128.56,"end":128.86},{"text":"the","start":128.86,"end":129.02},{"text":"most","start":129.02,"