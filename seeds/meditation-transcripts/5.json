","start":495.02,"end":495.18},{"text":"it","start":495.18,"end":495.38},{"text":"guide","start":495.38,"end":495.62},{"text":"you","start":495.62,"end":495.86},{"text":"throughout","start":495.86,"end":496.14},{"text":"the","start":496.14,"end":496.44},{"text":"day.","start":496.44,"end":497}]},{"text":"Let it silence your mind. Keep meditating on your spirit, Mother, the pure spirit.","start":502.18,"end":558.62,"words":[{"text":"Let","start":502.18,"end":502.38},{"text":"it","start":502.38,"end":502.64},{"text":"silence","start":502.64,"end":503.04},{"text":"your","start":503.04,"end":503.48},{"text":"mind.","start":503.48,"end":504.3},{"text":"Keep","start":534.8,"end":535},{"text":"meditating","start":535,"end":535.56},{"text":"on","start":535.56,"end":536.52},{"text":"your","start":537.3,"end":537.54},{"text":"spirit,","start":537.54,"end":538.54},{"text":"Mother,","start":554.46,"end":555.18},{"text":"the","start":557.46,"end":557.5},{"text":"pure","start":557.5,"end":557.84},{"text":"spirit.","start":557.84,"end":558.62}]},{"text":"Please let me let go of any other identifications within me.","start":572.04,"end":578.1,"words":[{"text":"Please","start":572.04,"end":572.38},{"text":"let","start":572.38,"end":572.68},{"text":"me","start":572.68,"end":572.96},{"text":"let","start":572.96,"end":573.2},{"text":"go","start":573.2,"end":573.44},{"text":"of","start":573.44,"end":573.72},{"text":"any","start":573.72,"end":573.94},{"text":"other","start":573.94,"end":574.22},{"text":"identifications","start":574.22,"end":575.32},{"text":"within","start":575.32,"end":576.02},{"text":"me.","start":577.62,"end":578.1}]},{"text":"To take me away from being the spirit.","start":585.22,"end":587.34,"words":[{"text":"To","start":585.22,"end":585.36},{"text":"take","start":585.36,"end":585.54},{"text":"me","start":585.54,"end":585.76},{"text":"away","start":585.76,"end":586.18},{"text":"from","start":586.18,"end":586.42},{"text":"being","start":586.42,"end":586.76},{"text":"t