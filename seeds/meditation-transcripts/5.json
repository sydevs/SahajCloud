{"meditationId":5,"audioFilename":"meditation-on-spirit-aev9dftvbc.mp3","language":"english","provider":"lemonfox","segments":[{"text":"Find a comfortable place to sit, on the ground or on a chair.","start":2.94,"end":7.68,"words":[{"text":"Find","start":2.94,"end":3.48},{"text":"a","start":3.48,"end":3.74},{"text":"comfortable","start":3.74,"end":4},{"text":"place","start":4,"end":4.44},{"text":"to","start":4.44,"end":4.66},{"text":"sit,","start":4.66,"end":5.38},{"text":"on","start":5.76,"end":5.86},{"text":"the","start":5.86,"end":6},{"text":"ground","start":6,"end":6.38},{"text":"or","start":6.38,"end":6.74},{"text":"on","start":6.74,"end":6.92},{"text":"a","start":6.92,"end":7.08},{"text":"chair.","start":7.08,"end":7.68}]},{"text":"Place your hands open, palm facing upwards, on your lap.","start":10.58,"end":16.14,"words":[{"text":"Place","start":10.58,"end":10.76},{"text":"your","start":10.76,"end":11.04},{"text":"hands","start":11.04,"end":11.46},{"text":"open,","start":11.46,"end":12.82},{"text":"palm","start":13.42,"end":13.6},{"text":"facing","start":13.6,"end":13.94},{"text":"upwards,","start":13.94,"end":15.1},{"text":"on","start":15.38,"end":15.48},{"text":"your","start":15.48,"end":15.62},{"text":"lap.","start":15.62,"end":16.14}]},{"text":"This meditation will focus on our spirit.","start":23.3,"end":30.56,"words":[{"text":"This","start":23.3,"end":23.52},{"text":"meditation","start":23.52,"end":24.08},{"text":"will","start":24.08,"end":24.96},{"text":"focus","start":26.96,"end":27.42},{"text":"on","start":27.42,"end":28.22},{"text":"our","start":29.18,"end":29.94},{"text":"spirit.","start":29.94,"end":30.56}]},{"text":"The spirit which resides in our heart is the only eternal thing within us.","start":35.32,"end":43.12,"words":[{"text":"The","start":35.32,"end":35.32},{"text":"spirit","start":35.32,"end":35.72},{"text":"which","start":35.72,"end":36.2},{"text":"resides","start":36.2,"end":36.76},{"text":"in","start":36.76,"end":37.22},{"text":"our",