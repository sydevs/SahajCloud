d":850.68},{"text":"bring","start":850.68,"end":850.86},{"text":"your","start":850.86,"end":851.08},{"text":"attention","start":851.08,"end":851.42},{"text":"back","start":851.42,"end":851.82},{"text":"to","start":851.82,"end":852.02},{"text":"the","start":852.02,"end":852.12},{"text":"top","start":852.12,"end":852.32},{"text":"of","start":852.32,"end":852.58},{"text":"your","start":852.58,"end":852.72},{"text":"head.","start":852.72,"end":853.14}]},{"text":"I hope you feel a little more balanced and thank you very much for joining this evening meditation.","start":879.54,"end":889.68,"words":[{"text":"I","start":879.54,"end":879.72},{"text":"hope","start":879.72,"end":879.94},{"text":"you","start":879.94,"end":880.08},{"text":"feel","start":880.08,"end":880.28},{"text":"a","start":880.28,"end":880.4},{"text":"little","start":880.4,"end":880.62},{"text":"more","start":880.62,"end":880.84},{"text":"balanced","start":880.84,"end":881.22},{"text":"and","start":881.22,"end":882.06},{"text":"thank","start":886.28,"end":886.6},{"text":"you","start":886.6,"end":886.78},{"text":"very","start":886.78,"end":886.96},{"text":"much","start":886.96,"end":887.26},{"text":"for","start":887.26,"end":887.46},{"text":"joining","start":887.46,"end":887.82},{"text":"this","start":887.82,"end":888.5},{"text":"evening","start":888.5,"end":888.86},{"text":"meditation.","start":888.86,"end":889.68}]},{"text":"Have a lovely evening.","start":889.98,"end":891.02,"words":[{"text":"Have","start":889.98,"end":890.16},{"text":"a","start":890.16,"end":890.26},{"text":"lovely","start":890.26,"end":890.48},{"text":"evening.","start":890.48,"end":891.02}]}]}
