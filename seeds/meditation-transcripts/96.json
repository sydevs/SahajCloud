.82},{"text":"few","start":686.9,"end":687.02},{"text":"inches","start":687.02,"end":687.46},{"text":"or","start":687.46,"end":687.72},{"text":"centimeters","start":687.72,"end":688.16},{"text":"above","start":688.16,"end":688.68},{"text":"our","start":688.68,"end":688.94},{"text":"head","start":688.94,"end":689.3}]},{"text":"and observe if we can feel any sensation on our fingertips.","start":690.34,"end":694.7,"words":[{"text":"and","start":690.34,"end":690.62},{"text":"observe","start":690.62,"end":691.02},{"text":"if","start":691.02,"end":691.34},{"text":"we","start":691.34,"end":691.48},{"text":"can","start":691.48,"end":691.64},{"text":"feel","start":691.64,"end":691.98},{"text":"any","start":691.98,"end":692.28},{"text":"sensation","start":692.28,"end":692.82},{"text":"on","start":692.82,"end":693.7},{"text":"our","start":693.7,"end":693.94},{"text":"fingertips.","start":693.94,"end":694.7}]},{"text":"Maybe a cool or warm breeze, a tingling, a pressure.","start":698.2,"end":701.92,"words":[{"text":"Maybe","start":698.2,"end":698.56},{"text":"a","start":698.56,"end":698.84},{"text":"cool","start":698.84,"end":699.2},{"text":"or","start":699.2,"end":699.68},{"text":"warm","start":699.68,"end":699.9},{"text":"breeze,","start":699.9,"end":700.6},{"text":"a","start":700.6,"end":700.6},{"text":"tingling,","start":700.6,"end":701.54},{"text":"a","start":701.54,"end":701.54},{"text":"pressure.","start":701.54,"end":701.92}]},{"text":"Just observe. Bringing our hand back to our lap.","start":702.06,"end":715.5,"words":[{"text":"Just","start":702.06,"end":702.34},{"text":"observe.","start":702.34,"end":703.32},{"text":"Bringing","start":713.76,"end":713.86},{"text":"our","start":713.86,"end":714.12},{"text":"hand","start":714.12,"end":714.3},{"text":"back","start":714.3,"end":714.62},{"text":"to","start":714.62,"end":715},{"text":"our","start":715,"end":715.16},{"text":"lap.","start":715.16,"end":715.5}]},{"text":"Palm facing upwards. We can still keep our attention on the top of our head where our hand just was.","start":716.52,"end":724.34,"words":[{"text":"Palm","start":716.52,"end":716.52},{"text":"facing","start":716.52,"end":716.86},{"text":"upwards.","start":716.86,"end":718.08},{"text":"We","start":719.6,"end":719.6},{"text":"can","start":719.6,"end":719.78},{"text":"still","start":719.78,"end":720.02},{"text":"keep","start":720.02,"end":720.36},{"text":"our","start":720.36,"end":720.64},{"text":"attention","start":720.64,"end":721.08},{"text":"on","start":721.08,"end":721.62},{"text":"the","start":721.62,"end":721.74},{"text":"top","start":721.74,"end":721.9},{"text":"of","start":721.9,"end":722.14},{"text":"our","start":722.14,"end":722.32},{"text":"head","start":722.32,"end":722.54},{"text":"where","start":722.54,"end":722.8},{"text":"our","start":722.8,"end":722.98},{"text":"hand","start":722.98,"end":723.18},{"text":"just","start":723.18,"end":723.54},{"text":"was.","start":723.54,"end":724.34}]},{"text":"Try and feel the silence around you and inside of you, almost listening into the silence.","start":730,"end":748.82,"words":[{"text":"Try","start":730,"end":730.34},{"text":"and","start":730.34,"end":730.66},{"text":"feel","start":730.66,"end":731.46},{"text":"the","start":731.72,"end":732.06},{"text":"silence","start":732.06,"end":732.66},{"text":"around","start":732.66,"end":733.52},{"text":"you","start":735.44,"end":736.06},{"text":"and","start":736.4,"end":736.74},{"text":"inside","start":736.74,"end":737.1},{"text":"of","start":737.1,"end":737.4},{"text":"you,","start":737.4,"end":738},{"text":"almost","start":745.82,"end":746.04},{"text":"listening","start":746.04,"end":746.8},{"text":"into","start":746.8,"end":747.58},{"text":"the","start":747.58,"end":747.8},{"text":"silence.","start":747.8,"end":748.82}]},{"text":"Stay in this state of meditation where there is no thought for a few minutes.","start":768.28,"end":782.66,"words":[{"text":"Stay","start":768.28,"end":768.52},{"text":"in","start":768.52,"end":76