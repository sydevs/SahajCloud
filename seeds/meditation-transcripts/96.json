617.62,"end":618.24},{"text":"through","start":621.86,"end":622.54},{"text":"all","start":622.54,"end":622.8},{"text":"the","start":622.8,"end":622.96},{"text":"seven","start":622.96,"end":623.32},{"text":"energy","start":623.32,"end":623.86},{"text":"centers.","start":623.86,"end":625.06}]},{"text":"And after the third time, we can place our right hand palm facing downwards onto our fontanel bone.","start":642.06,"end":649.48,"words":[{"text":"And","start":642.06,"end":642.24},{"text":"after","start":642.24,"end":642.62},{"text":"the","start":642.62,"end":643.24},{"text":"third","start":643.24,"end":643.46},{"text":"time,","start":643.46,"end":643.84},{"text":"we","start":643.84,"end":643.84},{"text":"can","start":643.84,"end":644.06},{"text":"place","start":644.06,"end":644.48},{"text":"our","start":644.48,"end":644.84},{"text":"right","start":644.84,"end":645.12},{"text":"hand","start":645.12,"end":645.4},{"text":"palm","start":645.4,"end":645.78},{"text":"facing","start":645.78,"end":646.34},{"text":"downwards","start":646.34,"end":647.4},{"text":"onto","start":647.64,"end":648.18},{"text":"our","start":648.18,"end":648.42},{"text":"fontanel","start":648.42,"end":648.94},{"text":"bone.","start":648.94,"end":649.48}]},{"text":"We can press down and rotate our scalp in a clockwise direction towards our right shoulder.","start":649.82,"end":656.96,"words":[{"text":"We","start":649.82,"end":649.96},{"text":"can","start":649.96,"end":650.2},{"text":"press","start":650.2,"end":650.48},{"text":"down","start":650.48,"end":651.14},{"text":"and","start":651.14,"end":651.82},{"text":"rotate","start":651.82,"end":652.22},{"text":"our","start":652.22,"end":652.72},{"text":"scalp","start":652.72,"end":653.1},{"text":"in","start":653.1,"end":653.6},{"text":"a","start":653.6,"end":653.72},{"text":"clockwise","start":653.72,"end":654.06},{"text":"direction","start":654.06,"end":654.82},{"text":"towards","start":654.82,"end":655.6},{"text":"our","start":655.86,"end":656.38},{"tex