48},{"text":"then","start":347.48,"end":348.1},{"text":"we","start":349.46,"end":349.62},{"text":"express","start":349.62,"end":349.9},{"text":"ourselves","start":349.9,"end":350.28},{"text":"with","start":350.28,"end":350.72},{"text":"sweetness","start":350.72,"end":351.18},{"text":"and","start":351.18,"end":351.76},{"text":"kindness","start":351.76,"end":352.32},{"text":"and","start":352.32,"end":353.1},{"text":"we","start":355.28,"end":355.28},{"text":"are","start":355.28,"end":355.56},{"text":"collective","start":355.56,"end":355.96},{"text":"beings.","start":355.96,"end":356.78}]},{"text":"Mother please teach me how to speak sweetly.","start":364.3,"end":366.88,"words":[{"text":"Mother","start":364.3,"end":364.58},{"text":"please","start":364.58,"end":364.88},{"text":"teach","start":364.88,"end":365.12},{"text":"me","start":365.12,"end":365.34},{"text":"how","start":365.34,"end":365.54},{"text":"to","start":365.54,"end":365.82},{"text":"speak","start":365.82,"end":366.12},{"text":"sweetly.","start":366.12,"end":366.88}]},{"text":"So that I can express this joy that is in my heart.","start":370.62,"end":374.26,"words":[{"text":"So","start":370.62,"end":371.04},{"text":"that","start":371.04,"end":371.5},{"text":"I","start":371.5,"end":371.64},{"text":"can","start":371.64,"end":371.8},{"text":"express","start":371.8,"end":372.16},{"text":"this","start":372.16,"end":372.44},{"text":"joy","start":372.44,"end":372.88},{"text":"that","start":372.88,"end":373.2},{"text":"is","start":373.2,"end":373.36},{"text":"in","start":373.36,"end":373.46},{"text":"my","start":373.46,"end":373.68},{"text":"heart.","start":373.68,"end":374.26}]},{"text":"Now we can raise our hand to our forehead, bowing our head into our hand.","start":388.42,"end":392.44,"words":[{"text":"Now","start":388.42,"end":388.58},{"text":"we","start":388.58,"end":388.66},{"text":"can","start":388.66,"end":388.78},{"text":"raise","start":388.78,"end":389},{"text":"our","start":389,"end":389.16},{"text":"hand","start":389.16,"end":389.34},{"text":"to","start":389.34,"end":389.44},{"text":"our","start":389.44,"end":389.6},{"text":"forehead,","start":389.6,"end":390.5},{"text":"bowing","start":391.16,"end":391.34},{"text":"our","start":391.34,"end":391.46},{"text":"head","start":391.46,"end":391.64},{"text":"into","start":391.64,"end":391.8},{"text":"our","start":391.8,"end":392.02},{"text":"hand.","start":392.02,"end":392.44}]},{"text":"And here we have a very special prayer.","start":402.76,"end":404.62,"words":[{"text":"And","start":402.76,"end":402.94},{"text":"here","start":402.94,"end":403.06},{"text":"we","start":403.06,"end":403.2},{"text":"have","start":403.2,"end":403.32},{"text":"a","start":403.32,"end":403.54},{"text":"very","start":403.54,"end":403.7},{"text":"special","start":403.7,"end":404.02},{"text":"prayer.","start":404.02,"end":404.62}]},{"text":"We can pray, Mother Kundalini, if anyone has done anything wrong to me, please forgive them.","start":407.34,"end":417.64,"words":[{"text":"We","start":407.34,"end":407.54},{"text":"can","start":407.54,"end":407.7},{"text":"pray,","start":407.7,"end":408.52},{"text":"Mother","start":409.42,"end":409.6},{"text":"Kundalini,","start":409.6,"end":410.5},{"text":"if","start":412.48,"end":412.68},{"text":"anyone","start":412.68,"end":413.1},{"text":"has","start":413.1,"end":413.4},{"text":"done","start":413.4,"end":413.66},{"text":"anything","start":413.66,"end":414},{"text":"wrong","start":414,"end":414.3},{"text":"to","start":414.3,"end":414.54},{"text":"me,","start":414.54,"end":415.08},{"text":"please","start":416.4,"end":416.6},{"text":"forgive","start":416.6,"end":416.96},{"text":"them.","start":416.96,"end":417.64}]},{"text":"Mother Kundalini, if I have done anything wrong to anyone, please forgive me.","start":424.52,"end":429.5,"words":[{"text":"Mother","start":424.52,"end":424.74},{"text":"Kundalini,","start":424.74,"end":425.24},{"text":"if","start":425.24,"end":425.32},{"text":"I","start":425.32,"end":425.52},{"text":"have","start":425.52,"end":425.72},{"text":"done","start":425.72,"end":425.88},{"text":"anything","start":425.88,"end":426.12},{"text":"wrong","start":426.12,"end":426.4},{"text":"to","start":426.4,"end":426.62},{"text":"anyone,","start":426.62,"end":427.32},{"text":"please","start":428.26,"end":428.5},{"text":"forgive","start":428.5,"end":428.88},{"text":"me.","start":428.88,"end":429.5}]},{"text":"Mother Kundalini, with your soothing light of love, please take away all my thoughts.","start":443.26,"end":451.98,"words":[{"text":"Mother","start":443.26,"end":443.5},{"text":"Kundalini,","start":443.5,"end":444.54},{"text":"with","start":445.82,"end":445.92},{"text":"your","start":445.92,"end":446.16},{"text":"soothing","start":446.16,"end":446.56},{"text":"light","start":446.56,"end":446.98},{"text":"of","start":446.98,"end":447.16},{"text":"love,","start":447.16,"end":448.12},{"text":"please","start":450.72,"end":450.72},{"text":"take","start":450.72,"end":450.88},{"text":"away","start":450.88,"end":451.16},{"text":"all","start":451.16,"end":451.3},{"text":"my","start":451.3,"end":451.46},{"text":"thoughts.","start":451.46,"end":451.98}]},{"text":"We can raise our hand to our Sahasrara, massaging our head clockwise.","start":465.76,"end":471.2,"words":[{"text":"We","start":465.76,"end":465.92},{"text":"can","start":465.92,"end":466.1},{"text":"raise","start":466.1,"end":466.26},{"text":"our","start":466.26,"end":466.62},{"text":"hand","start":466.62,"end":466.62},{"text":"to","start":466.62,"end":466.74},{"text":"our","start":466.74,"end":466.88},{"text":"Sahasrara,","start":466.88,"end":467.9},{"text":"massaging","start":469.54,"end":470.08},{"text":"our","start":470.08,"end":470.34},{"text":"head","start":470.34,"end":470.34},{"text":"clockwise.","start":470.34,"end":471.2}]},{"text":"If a hand is tired then you can place it back on your lap.","start":482.26,"end":485.04,"words":[{"text":"If","start":482.26,"end":482.64},{"text":"a","start":482.64,"end":482.8},{"text":"hand","start":482.8,"end":482.92},{"text":"is","start":482.92,"end":483.14},{"text":"tired","start":483.14,"end":483.34},{"text":"then","start":483.34,"end":483.58},{"text":"you","start":483.58,"end":483.66},{"text":"can","start":483.66,"end":483.76},{"text":"place","start":483.76,"end":483.96},{"text":"it","start":483.96,"end":484.16},{"text":"back","start":484.16,"end":484.24},{"text":"on","start":484.24,"end":484.32},{"text":"your","start":484.32,"end":484.46},{"text":"lap.","start":484.46,"end":485.04}]},{"text":"Here we can say, Mother I am the eternal light of love, that is joy.","start":488.66,"end":495.48,"words":[{"text":"Here","start":488.66,"end":488.82},{"text":"we","start":488.82,"end":488.9},{"text":"can","start":488.9,"end":489.06},{"text":"say,","start":489.06,"end":489.84},{"text":"Mother","start":491.56,"end":491.74},{"text":"I","start":491.74,"end":492},{"text":"am","start":492,"end":492.1},{"text":"the","start":492.1,"end":492.26},{"text":"eternal","start":492.26,"end":492.56},{"text":"light","start":492.56,"end":492.88},{"text":"of","start":492.88,"end":493.1},{"text":"love,","start":493.1,"end":493.66},{"text":"that","start":494.4,"end":494.56},{"text":"is","start":494.56,"end":494.86},{"text":"joy.","start":494.86,"end":495.48}]},{"text":"And we can just say seven times inside, I am joy.","start":497.38,"end":502.24,"words":[{"text":"And","start":497.38,"end":497.52},{"text":"we","start":497.52,"end":497.62},{"text":"can","start":497.62,"end":497.94},{"text":"just","start":497.94,"end":497.94},{"text":"say","start":497.94,"end":498.48},{"text":"seven","start":498.84,"end":499.26},{"text":"times","start":499.26,"end":499.54},{"text":"inside,","start":499.54,"end":500.28},{"text":"I","start":501.08,"end":501.42},{"text":"am","start":501.42,"end":501.66},{"text":"joy.","start":501.66,"end":502.24}]},{"text":"We can place our hand back on our lap and we can pray inside.","start":515.66,"end":523.8,"words":[{"text":"We","start":515.66,"end":515.78},{"text":"can","start":515.78,"end":515.92},{"text":"place","start":515.92,"end":516.14},{"text":"our","start":516.14,"end":516.34},{"text":"hand","start":516.34,"end":516.48},{"text":"back","start":516.48,"end":516.7},{"text":"on","start":516.7,"end":516.86},{"text":"our","start":516.86,"end":516.92},{"text":"lap","start":516.92,"end":517.22},{"text":"and","start":522.34,"end":522.82},{"text":"we","start":522.82,"end":522.9},{"text":"can","start":522.9,"end":522.9},{"text":"pray","start":522.9,"end":523.04},{"text":"inside.","start":523.04,"end":523.8}]},{"text":"Mother Kundalini, let your light of joy spread to my face so that it can shine.","start":527.82,"end":537.32,"words":[{"text":"Mother","start":527.82,"end":528.02},{"text":"Kundalini,","start":528.02,"end":529.04},{"text":"let","start":531.36,"end":531.5},{"text":"your","start":531.5,"end":531.74},{"text":"light","start":531.74,"end":532.04},{"text":"of","start":532.04,"end":532.26},{"text":"joy","start":532.26,"end":532.72},{"text":"spread","start":532.72,"end":533.34},{"text":"to","start":534.38,"end":534.56},{"text":"my","start":534.56,"end":534.74},{"text":"face","start":534.74,"end":535.28},{"text":"so","start":535.28,"end":535.88},{"text":"that","start":535.88,"end":536.16},{"text":"it","start":536.16,"end":536.34},{"text":"can","start":536.34,"end":536.52},{"text":"shine.","start":536.52,"end":537.32}]},{"text":"Spread to my eyes so that they are pure and joy-giving.","start":539.22,"end":543.96,"words":[{"text":"Spread","start":539.22,"end":539.38},{"text":"to","start":539.38,"end":539.56},{"text":"my","start":539.56,"end":539.64},{"text":"eyes","start":539.64,"end":540.44},{"text":"so","start":540.44,"end":540.94},{"text":"that","start":542.04,"end":542.18},{"text":"they","start":542.18,"end":542.3},{"text":"are","start":542.3,"end":542.38},{"text":"pure","start":542.38,"end":542.72},{"text":"and","start":542.72,"end":543.04},{"text":"joy-giving.","start":543.04,"end":543.96}]},{"text":"Spread to my actions so that I am generous and kind.","start":547.06,"end":552.18,"words":[{"text":"Spread","start":547.06,"end":547.42},{"text":"to","start":547.42,"end":547.58},{"text":"my","start":547.58,"end":547.7},{"text":"actions","start":547.7,"end":548.24},{"text":"so","start":548.24,"end":548.96},{"text":"that","start":550.86,"end":550.98},{"text":"I","start":550.98,"end":551.1},{"text":"am","start":551.1,"end":551.38},{"text":"generous","start":551.38,"end":551.56},{"text":"and","start":551.56,"end":551.84},{"text":"kind.","start":551.84,"end":552.18}]},{"text":"And spread to my whole being so that I am a joyful person who is completely still inside and outside.","start":556.26,"end":578.12,"words":[{"text":"And","start":556.26,"end":556.4},{"text":"spread","start":556.4,"end":556.64},{"text":"to","start":556.64,"end":556.78},{"text":"my","start":556.78,"end":556.92},{"text":"whole","start":556.92,"end":557.14},{"text":"being","start":557.14,"end":557.64},{"text":"so","start":557.64,"end":558.12},{"text":"that","start":563.3,"end":563.46},{"text":"I","start":563.46,"end":563.5},{"text":"am","start":563.5,"end":563.62},{"text":"a","start":563.62,"end":563.66},{"text":"joyful","start":563.66,"end":563.9},{"text":"person","start":563.9,"end":564.52},{"text":"who","start":564.52,"end":565.02},{"text":"is","start":567.98,"end":568.12},{"text":"completely","start":568.12,"end":568.46},{"text":"still","start":568.46,"end":569.22},{"text":"inside","start":573.32,"end":574.1},{"text":"and","start":574.1,"end":574.74},{"text":"outside.","start":577.16,"end":578.12}]},{"text":"Being joyful is not being happy or excited. It is a state that is beyond. You do not have to smile all the time.","start":588.78,"end":602.92,"words":[{"text":"Being","start":588.78,"end":588.92},{"text":"joyful","start":588.92,"end":589.26},{"text":"is","start":589.26,"end":589.62},{"text":"not","start":589.62,"end":589.82},{"text":"being","start":589.82,"end":590.08},{"text":"happy","start":590.08,"end":590.5},{"text":"or","start":590.5,"end":590.76},{"text":"excited.","start":590.76,"end":591.58},{"text":"It","start":594.94,"end":595.18},{"text":"is","start":595.18,"end":595.28},{"text":"a","start":595.28,"end":595.56},{"text":"state","start":595.56,"end":595.88},{"text":"that","start":595.88,"end":596.38},{"text":"is","start":597.5,"end":597.62},{"text":"beyond.","start":597.62,"end":598.2},{"text":"You","start":600.52,"end":600.74},{"text":"do","start":600.74,"end":600.88},{"text":"not","start":600.88,"end":601},{"text":"have","start":601,"end":601.2},{"text":"to","start":601.2,"end":601.38},{"text":"smile","start":601.38,"end":601.72},{"text":"all","start":601.72,"end":602.08},{"text":"the","start":602.08,"end":602.18},{"text":"time.","start":602.18,"end":602.92}]},{"text":"It is a state of peace you feel, a state of satisfaction, a state of inner contentment that can only be fulfilled by the spirit.","start":605.4,"end":619.74,"words":[{"text":"It","start":605.4,"end":605.46},{"text":"is","start":605.46,"end":605.64},{"text":"a","start":605.64,"end":605.78},{"text":"state","start":605.78,"end":605.88},{"text":"of","start":605.88,"end":606.14},{"text":"peace","start":606.14,"end":606.58},{"text":"you","start":606.58,"end":606.9},{"text":"feel,","start":606.9,"end":607.74},{"text":"a","start":609.36,"end":609.36},{"text":"state","start":609.36,"end":609.48},{"text":"of","start":609.48,"end":609.66},{"text":"satisfaction,","start":609.66,"end":610.88},{"text":"a","start":613.2,"end":613.2},{"text":"state","start":613.2,"end":613.32},{"text":"of","start":613.32,"end":613.64},{"text":"inner","start":613.64,"end":613.78},{"text":"contentment","start":613.78,"end":614.54},{"text":"that","start":614.54,"end":614.9},{"text":"can","start":617.18,"end":617.34},{"text":"only","start":617.34,"end":617.66},{"text":"be","start":617.66,"end":617.98},{"text":"fulfilled","start":617.98,"end":618.34},{"text":"by","start":618.34,"end":619},{"text":"the","start":619,"end":619.2},{"text":"spirit.","start":619.2,"end":619.74}]},{"text":"We can just sit in meditation on these words.","start":629.3,"end":632.26,"words":[{"text":"We","start":629.3,"end":629.34},{"text":"can","start":629.34,"end":629.48},{"text":"just","start":629.48,"end":629.76},{"text":"sit","start":629.76,"end":629.96},{"text":"in","start":629.96,"end":630.1},{"text":"meditation","start":630.1,"end":630.56},{"text":"on","start":630.56,"end":631.46},{"text":"these","start":631.46,"end":631.64},{"text":"words.","start":631.64,"end":632.26}]},{"text":"Thank you for listening. I wish you a joyful day and if you feel the desire you can continue meditating feeling the joy in your heart.","start":638.16,"end":651.36,"words":[{"text":"Thank","start":638.16,"end":638.42},{"text":"you","start":638.42,"end":638.64},{"text":"for","start":638.64,"end":638.7},{"text":"listening.","start":638.7,"end":639.66},{"text":"I","start":639.66,"end":639.8},{"text":"wish","start":639.8,"end":640.02},{"text":"you","start":640.02,"end":640.2},{"text":"a","start":640.2,"end":640.26},{"text":"joyful","start":640.26,"end":640.54},{"text":"day","start":640.54,"end":641.02},{"text":"and","start":642.5,"end":642.9},{"text":"if","start":642.9,"end":643.04},{"text":"you","start":643.04,"end":643.1},{"text":"feel","start":643.1,"end":643.34},{"text":"the","start":643.34,"end":643.5},{"text":"desire","start":643.5,"end":643.86},{"text":"you","start":643.86,"end":644.54},{"text":"can","start":645.44,"end":645.76},{"text":"continue","start":645.76,"end":646.16},{"text":"meditating","start":646.16,"end":646.64},{"text":"feeling","start":646.64,"end":647.52},{"text":"the","start":650.1,"end":650.36},{"text":"joy","start":650.36,"end":650.6},{"text":"in","start":650.6,"end":650.86},{"text":"your","start":650.86,"end":651.08},{"text":"heart.","start":651.08,"end":651.36}]}]}
