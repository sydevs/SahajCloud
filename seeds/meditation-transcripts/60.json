.04,"end":154.42},{"text":"Again,","start":155.06,"end":155.84},{"text":"no","start":156.08,"end":156.44},{"text":"need","start":156.44,"end":156.78},{"text":"to","start":156.78,"end":156.94},{"text":"think","start":156.94,"end":157.2},{"text":"of","start":157.2,"end":157.44},{"text":"specific","start":157.44,"end":157.88},{"text":"examples,","start":157.88,"end":159.22},{"text":"just","start":159.62,"end":159.88},{"text":"forgive,","start":159.88,"end":160.98},{"text":"and","start":163.74,"end":163.94},{"text":"forgive","start":163.94,"end":164.24},{"text":"yourself","start":164.24,"end":164.88},{"text":"wholeheartedly.","start":164.88,"end":166.7}]},{"text":"Allow the peace that comes from forgiveness to permeate your mind. Allow yourself to settle into this silence.","start":176.48,"end":192.74,"words":[{"text":"Allow","start":176.48,"end":176.68},{"text":"the","start":176.68,"end":176.96},{"text":"peace","start":176.96,"end":177.28},{"text":"that","start":177.28,"end":177.54},{"text":"comes","start":177.54,"end":177.78},{"text":"from","start":177.78,"end":178.1},{"text":"forgiveness","start":178.1,"end":178.44},{"text":"to","start":178.44,"end":179.26},{"text":"permeate","start":179.26,"end":179.8},{"text":"your","start":179.8,"end":180},{"text":"mind.","start":180,"end":180.72},{"text":"Allow","start":188.38,"end":188.92},{"text":"yourself","start":188.92,"end":189.46},{"text":"to","start":189.46,"end":189.82},{"text":"settle","start":189.82,"end":190.2},{"text":"into","start":190.2,"end":191.06},{"text":"this","start":191.52,"end":191.82},{"text":"silence.","start":191.82,"end":192.74}]},{"text":"If you're having trouble focusing, concentrate on your breathing, and allow all of your thoughts to wash away from you.","start":213.76,"end":224.42,"words":[{"text":"If","start":213.76,"end":213.96},{"text":"you're","start":213.96,"end":214.14},{"text":"having","start":214.14,"end":214.4},{"text":"trouble","start":214.4,"end":214.78},{"text":"focusing,","start":214.7