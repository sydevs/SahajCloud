"end":50.82},{"text":"feeling","start":50.82,"end":51.14},{"text":"complete","start":51.14,"end":51.72},{"text":"peace.","start":51.72,"end":53.1}]},{"text":"First, we let go of any anger and frustrations that are holding us back.","start":58,"end":64.1,"words":[{"text":"First,","start":58,"end":58.96},{"text":"we","start":59.4,"end":59.52},{"text":"let","start":59.52,"end":59.74},{"text":"go","start":59.74,"end":60.12},{"text":"of","start":60.12,"end":60.36},{"text":"any","start":60.36,"end":60.56},{"text":"anger","start":60.56,"end":60.98},{"text":"and","start":60.98,"end":61.34},{"text":"frustrations","start":61.34,"end":62.26},{"text":"that","start":62.26,"end":62.74},{"text":"are","start":62.74,"end":62.82},{"text":"holding","start":62.82,"end":63.1},{"text":"us","start":63.1,"end":63.38},{"text":"back.","start":63.38,"end":64.1}]},{"text":"You do not need to think of anything specific, but in a general sense, let it go.","start":65.84,"end":72.48,"words":[{"text":"You","start":65.84,"end":66},{"text":"do","start":66,"end":66.18},{"text":"not","start":66.18,"end":66.3},{"text":"need","start":66.3,"end":66.58},{"text":"to","start":66.58,"end":66.76},{"text":"think","start":66.76,"end":67.02},{"text":"of","start":67.02,"end":67.3},{"text":"anything","start":67.3,"end":67.6},{"text":"specific,","start":67.6,"end":68.94},{"text":"but","start":68.94,"end":69.14},{"text":"in","start":69.14,"end":69.26},{"text":"a","start":69.26,"end":69.42},{"text":"general","start":69.42,"end":69.76},{"text":"sense,","start":69.76,"end":70.76},{"text":"let","start":71.52,"end":71.58},{"text":"it","start":71.58,"end":71.8},{"text":"go.","start":71.8,"end":72.48}]},{"text":"Let go of any fear that has a hold of you.","start":79.02,"end":82.28,"words":[{"text":"Let","start":79.02,"end":79.24},{"text":"go","start":79.24,"end":79.74},{"text":"of","start":79.74,"end":80.06},{"text":"any","start":80.06,"end":80.3},{"text":"fear","start":80.3,"end":80.72},{"text":"that","start":80.72,"end":81.14},{"text":"has","start":81.14,"end":81.36},{"text":"a","start":81.36,"end":81.54},{"text":"hold","start":81.54,"end":81.68},{"text":"of","start":81.68,"end":81.92},{"text":"you.","start":81.92,"end":82.28}]},{"text":"Allow your heart to fill with security and a sense of confidence in your own abilities.","start":89.04,"end":96.22,"words":[{"text":"Allow","start":89.04,"end":89.6},{"text":"your","start":89.6,"end":89.98},{"text":"heart","start":89.98,"end":90.38},{"text":"to","start":90.38,"end":90.88},{"text":"fill","start":90.88,"end":91.12},{"text":"with","start":91.12,"end":91.36},{"text":"security","start":91.36,"end":91.84},{"text":"and","start":91.84,"end":92.78},{"text":"a","start":92.78,"end":92.94},{"text":"sense","start":92.94,"end":93.22},{"text":"of","start":93.22,"end":93.56},{"text":"confidence","start":93.56,"end":93.96},{"text":"in","start":93.96,"end":94.42},{"text":"your","start":94.42,"end":94.68},{"text":"own","start":94.68,"end":94.88},{"text":"abilities.","start":94.88,"end":96.22}]},{"text":"Allow your heart to expand with compassion and love.","start":102.26,"end":107.12,"words":[{"text":"Allow","start":102.26,"end":102.32},{"text":"your","start":102.32,"end":102.64},{"text":"heart","start":102.64,"end":103.08},{"text":"to","start":103.08,"end":103.66},{"text":"expand","start":103.66,"end":104.32},{"text":"with","start":104.32,"end":104.62},{"text":"compassion","start":104.62,"end":105.16},{"text":"and","start":105.16,"end":106.04},{"text":"love.","start":106.56,"end":107.12}]},{"text":"Now we will move our attention to our Agnya chakra at your forehead.","start":122.9,"end":127.46,"words":[{"text":"Now","start":122.9,"end":123.22},{"text":"we","start":123.22,"end":123.38},{"text":"will","start":123.38,"end":123.58},{"text":"move","start":123.58,"end":123.92},{"text":"our","start":123.92,"end":124.22},{"text":"attention","start":124.22,"end":124.62},{"text":"to","start":124.62,"end":125.22},{"text":"our","start":125.22,"end":125.34},{"te