{"meditationId":60,"audioFilename":"inner-peace-meditation-online-audio-convertercom-hokkgb4pv8i.mp3","language":"english","provider":"lemonfox","segments":[{"text":"Settle yourself somewhere comfortable. We are going to slow down our breathing and prepare for our meditation.","start":1.16,"end":9.66,"words":[{"text":"Settle","start":1.16,"end":1.78},{"text":"yourself","start":1.78,"end":2.26},{"text":"somewhere","start":2.26,"end":2.82},{"text":"comfortable.","start":2.82,"end":4.04},{"text":"We","start":4.96,"end":5.1},{"text":"are","start":5.1,"end":5.28},{"text":"going","start":5.28,"end":5.52},{"text":"to","start":5.52,"end":5.7},{"text":"slow","start":5.7,"end":6},{"text":"down","start":6,"end":6.52},{"text":"our","start":6.52,"end":6.76},{"text":"breathing","start":6.76,"end":7.16},{"text":"and","start":7.16,"end":7.78},{"text":"prepare","start":7.78,"end":8.08},{"text":"for","start":8.08,"end":8.4},{"text":"our","start":8.4,"end":8.5},{"text":"meditation.","start":8.5,"end":9.66}]},{"text":"When you inhale, pause for a few seconds before you exhale.","start":10.96,"end":15.64,"words":[{"text":"When","start":10.96,"end":11.02},{"text":"you","start":11.02,"end":11.28},{"text":"inhale,","start":11.28,"end":12.24},{"text":"pause","start":12.5,"end":12.78},{"text":"for","start":12.78,"end":13.12},{"text":"a","start":13.12,"end":13.24},{"text":"few","start":13.24,"end":13.4},{"text":"seconds","start":13.4,"end":13.96},{"text":"before","start":13.96,"end":14.42},{"text":"you","start":14.42,"end":14.76},{"text":"exhale.","start":14.76,"end":15.64}]},{"text":"When you exhale, pause for a few seconds before you inhale.","start":17.28,"end":22.22,"words":[{"text":"When","start":17.28,"end":17.4},{"text":"you","start":17.4,"end":17.64},{"text":"exhale,","start":17.64,"end":18.62},{"text":"pause","start":19.1,"end":19.42},{"text":"for","start":19.42,"end":19.76},{"text":"a","start":19.76,"end":19.86},{"text":"few","start":19.86,"end":20.04},{"text":"seconds","start":20.0