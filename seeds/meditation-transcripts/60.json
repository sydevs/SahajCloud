nd":291.4},{"text":"go","start":291.4,"end":291.56},{"text":"of","start":291.56,"end":291.78},{"text":"the","start":291.78,"end":291.9},{"text":"past.","start":291.9,"end":292.48}]},{"text":"You can also say, not this thought, not this thought, and let them go.","start":293.92,"end":300.38,"words":[{"text":"You","start":293.92,"end":294.28},{"text":"can","start":294.28,"end":294.54},{"text":"also","start":294.54,"end":294.94},{"text":"say,","start":294.94,"end":295.72},{"text":"not","start":295.72,"end":296.12},{"text":"this","start":296.12,"end":296.46},{"text":"thought,","start":296.46,"end":297.44},{"text":"not","start":297.44,"end":297.58},{"text":"this","start":297.58,"end":297.92},{"text":"thought,","start":297.92,"end":298.78},{"text":"and","start":299.14,"end":299.26},{"text":"let","start":299.26,"end":299.42},{"text":"them","start":299.42,"end":299.68},{"text":"go.","start":299.68,"end":300.38}]},{"text":"Before finishing this meditation, we can say this affirmation.","start":348.24,"end":352.88,"words":[{"text":"Before","start":348.24,"end":348.6},{"text":"finishing","start":348.6,"end":349},{"text":"this","start":349,"end":349.36},{"text":"meditation,","start":349.36,"end":350.72},{"text":"we","start":350.72,"end":350.8},{"text":"can","start":350.8,"end":351.06},{"text":"say","start":351.06,"end":351.28},{"text":"this","start":351.28,"end":351.62},{"text":"affirmation.","start":351.62,"end":352.88}]},{"text":"Let this inner peace stay with me throughout the day.","start":354.08,"end":357.56,"words":[{"text":"Let","start":354.08,"end":354.26},{"text":"this","start":354.26,"end":354.64},{"text":"inner","start":354.64,"end":354.84},{"text":"peace","start":354.84,"end":355.3},{"text":"stay","start":355.3,"end":355.9},{"text":"with","start":355.9,"end":356.16},{"text":"me","start":356.16,"end":356.44},{"text":"throughout","start":356.44,"end":356.76},{"text":"the","start":356.76,"end":357.02},{"text":"day.","start":357.02,"end":357.56}]},{"text":"Let me be abl