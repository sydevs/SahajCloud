end":349.84},{"text":"am","start":349.84,"end":350.1},{"text":"the","start":350.1,"end":350.24},{"text":"pure","start":350.24,"end":350.48},{"text":"spirit,","start":350.48,"end":351.5}]},{"text":"not my mistakes.","start":352.34,"end":354,"words":[{"text":"not","start":352.34,"end":352.62},{"text":"my","start":352.62,"end":352.9},{"text":"mistakes.","start":352.9,"end":354}]},{"text":"Therefore I am not guilty.","start":355.8,"end":357.88,"words":[{"text":"Therefore","start":355.8,"end":356.2},{"text":"I","start":356.2,"end":356.58},{"text":"am","start":356.58,"end":356.8},{"text":"not","start":356.8,"end":357.1},{"text":"guilty.","start":357.1,"end":357.88}]},{"text":"Now we can place the right hand across the forehead","start":372.22,"end":374.72,"words":[{"text":"Now","start":372.22,"end":372.5},{"text":"we","start":372.5,"end":372.62},{"text":"can","start":372.62,"end":372.74},{"text":"place","start":372.74,"end":373.08},{"text":"the","start":373.08,"end":373.32},{"text":"right","start":373.32,"end":373.52},{"text":"hand","start":373.52,"end":373.76},{"text":"across","start":373.76,"end":374.1},{"text":"the","start":374.1,"end":374.3},{"text":"forehead","start":374.3,"end":374.72}]},{"text":"and tilt the head forward slightly","start":375.7,"end":377.54,"words":[{"text":"and","start":375.7,"end":376.04},{"text":"tilt","start":376.04,"end":376.26},{"text":"the","start":376.26,"end":376.48},{"text":"head","start":376.48,"end":376.68},{"text":"forward","start":376.68,"end":376.96},{"text":"slightly","start":376.96,"end":377.54}]},{"text":"so that it rests in the hand.","start":377.8,"end":379.68,"words":[{"text":"so","start":377.8,"end":378.16},{"text":"that","start":378.16,"end":378.28},{"text":"it","start":378.28,"end":378.44},{"text":"rests","start":378.44,"end":378.78},{"text":"in","start":378.78,"end":379.1},{"text":"the","start":379.1,"end":379.22},{"text":"hand.","start":379.22,"end":379.68}]},{"text":"To rid ourselves of thoughts of the future","start":388.02,"end":390.5,"words":[{"text":"To","start":388.02,"end":388.28},{"text":"rid","start":388.28,"end":388.38},{"text":"ourselves","start":388.38,"end":388.92},{"text":"of","start":388.92,"end":389.4},{"text":"thoughts","start":389.4,"end":389.68},{"text":"of","start":389.68,"end":390},{"text":"the","start":390,"end":390.12},{"text":"future","start":390.12,"end":390.5}]},{"text":"and of the past.","start":390.92,"end":392.12,"words":[{"text":"and","start":390.92,"end":391.2},{"text":"of","start":391.2,"end":391.34},{"text":"the","start":391.34,"end":391.54},{"text":"past.","start":391.54,"end":392.12}]},{"text":"Here we can affirm","start":394.28,"end":395.28,"words":[{"text":"Here","start":394.28,"end":394.6},{"text":"we","start":394.6,"end":394.74},{"text":"can","start":394.74,"end":394.9},{"text":"affirm","start":394.9,"end":395.28}]},{"text":"Mother Kundalini, I forgive everyone and I forgive myself.","start":397.06,"end":402.26,"words":[{"text":"Mother","start":397.06,"end":397.06},{"text":"Kundalini,","start":397.06,"end":398.22},{"text":"I","start":398.94,"end":399.1},{"text":"forgive","start":399.1,"end":399.48},{"text":"everyone","start":399.48,"end":400.06},{"text":"and","start":400.06,"end":400.74},{"text":"I","start":400.74,"end":400.94},{"text":"forgive","start":400.94,"end":401.34},{"text":"myself.","start":401.34,"end":402.26}]},{"text":"We can repeat this several times inside.","start":410.14,"end":412.74,"words":[{"text":"We","start":410.14,"end":410.24},{"text":"can","start":410.24,"end":410.4},{"text":"repeat","start":410.4,"end":410.68},{"text":"this","start":410.68,"end":410.98},{"text":"several","start":410.98,"end":411.28},{"text":"times","start":411.28,"end":411.72},{"text":"inside.","start":411.72,"end":412.74}]},{"text":"I forgive, I forgive.","start":414.9,"end":420.94,"words":[{"text":"I","start":414.9,"end":415.1},{"text":"forgive,","start":415.1,"end":416.12},{"text":"I","start":419.98,"end":420.18},{"text":"forgive.","start":420.18,"end":420.94}]},{"text":"Now we can place the right hand across the back of the head","start":439.62,"end":442.94,"words":[{"text":"Now","start":439.62,"end":439.82},{"text":"we","start":439.82,"end":439.98},{"text":"can","start":439.98,"end":440.2},{"text":"place","start":440.2,"end":440.56},{"text":"the","start":440.56,"end":440.78},{"text":"right","start":440.78,"end":440.98},{"text":"hand","start":440.98,"end":441.46},{"text":"across","start":441.46,"end":441.88},{"text":"the","start":441.88,"end":442.1},{"text":"back","start":442.1,"end":442.3},{"text":"of","start":442.3,"end":442.48},{"text":"the","start":442.48,"end":442.94},{"text":"head","start":442.94,"end":442.94}]},{"text":"and again lean our head backwards so that it rests in the hand.","start":444.72,"end":448.54,"words":[{"text":"and","start":444.72,"end":444.98},{"text":"again","start":444.98,"end":445.26},{"text":"lean","start":445.26,"end":445.58},{"text":"our","start":445.58,"end":445.72},{"text":"head","start":445.72,"end":445.92},{"text":"backwards","start":445.92,"end":446.38},{"text":"so","start":446.38,"end":447.1},{"text":"that","start":447.1,"end":447.24},{"text":"it","start":447.24,"end":447.4},{"text":"rests","start":447.4,"end":447.7},{"text":"in","start":447.7,"end":447.96},{"text":"the","start":447.96,"end":448.1},{"text":"hand.","start":448.1,"end":448.54}]},{"text":"And here we can ask our Mother Kundalini to cleanse us of our past","start":452,"end":459.12,"words":[{"text":"And","start":452,"end":452.36},{"text":"here","start":452.36,"end":452.72},{"text":"we","start":452.72,"end":453.18},{"text":"can","start":454.6,"end":454.82},{"text":"ask","start":454.82,"end":455.14},{"text":"our","start":455.14,"end":455.42},{"text":"Mother","start":455.42,"end":455.62},{"text":"Kundalini","start":455.62,"end":456.28},{"text":"to","start":456.28,"end":456.78},{"text":"cleanse","start":457.34,"end":457.74},{"text":"us","start":457.74,"end":458.2},{"text":"of","start":458.2,"end":458.42},{"text":"ou