{"meditationId":49,"audioFilename":"silence5-wfun5rc5f3.mp3","language":"english","provider":"lemonfox","segments":[{"text":"We will start this meditation by lifting our kundalini.","start":2.84,"end":6.04,"words":[{"text":"We","start":2.84,"end":3},{"text":"will","start":3,"end":3.2},{"text":"start","start":3.2,"end":3.42},{"text":"this","start":3.42,"end":3.68},{"text":"meditation","start":3.68,"end":4.24},{"text":"by","start":4.24,"end":4.64},{"text":"lifting","start":4.64,"end":4.96},{"text":"our","start":4.96,"end":5.24},{"text":"kundalini.","start":5.24,"end":6.04}]},{"text":"We do this by moving our right hand along the central path of our body in the front, palm upward, fingers facing kind of towards our body.","start":6.72,"end":17.34,"words":[{"text":"We","start":6.72,"end":6.78},{"text":"do","start":6.78,"end":6.98},{"text":"this","start":6.98,"end":7.34},{"text":"by","start":7.34,"end":7.54},{"text":"moving","start":7.54,"end":7.84},{"text":"our","start":7.84,"end":8.1},{"text":"right","start":8.1,"end":8.36},{"text":"hand","start":8.36,"end":8.76},{"text":"along","start":8.76,"end":9.12},{"text":"the","start":9.12,"end":9.56},{"text":"central","start":9.56,"end":10.08},{"text":"path","start":10.08,"end":10.76},{"text":"of","start":10.76,"end":11},{"text":"our","start":11,"end":11.4},{"text":"body","start":11.4,"end":11.66},{"text":"in","start":11.66,"end":11.94},{"text":"the","start":11.94,"end":12.02},{"text":"front,","start":12.02,"end":12.86},{"text":"palm","start":13.84,"end":13.94},{"text":"upward,","start":13.94,"end":14.8},{"text":"fingers","start":14.8,"end":15.08},{"text":"facing","start":15.08,"end":15.82},{"text":"kind","start":15.82,"end":16.12},{"text":"of","start":16.12,"end":16.32},{"text":"towards","start":16.32,"end":16.58},{"text":"our","start":16.58,"end":16.86},{"text":"body.","start":16.86,"end":17.34}]},{"text":"We just move along our body up past our face on top of our head.","start":18.02,"end":27.46,"words":[{"text":"We","start"