pletely","start":486,"end":486.44},{"text":"fulfilled","start":486.44,"end":486.98},{"text":"within.","start":486.98,"end":487.9}]},{"text":"We can affirm, Mother Kundalini, I am not guilty.","start":488.52,"end":494.06,"words":[{"text":"We","start":488.52,"end":488.62},{"text":"can","start":488.62,"end":488.8},{"text":"affirm,","start":488.8,"end":489.32},{"text":"Mother","start":489.32,"end":490.16},{"text":"Kundalini,","start":490.76,"end":491.86},{"text":"I","start":492.34,"end":492.62},{"text":"am","start":492.62,"end":492.82},{"text":"not","start":492.82,"end":493.2},{"text":"guilty.","start":493.2,"end":494.06}]},{"text":"Please remove all negative thoughts and emotions which would have me feel that I am guilty.","start":497.6,"end":504.2,"words":[{"text":"Please","start":497.6,"end":497.88},{"text":"remove","start":497.88,"end":498.32},{"text":"all","start":498.32,"end":498.78},{"text":"negative","start":498.78,"end":499.14},{"text":"thoughts","start":499.14,"end":499.66},{"text":"and","start":499.66,"end":499.96},{"text":"emotions","start":499.96,"end":500.5},{"text":"which","start":500.5,"end":501.16},{"text":"would","start":501.92,"end":502.2},{"text":"have","start":502.2,"end":502.4},{"text":"me","start":502.4,"end":502.58},{"text":"feel","start":502.58,"end":502.86},{"text":"that","start":502.86,"end":503.18},{"text":"I","start":503.18,"end":503.28},{"text":"am","start":503.28,"end":503.42},{"text":"guilty.","start":503.42,"end":504.2}]},{"text":"All mistakes that I have made are in the past, but in the present, in this moment,","start":519.6,"end":527.28,"words":[{"text":"All","start":519.6,"end":519.8},{"text":"mistakes","start":519.8,"end":520.2},{"text":"that","start":520.2,"end":520.56},{"text":"I","start":520.56,"end":520.64},{"text":"have","start":520.64,"end":520.76},{"text":"made","start":520.76,"end":521.04},{"text":"are","start":521.04,"end":521.28},{"text":"in","start":521.28,"end":521.42},{"text":"the","start":521.42,"end":521.58},{"text":"