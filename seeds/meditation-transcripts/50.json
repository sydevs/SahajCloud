ham.","start":357.78,"end":358.6}]},{"text":"We can also lightly tap either side of the head while we say ksham.","start":359.74,"end":366.88,"words":[{"text":"We","start":359.74,"end":359.88},{"text":"can","start":359.88,"end":360.06},{"text":"also","start":360.06,"end":360.3},{"text":"lightly","start":360.3,"end":360.84},{"text":"tap","start":360.84,"end":361.4},{"text":"either","start":361.4,"end":361.94},{"text":"side","start":361.94,"end":362.34},{"text":"of","start":362.34,"end":362.48},{"text":"the","start":362.48,"end":362.66},{"text":"head","start":362.66,"end":363.1},{"text":"while","start":363.1,"end":363.44},{"text":"we","start":363.98,"end":364.28},{"text":"say","start":364.28,"end":364.66},{"text":"ksham.","start":365.9,"end":366.88}]},{"text":"Ham ksham, ham ksham, ham ksham, ham ksham.","start":367.06,"end":374.18,"words":[{"text":"Ham","start":367.06,"end":367.76},{"text":"ksham,","start":367.76,"end":368.16},{"text":"ham","start":368.16,"end":368.44},{"text":"ksham,","start":368.44,"end":369.26},{"text":"ham","start":369.26,"end":369.6},{"text":"ksham,","start":369.98,"end":371.38},{"text":"ham","start":371.38,"end":371.64},{"text":"ksham.","start":371.98,"end":374.18}]},{"text":"We can take our hands down again. Now place our right hand on our forehead and slightly bend our head downwards.","start":384.74,"end":397.94,"words":[{"text":"We","start":384.74,"end":384.96},{"text":"can","start":384.96,"end":384.96},{"text":"take","start":384.96,"end":385.18},{"text":"our","start":385.18,"end":385.4},{"text":"hands","start":385.4,"end":385.62},{"text":"down","start":385.62,"end":385.92},{"text":"again.","start":385.92,"end":386.66},{"text":"Now","start":392.54,"end":392.72},{"text":"place","start":392.72,"end":393.04},{"text":"our","start":393.04,"end":393.28},{"text":"right","start":393.28,"end":393.52},{"text":"hand","start":393.52,"end":393.72},{"text":"on","start":393.72,"end":393.88},{"text":"our","start":393.88,"end":394.08},{"text":"forehead","start":394.08,"end":394.44},{"text":"and","start":394.44,"end":394.8},{"text":"slightly","start":394.8,"end":395.14},{"text":"bend","start":395.14,"end":395.52},{"text":"our","start":395.52,"end":395.82},{"text":"head","start":395.82,"end":396.36},{"text":"downwards.","start":396.86,"end":397.94}]},{"text":"This center gets constricted by our reactions.","start":408.3,"end":411.56,"words":[{"text":"This","start":408.3,"end":408.58},{"text":"center","start":408.58,"end":408.9},{"text":"gets","start":408.9,"end":409.18},{"text":"constricted","start":409.18,"end":409.94},{"text":"by","start":409.94,"end":410.14},{"text":"our","start":410.14,"end":410.42},{"text":"reactions.","start":410.42,"end":411.56}]},{"text":"So we just say, I forgive. I forgive everyone. I forgive myself.","start":414.26,"end":419.46,"words":[{"text":"So","start":414.26,"end":414.36},{"text":"we","start":414.36,"end":414.38},{"text":"just","start":414.38,"end":414.66},{"text":"say,","start":414.66,"end":415},{"text":"I","start":415,"end":415},{"text":"forgive.","start":415,"end":415.62},{"text":"I","start":417.1,"end":417.46},{"text":"forgive","start":417.46,"end":417.7},{"text":"everyone.","start":417.7,"end":418.28},{"text":"I","start":418.28,"end":418.44},{"text":"forgive","start":418.44,"end":418.72},{"text":"myself.","start":418.72,"end":419.46}]},{"text":"Then we can take our right hand and place it on the back of our head and slightly lean our head backwards into our hand.","start":440.86,"end":448.48,"words":[{"text":"Then","start":440.86,"end":441.06},{"text":"we","start":441.06,"end":441.16},{"text":"can","start":441.16,"end":441.34},{"text":"take","start":441.34,"end":441.56},{"text":"our","start":441.56,"end":441.8},{"text":"right","start":441.8,"end":442.04},{"text":"hand","start":442.04,"end":442.2},{"text":"and","start":442.2,"end":442.4},{"text":"place","start":442.4,"end":442.6},{"text":"it","start":442.6,"end":442.86},{"text":"on","start":442.86,"end":442.9},{"text":"the","start":442.9,"end":443.08},{"text":"back","start":443.08,"end":443.26},{"text":"of","start":443.26,"end":443.48},{"text":"our","start":443.48,"end":443.66},{"text":"head","start":443.66,"end":443.92},{"text":"and","start":443.92,"end":444.18},{"text":"slightly","start":444.18,"end":444.64},{"text":"lean","start":444.64,"end":445.04},{"text":"our","start":445.04,"end":445.26},{"text":"head","start":445.26,"end":445.48},{"text":"backwards","start":445.48,"end":445.98},{"text":"into","start":445.98,"end":446.82},{"text":"our","start":447.82,"end":448.08},{"text":"hand.","start":448.08,"end":448.48}]},{"text":"And here our whole past is stored so we can ask our Kundalini,","start":453.58,"end":458.86,"words":[{"text":"And","start":453.58,"end":453.74},{"text":"here","start":453.74,"end":453.92},{"text":"our","start":453.92,"end":454.16},{"text":"whole","start":454.16,"end":454.38},{"text":"past","start":454.38,"end":454.68},{"text":"is","start":454.68,"end":454.98},{"text":"stored","start":454.98,"end":455.3},{"text":"so","start":455.3,"end":455.88},{"text":"we","start":455.88,"end":456.32},{"text":"can","start":457.4,"end":457.58},{"text":"ask","start":457.58,"end":457.86},{"text":"our","start":457.86,"end":458.12},{"text":"Kundalini,","start":458.12,"end":458.86}]},{"text":"To just forgive us for everything we've done against ourself, against others, whether it was knowingly or unknowingly.","start":459.56,"end":467.78,"words":[{"text":"To","start":459.56,"end":459.74},{"text":"just","start":459.74,"end":460},{"text":"forgive","start":460,"end":460.3},{"text":"us","start":460.3,"end":460.84},{"text":"for","start":460.84,"end":461.14},{"text":"everything","start":461.14,"end":461.52},{"text":"we've","start":461.52,"end":461.92},{"text":"done","start":461.92,"end":462.34},{"text":"against","start":462.34,"end":463.02},{"text":"ourself,","start":463.02,"end":463.92},{"text":"against","start":463.92,"end":464.18},{"text":"others,","start":464.18,"end":465.14},{"text":"whether","start":465.74,"end":465.88},{"text":"it","start":465.88,"end":466.14},{"text":"was","start":466.14,"end":466.3},{"text":"knowingly","start":466.3,"end":466.78},{"text":"or","start":466.78,"end":466.94},{"text":"unknowingly.","start":466.94,"end":467.78}]},{"text":"Just ask for forgiveness so that this center can be cleared and our mind can be cleared and at peace.","start":468.16,"end":475.1,"words":[{"text":"Just","start":468.16,"end":468.38},{"text":"ask","start":468.38,"end":468.62},{"text":"for","start":468.62,"end":468.84},{"text":"forgiveness","start":468.84,"end":469.26},{"text":"so","start":469.26,"end":469.66},{"text":"that","start":469.66,"end":469.82},{"text":"this","start":469.82,"end":470.06},{"text":"center","start":470.06,"end":470.26},{"text":"can","start":470.26,"end":470.54},{"text":"be","start":470.54,"end":470.74},{"text":"cleared","start":470.74,"end":471.02},{"text":"and","start":471.02,"end":471.4},{"text":"our","start":471.4,"end":471.58},{"text":"mind","start":471.58,"end":472.08},{"text":"can","start":472.08,"end":472.54},{"text":"be","start":473.32,"end":473.6},{"text":"cleared","start":473.6,"end":473.94},{"text":"and","start":473.94,"end":474.18},{"text":"at","start":474.18,"end":474.34},{"text":"peace.","start":474.34,"end":475.1}]},{"text":"Finally, we place the palm of our right hand up on the fontanel bone area again.","start":501.82,"end":506.54,"words":[{"text":"Finally,","start":501.82,"end":502.42},{"text":"we","start":502.42,"end":502.42},{"text":"place","start":502.42,"end":502.68},{"text":"the","start":502.68,"end":502.92},{"text":"palm","start":502.92,"end":503.04},{"text":"of","start":503.04,"end":503.28},{"text":"our","start":503.28,"end":503.46},{"text":"right","start":503.46,"end":503.7},{"text":"hand","start":503.7,"end":504.2},{"text":"up","start":504.2,"end":504.64},{"text":"on","start":504.64,"end":504.86},{"text":"the","start":504.86,"end":504.96},{"text":"fontanel","start":504.96,"end":505.4},{"text":"bone","start":505.4,"end":505.66},{"text":"area","start":505.66,"end":505.96},{"text":"again.","start":505.96,"end":506.54}]},{"text":"Once more, massage our scalp seven times clockwise and ask,","start":507.76,"end":514.8,"words":[{"text":"Once","start":507.76,"end":508.12},{"text":"more,","start":508.12,"end":508.5},{"text":"massage","start":508.5,"end":508.76},{"text":"our","start":508.76,"end":509.08},{"text":"scalp","start":509.08,"end":509.34},{"text":"seven","start":509.34,"end":509.74},{"text":"times","start":509.74,"end":510.12},{"text":"clockwise","start":510.12,"end":510.66},{"text":"and","start":510.66,"end":511.46},{"text":"ask,","start":513.98,"end":514.8}]},{"text":"Mother Kundalini, please take me into a state of silence.","start":514.8,"end":518.24,"words":[{"text":"Mother","start":514.8,"end":515.02},{"text":"Kundalini,","start":515.02,"end":515.84},{"text":"please","start":515.84,"end":516.2},{"text":"take","start":516.2,"end":516.64},{"text":"me","start":516.64,"end":516.88},{"text":"into","start":516.88,"end":517.14},{"text":"a","start":517.14,"end":517.38},{"text":"state","start":517.38,"end":517.56},{"text":"of","start":517.56,"end":517.86},{"text":"silence.","start":517.86,"end":518.24}]},{"text":"Please take me beyond my thoughts to that realm of bliss and keeping our attention just there above our head, above the fontanel bone area, we can stay in meditation for as long as we like.","start":528.26,"end":557.78,"words":[{"text":"Please","start":528.26,"end":528.36},{"text":"take","start":528.36,"end":528.64},{"text":"me","start":528.64,"end":528.86},{"text":"beyond","start":528.86,"end":529.18},{"text":"my","start":529.18,"end":529.48},{"text":"thoughts","start":529.48,"end":529.98},{"text":"to","start":529.98,"end":530.48},{"text":"that","start":532.96,"end":533.2},{"text":"realm","start":533.2,"end":533.46},{"text":"of","start":533.46,"end":533.7},{"text":"bliss","start":533.7,"end":534.24},{"text":"and","start":534.24,"end":534.62},{"text":"keeping","s