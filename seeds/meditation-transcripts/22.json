","start":796.42,"end":796.44},{"text":"can","start":796.44,"end":796.56},{"text":"do","start":796.56,"end":796.66},{"text":"this","start":796.66,"end":796.84},{"text":"three","start":796.84,"end":797.04},{"text":"times.","start":797.04,"end":797.76},{"text":"We","start":821.76,"end":821.86},{"text":"can","start":821.86,"end":821.98},{"text":"place","start":821.98,"end":822.2},{"text":"our","start":822.2,"end":822.44},{"text":"hand","start":822.44,"end":822.56},{"text":"on","start":822.56,"end":822.76},{"text":"our","start":822.76,"end":822.84},{"text":"lap,","start":822.84,"end":823.42},{"text":"or","start":824.18,"end":824.28},{"text":"we","start":824.28,"end":824.28},{"text":"can","start":824.28,"end":824.48},{"text":"just","start":824.48,"end":824.68},{"text":"sit","start":824.68,"end":824.9},{"text":"in","start":824.9,"end":825.04},{"text":"silence","start":825.04,"end":825.42},{"text":"for","start":825.42,"end":825.84},{"text":"a","start":825.84,"end":825.88},{"text":"minute.","start":825.88,"end":826.24}]},{"text":"Thank you for this meditation, and I hope you enjoy your day.","start":870.22,"end":874.52,"words":[{"text":"Thank","start":870.22,"end":870.46},{"text":"you","start":870.46,"end":870.62},{"text":"for","start":870.62,"end":870.76},{"text":"this","start":870.76,"end":870.96},{"text":"meditation,","start":870.96,"end":872.18},{"text":"and","start":873.16,"end":873.28},{"text":"I","start":873.28,"end":873.48},{"text":"hope","start":873.48,"end":873.68},{"text":"you","start":873.68,"end":873.84},{"text":"enjoy","start":873.84,"end":874},{"text":"your","start":874,"end":874.24},{"text":"day.","start":874.24,"end":874.52}]}]}
