h.","start":147.84,"end":158.62,"words":[{"text":"Let","start":147.84,"end":148.06},{"text":"go","start":148.06,"end":148.42},{"text":"of","start":148.42,"end":148.74},{"text":"any","start":148.74,"end":149},{"text":"hankering","start":149,"end":149.58},{"text":"after","start":149.58,"end":150.06},{"text":"money,","start":150.06,"end":151.3},{"text":"status,","start":151.3,"end":152.48},{"text":"validation,","start":152.48,"end":153.76},{"text":"and","start":154.04,"end":154.16},{"text":"other","start":154.16,"end":154.48},{"text":"things","start":154.48,"end":155.16},{"text":"that","start":155.16,"end":155.7},{"text":"destabilize","start":155.7,"end":156.52},{"text":"your","start":156.52,"end":156.82},{"text":"sense","start":156.82,"end":157.24},{"text":"of","start":157.24,"end":157.56},{"text":"self-worth.","start":157.56,"end":158.62}]},{"text":"Let go of any stresses in your life. Relinquish your worries. Let them flow away from you.","start":166.46,"end":175.88,"words":[{"text":"Let","start":166.46,"end":166.54},{"text":"go","start":166.54,"end":166.88},{"text":"of","start":166.88,"end":167.18},{"text":"any","start":167.18,"end":167.4},{"text":"stresses","start":167.4,"end":167.76},{"text":"in","start":167.76,"end":168.12},{"text":"your","start":168.12,"end":168.28},{"text":"life.","start":168.28,"end":169.26},{"text":"Relinquish","start":170.78,"end":171.32},{"text":"your","start":171.32,"end":171.58},{"text":"worries.","start":171.58,"end":172.58},{"text":"Let","start":174.2,"end":174.28},{"text":"them","start":174.28,"end":174.62},{"text":"flow","start":174.62,"end":174.94},{"text":"away","start":174.94,"end":175.28},{"text":"from","start":175.28,"end":175.6},{"text":"you.","start":175.6,"end":175.88}]},{"text":"Allow your being to be filled with a deep sense of contentment. Let peace pervade every particle of your being.","start":189.66,"end":203.9,"words":[{"text":"Allow","start":189.66,"end":189.66},{"text":"your","start":189.66,"end":190.04},{"text":"bei