can","start":398.16,"end":398.3},{"text":"place","start":398.3,"end":398.52},{"text":"your","start":398.52,"end":398.78},{"text":"right","start":398.78,"end":399},{"text":"hand","start":399,"end":399.44},{"text":"back","start":399.44,"end":399.8},{"text":"on","start":399.8,"end":399.92},{"text":"your","start":399.92,"end":400.08},{"text":"lap,","start":400.08,"end":400.68},{"text":"but","start":402.08,"end":402.18},{"text":"keep","start":402.18,"end":402.38},{"text":"your","start":402.38,"end":402.64},{"text":"attention","start":402.64,"end":403},{"text":"at","start":403,"end":403.38},{"text":"your","start":403.38,"end":403.58},{"text":"heart.","start":403.58,"end":404.14}]},{"text":"Now we will move our attention to the Agnya chakra at your forehead.","start":434.06,"end":439.08,"words":[{"text":"Now","start":434.06,"end":434.38},{"text":"we","start":434.38,"end":434.54},{"text":"will","start":434.54,"end":434.74},{"text":"move","start":434.74,"end":435.02},{"text":"our","start":435.02,"end":435.28},{"text":"attention","start":435.28,"end":435.82},{"text":"to","start":435.82,"end":436.54},{"text":"the","start":436.92,"end":437.1},{"text":"Agnya","start":437.1,"end":437.38},{"text":"chakra","start":437.38,"end":437.74},{"text":"at","start":437.74,"end":438.24},{"text":"your","start":438.24,"end":438.48},{"text":"forehead.","start":438.48,"end":439.08}]},{"text":"Place your hand across it to help you bring your attention there.","start":443.2,"end":446.88,"words":[{"text":"Place","start":443.2,"end":443.46},{"text":"your","start":443.46,"end":443.74},{"text":"hand","start":443.74,"end":444.06},{"text":"across","start":444.06,"end":444.48},{"text":"it","start":444.48,"end":444.82},{"text":"to","start":444.82,"end":444.98},{"text":"help","start":444.98,"end":445.22},{"text":"you","start":445.22,"end":445.42},{"text":"bring","start":445.42,"end":445.6},{"text":"your","start":445.6,"end":445.82},{"text":"attention","start":445.82,"end":446.2},{"text":"there.","start":446.2,"end":446.88}]},{"text":"This center gets blocked when you cannot forgive and have too much mental activity.","start":457.6,"end":466,"words":[{"text":"This","start":457.6,"end":457.86},{"text":"center","start":457.86,"end":458.18},{"text":"gets","start":458.18,"end":458.48},{"text":"blocked","start":458.48,"end":459.02},{"text":"when","start":459.02,"end":459.64},{"text":"you","start":459.64,"end":459.84},{"text":"cannot","start":459.84,"end":460.1},{"text":"forgive","start":460.1,"end":460.7},{"text":"and","start":460.7,"end":461.38},{"text":"have","start":463.66,"end":463.88},{"text":"too","start":463.88,"end":464.2},{"text":"much","start":464.2,"end":464.58},{"text":"mental","start":464.58,"end":464.98},{"text":"activity.","start":464.98,"end":466}]},{"text":"Here, we will forgive everyone. Again,","start":473.18,"end":479.4,"words":[{"text":"Here,","start":473.18,"end":474.14},{"text":"we","start":474.6,"end":474.72},{"text":"will","start":474.72,"end":474.94},{"text":"forgive","start":474.94,"end":475.22},{"text":"everyone.","start":475.22,"end":476.06},{"text":"Again,","start":478.76,"end":479.4}]},{"text":"No need to think of specific examples, just forgive, and forgive yourself wholeheartedly.","start":480.52,"end":500.1,"words":[{"text":"No","start":480.52,"end":480.52},{"text":"need","start":480.52,"end":480.82},{"text":"to","start":480.82,"end":480.96},{"text":"think","start":480.96,"end":481.16},{"text":"of","start":481.16,"end":481.36},{"text":"specific","start":481.36,"end":481.8},{"text":"examples,","start":481.8,"end":483.08},{"text":"just","start":485.32,"end":485.56},{"text":"forgive,","start":485.56,"end":486.64},{"text":"and","start":497.14,"end":497.32},{"text":"forgive","start":497.32,"end":497.6},{"text":"yourself","start":497.6,"end":498.2},{"text":"wholeheartedly.","start":498.2,"end":500.1}]},{"text":"Allow the peace that comes from forgiveness to permeate your mind.","start":506.62,"end":510.8,"words":[{"text":"Allow","start":506.62,"end":506.82},{"text":"the","start":506.82,"end":507.12},{"text":"peace","start":507.12,"end":507.48},{"text":"that","start":507.48,"end":507.8},{"text":"comes","start":507.8,"end":508.04},{"text":"from","start":508.04,"end":508.36},{"text":"forgiveness","start":508.36,"end":508.76},{"text":"to","start":508.76,"end":509.32},{"text":"permeate","start":509.32,"end":509.9},{"text":"your","start":509.9,"end":510.14},{"text":"mind.","start":510.14,"end":510.8}]},{"text":"Place your right hand back on your lap, but keep your attention at your Agnya.","start":525.94,"end":532.94,"words":[{"text":"Place","start":525.94,"end":526.16},{"text":"your","start":526.16,"end":526.44},{"text":"right","start":526.44,"end":526.68},{"text":"hand","start":526.68,"end":527.14},{"text":"back","start":527.14,"end":527.62},{"text":"on","start":527.62,"end":527.8},{"text":"your","start":527.8,"end":527.96},{"text":"lap,","start":527.96,"end":528.5},{"text":"but","start":530.74,"end":530.9},{"text":"keep","start":530.9,"end":531.08},{"text":"your","start":531.08,"end":531.32},{"text":"attention","start":531.32,"end":531.64},{"text":"at","start":531.64,"end":531.92},{"text":"your","start":531.92,"end":532.06},{"text":"Agnya.","start":532.06,"end":532.94}]},{"text":"Settle into this silence.","start":538.58,"end":540.86,"words":[{"text":"Settle","start":538.58,"end":538.94},{"text":"into","start":538.94,"end":539.5},{"text":"this","start":539.5,"end":539.78},{"text":"silence.","start":539.78,"end":540.86}]},{"text":"Finally, bring your attention to the Sahasrara, the center at the top of your head.","start":570.9,"end":577.26,"words":[{"text":"Finally,","start":570.9,"end":571.86},{"text":"bring","start":572.42,"end":572.62},{"text":"your","start":572.62,"end":572.88},{"text":"attention","start":572.88,"end":573.2},{"text":"to","start":573.2,"end":573.68},{"text":"the","start":573.68,"end":573.84},{"text":"Sahasrara,","start":573.84,"end":574.76},{"text":"the","start":575.26,"end":575.64},{"text":"center","start":575.64,"end":576.02},{"text":"at","start":576.02,"end":576.34},{"text":"the","start":576.34,"end":576.5},{"text":"top","start":576.5,"end":576.56},{"text":"of","start":576.56,"end":576.8},{"text":"your","start":576.8,"end":577.12},{"text":"head.","start":577.12,"end":577.26}]},{"text":"Stretch the fingers of your right hand so that your palm is tight.","start":579.96,"end":585.18,"words":[{"text":"Stretch","start":579.96,"end":580.32},{"text":"the","start":580.32,"end":580.62},{"text":"fingers","start":580.62,"end":581},{"text":"of","start":581,"end":581.24},{"text":"your","start":581.24,"end":581.46},{"text":"right","start":581.46,"end":581.62},{"text":"hand","start":581.62,"end":582.24},{"text":"so","start":582.24,"end":582.68},{"text":"that","start":583.78,"end":583.94},{"text":"your","start":583.94,"end":584.06},{"text":"palm","start":584.06,"end":584.34},{"text":"is","start":584.34,"end":584.62},{"text":"tight.","start":584.62,"end":585.18}]},{"text":"And place the palm on your fontanel bone area at the top of your head.","start":588.2,"end":594.46,"words":[{"text":"And","start":588.2,"end":588.58},{"text":"place","start":588.58,"end":588.88},{"text":"the","start":588.88,"end":589.12},{"text":"palm","start":589.12,"end":589.82},{"text":"on","start":589.82,"end":590.28},{"text":"your","start":590.28,"end":590.46},{"text":"fontanel","start":590.46,"end":590.98},{"text":"bone","start":590.98,"end":591.28},{"text":"area","start":591.28,"end":591.72},{"text":"at","start":591.72,"end":592.32},{"text":"the","start":593.28,"end":593.38},{"text":"top","start":593.38,"end":593.58},{"text":"of","start":593.58,"end":593.76},{"text":"your","start":593.76,"end":593.92},{"text":"head.","start":593.92,"end":594.46}]},{"text":"This is the center of integration.","start":598.26,"end":600.44,"words":[{"text":"This","start":598.26,"end":598.32},{"text":"is","start":598.32,"end":598.58},{"text":"the","start":598.58,"end":598.74},{"text":"center","start":598.74,"end":599.04},{"text":"of","start":599.04,"end":599.32},{"text":"integration.","start":599.32,"end":600.44}]},{"text":"Allow your enlightened self to shine.","start":606.66,"end":609.26,"words":[{"text":"Allow","start":606.66,"end":607.1},{"text":"your","start":607.1,"end":607.42},{"text":"enlightened","start":607.42,"end":607.78},{"text":"self","start":607.78,"end":608.4},{"text":"to","start":608.4,"end":608.68},{"text":"shine.","start":608.68,"end":609.26}]},{"text":"Immerse yourself in the complete silence of meditation.","start":624.28,"end":628.6,"words":[{"text":"Immerse","start":624.28,"end":624.7},{"text":"yourself","start":624.7,"end":625.22},{"text":"in","start":625.22,"end":625.76},{"text":"the","start":625.76,"end":625.98},{"text":"complete","start":625.98,"end":626.26},{"text":"silence","start":626.26,"end":626.92},{"text":"of","start":626.92,"end":627.62},{"text":"meditation.","start":627.62,"end":628.6}]},{"text":"Apply some pressure and rotate the scalp clockwise.","start":645.72,"end":649.6,"words":[{"text":"Apply","start":645.72,"end":645.94},{"text":"some","start":645.94,"end":646.28},{"text":"pressure","start":646.28,"end":646.8},{"text":"and","start":646.8,"end":647.4},{"text":"rotate","start":647.72,"end":648},{"text":"the","start":648,"end":648.34},{"text":"scalp","start":648.34,"end":648.6},{"text":"clockwise.","start":648.6,"end":649.6}]},{"text":"Keep your attention at this point and put your hand back on your lap.","start":670.08,"end":674.86,"words":[{"text":"Keep","start":670.08,"end":670.36},{"text":"your","start":670.36,"end":670.6},{"text":"attention","start":670.6,"end":670.88},{"text":"at","start":670.88,"end":671.26},{"text":"this","start":671.26,"end":671.46},{"text":"point","start":671.46,"end":671.88},{"text":"and","start":671.88,"end":672.42},{"text":"put","start":673.04,"end":673.16},{"text":"your","start":673.16,"end":673.46},{"text":"hand","start":673.46,"end":673.76},{"text":"back","start":673.76,"end":674.14},{"text":"on","start":674.14,"end":674.34},{"text":"your","start":674.34,"end":674.48},{"text":"lap.","start":674.48,"end":674.86}]},{"text":"If your mind cannot be still, remind it that you are in the present.","start":703.64,"end":708.44,"words":[{"text":"If","start":703.64,"end":703.9},{"text":"your","start":703.9,"end":704.1},{"text":"mind","start":704.1,"end":704.46},{"text":"cannot","start":704.46,"end":704.86},{"text":"be","start":704.86,"end":705.16},{"text":"still,","start":705.16,"end":706},{"text":"remind","start":706.3,"end":706.54},{"text":"it","start":706.54,"end":707.32},{"text":"that","start":707.32,"end":707.44},{"text":"you","start":707.44,"end":707.64},{"text":"are","start":707.64,"end":707.88},{"text":"in","start":707.88,"end":708.02},{"text":"the","start":708.02,"end":708.1},{"text":"present.","start":708.1,"end":708.44}]},{"text":"At this point, the future is unknown and you have let go of the past.","start":710.78,"end":716.02,"words":[{"text":"At","start":710.78,"end":710.96},{"text":"this","start":710.96,"end":711.22},{"text":"point,","start":711.22,"end":712.02},{"text":"the","start":712.02,"end":712.16},{"text":"future","start":712.16,"end":712.52},{"text":"is","start":712.52,"end":712.9},{"text":"unknown","start":712.9,"end":713.4},{"text":"and","start":713.4,"end":714.1},{"text":"you","start":714.1,"end":714.26},{"text":"have","start":714.26,"end":714.44},{"text":"let","start":714.44,"end":714.62},{"text":"go","start":714.62,"end":714.86},{"text":"of","start":714.86,"end":715.02},{"text":"the","start":715.02,"end":715.14},{"text":"past.","start":715.14,"end":716.02}]},{"text":"You can also say, not this thought, not this thought, and let them go.","start":758.98,"end":765.06,"words":[{"text":"You","start":758.98,"end":759},{"text":"can","start":759,"end":759.28},{"text":"also","start":759.28,"end":759.62},{"text":"say,","start":759.62,"end":760.78},{"text":"not","start":760.78,"end":760.96},{"text":"this","start":760.96,"end":761.28},{"text":"thought,","start":761.28,"end":762.28},{"text":"not","start":762.28,"end":762.46},{"text":"this","start":762.46,"end":762.78},{"text":"thought,","start":762.78,"end":763.68},{"text":"and","start":763.68,"end":763.86},{"text":"let","start":763.86,"end":764.04},{"text":"them","start":764.04,"end":764.3},{"text":"go.","start":764.3,"end":765.06}]},{"text":"Not this thought, not this thought.","start":795.08,"end":798.06,"words":[{"text":"Not","start":795.08,"end":795.32},{"text":"this","start":795.32,"end":795.58},{"text":"thought,","start":795.58,"end":796.46},{"text":"not","start":796.9,"end":797.08},{"text":"this","start":797.08,"end":797.38},{"text":"thought.","start":797.38,"end":798.06}]},{"text":"Before finishing this meditation, we can say this affirmation.","start":845.38,"end":850.1,"words":[{"text":"Before","start":845.38,"end":845.74},{"text":"finishing","start":845.74,"end":846.2},{"text":"this","start":846.2,"end":846.72},{"text":"meditation,","start":846.72,"end":848.2},{"text":"we","start":848.2,"end":848.3},{"text":"can","start":848.3,"end":848.56},{"text":"say","start":848.56,"end":848.76},{"text":"this","start":848.76,"end":849.08},{"text":"affirmation.","start":849.08,"end":850.1}]},{"text":"Let this inner peace stay with me throughout the day.","start":851.32,"end":854.96,"words":[{"text":"Let","start":851.32,"end":851.56},{"text":"this","start":851.56,"end":851.92},{"text":"inner","start":851.92,"end":852.1},{"text":"peace","start":852.1,"end":852.56},{"text":"stay","start":852.56,"end":853.2},{"text":"with","start":853.2,"end":853.48},{"text":"me","start":853.48,"end":853.86},{"text":"throughout","start":853.86,"end":854.16},{"text":"the","start":854.16,"end":854.46},{"text":"day.","start":854.46,"end":854.96}]},{"text":"Let me be able to return to this state every time I need it.","start":857.4,"end":861.62,"words":[{"text":"Let","start":857.4,"end":857.7},{"text":"me","start":857.7,"end":857.92},{"text":"be","start":857.92,"end":858.1},{"text":"able","start":858.1,"end":858.4},{"text":"to","start":858.4,"end":858.58},{"text":"return","start":858.58,"end":858.9},{"text":"to","start":858.9,"end":859.18},{"text":"this","start":859.18,"end":859.34},{"text":"state","start":859.34,"end":859.76},{"text":"every","start":859.76,"end":860.46},{"text":"time","start":860.46,"end":860.84},{"text":"I","start":860.84,"end":861.04},{"text":"need","start":861.04,"end":861.26},{"text":"it.","start":861.26,"end":861.62}]},{"text":"Thank you for joining us for this meditation.","start":889.36,"end":892.12,"words":[{"text":"Thank","start":889.36,"end":889.6},{"text":"you","start":889.6,"end":889.82},{"text":"for","start":889.82,"end":889.98},{"text":"joining","start":889.98,"end":890.26},{"text":"us","start":890.26,"end":890.82},{"text":"for","start":890.82,"end":891.06},{"text":"this","start":891.06,"end":891.28},{"text":"meditation.","start":891.28,"end":892.12}]}]}
