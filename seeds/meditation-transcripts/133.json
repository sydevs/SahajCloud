tart":783.06,"end":783.34},{"text":"was.","start":783.34,"end":784.16}]},{"text":"Every time a thought comes, we forgive this thought.","start":793.88,"end":801.12,"words":[{"text":"Every","start":793.88,"end":794.12},{"text":"time","start":794.12,"end":794.36},{"text":"a","start":794.36,"end":794.58},{"text":"thought","start":794.58,"end":794.78},{"text":"comes,","start":794.78,"end":795.86},{"text":"we","start":799.62,"end":799.7},{"text":"forgive","start":799.7,"end":800.04},{"text":"this","start":800.04,"end":800.46},{"text":"thought.","start":800.46,"end":801.12}]},{"text":"We let go of everything that is still bothering us.","start":821.88,"end":824.64,"words":[{"text":"We","start":821.88,"end":822.02},{"text":"let","start":822.02,"end":822.22},{"text":"go","start":822.22,"end":822.46},{"text":"of","start":822.46,"end":822.58},{"text":"everything","start":822.58,"end":822.96},{"text":"that","start":822.96,"end":823.22},{"text":"is","start":823.22,"end":823.36},{"text":"still","start":823.36,"end":823.56},{"text":"bothering","start":823.56,"end":823.88},{"text":"us.","start":823.88,"end":824.64}]},{"text":"And when we feel that we are still restless, we just affirm to ourselves,","start":830.28,"end":836.08,"words":[{"text":"And","start":830.28,"end":830.5},{"text":"when","start":830.5,"end":830.72},{"text":"we","start":830.72,"end":830.8},{"text":"feel","start":830.8,"end":831.06},{"text":"that","start":831.06,"end":831.3},{"text":"we","start":831.3,"end":831.54},{"text":"are","start":831.54,"end":831.66},{"text":"still","start":831.66,"end":831.8},{"text":"restless,","start":831.8,"end":833.04},{"text":"we","start":834.16,"end":834.22},{"text":"just","start":834.22,"end":834.48},{"text":"affirm","start":834.48,"end":834.94},{"text":"to","start":834.94,"end":835.24},{"text":"ourselves,","start":835.24,"end":836.08}]},{"text":"I am fully satisfied. I am peaceful.","start":837.24,"end":843.78,"words":[{"text":"I","start":837.24,"end":837.52},{"text":"am","start"