a few minutes.","start":893.1,"end":897.28,"words":[{"text":"We","start":893.1,"end":893.3},{"text":"can","start":893.3,"end":893.56},{"text":"sit","start":893.56,"end":893.78},{"text":"here","start":893.78,"end":894.24},{"text":"in","start":894.24,"end":894.66},{"text":"meditation","start":894.66,"end":895.16},{"text":"for","start":895.16,"end":895.88},{"text":"a","start":896.36,"end":896.56},{"text":"few","start":896.56,"end":896.66},{"text":"minutes.","start":896.66,"end":897.28}]},{"text":"If you are interrupted by thoughts, remember to just let them go.","start":902.86,"end":908.38,"words":[{"text":"If","start":902.86,"end":903.18},{"text":"you","start":903.18,"end":903.32},{"text":"are","start":903.32,"end":903.52},{"text":"interrupted","start":903.52,"end":904},{"text":"by","start":904,"end":904.48},{"text":"thoughts,","start":904.48,"end":905.52},{"text":"remember","start":906.2,"end":906.46},{"text":"to","start":906.46,"end":907.32},{"text":"just","start":907.32,"end":907.6},{"text":"let","start":907.6,"end":907.8},{"text":"them","start":907.8,"end":908.06},{"text":"go.","start":908.06,"end":908.38}]},{"text":"Try to watch these thoughts in a detached state of witness.","start":910.66,"end":915.86,"words":[{"text":"Try","start":910.66,"end":911.04},{"text":"to","start":911.04,"end":911.24},{"text":"watch","start":911.24,"end":911.5},{"text":"these","start":911.5,"end":911.76},{"text":"thoughts","start":911.76,"end":912.26},{"text":"in","start":912.26,"end":912.92},{"text":"a","start":913.58,"end":913.64},{"text":"detached","start":913.64,"end":914.08},{"text":"state","start":914.08,"end":914.66},{"text":"of","start":914.66,"end":915.06},{"text":"witness.","start":915.06,"end":915.86}]},{"text":"Thank you for joining today's session.","start":944.84,"end":947.36,"words":[{"text":"Thank","start":944.84,"end":944.92},{"text":"you","start":944.92,"end":945.28},{"text":"for","start":945.28,"end":945.66},{"text":"joining","start":945.66,"end":946},{"text":"today's","start":946,"end":946.7},{"text":"session.","start":946.7,"end":947.36}]},{"text":"Feel free to remain in meditation as long as you wish.","start":949.08,"end":954.1,"words":[{"text":"Feel","start":949.08,"end":949.42},{"text":"free","start":949.42,"end":949.9},{"text":"to","start":949.9,"end":950.16},{"text":"remain","start":950.16,"end":950.58},{"text":"in","start":950.58,"end":951.22},{"text":"meditation","start":951.86,"end":952.42},{"text":"as","start":952.42,"end":953.16},{"text":"long","start":953.16,"end":953.26},{"text":"as","start":953.26,"end":953.52},{"text":"you","start":953.52,"end":953.62},{"text":"wish.","start":953.62,"end":954.1}]}]}
