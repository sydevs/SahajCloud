","start":835.06,"end":835.22},{"text":"our","start":835.22,"end":835.48},{"text":"right","start":835.48,"end":835.7},{"text":"hand","start":835.7,"end":835.98},{"text":"to","start":835.98,"end":836.14},{"text":"the","start":836.14,"end":836.32},{"text":"Agnya","start":836.32,"end":836.72},{"text":"and","start":836.72,"end":837.32},{"text":"rest","start":837.9,"end":838.18},{"text":"our","start":838.18,"end":838.46},{"text":"head","start":838.46,"end":838.96},{"text":"slightly","start":839.24,"end":839.72},{"text":"in","start":839.72,"end":840},{"text":"our","start":840,"end":840.16},{"text":"hand.","start":840.16,"end":840.58}]},{"text":"And here we can forgive everyone.","start":856.44,"end":859.34,"words":[{"text":"And","start":856.44,"end":856.76},{"text":"here","start":856.76,"end":856.92},{"text":"we","start":856.92,"end":857.12},{"text":"can","start":857.12,"end":857.6},{"text":"forgive","start":857.6,"end":858.42},{"text":"everyone.","start":858.42,"end":859.34}]},{"text":"Forgive everything and also forgive ourselves for any behavior or actions that may have harmed ourselves knowingly or unknowingly.","start":864.24,"end":886.92,"words":[{"text":"Forgive","start":864.24,"end":864.6},{"text":"everything","start":864.6,"end":865.26},{"text":"and","start":865.26,"end":866.04},{"text":"also","start":870.44,"end":870.64},{"text":"forgive","start":870.64,"end":870.94},{"text":"ourselves","start":870.94,"end":871.68},{"text":"for","start":871.68,"end":872.4},{"text":"any","start":875.68,"end":876.12},{"text":"behavior","start":876.12,"end":877.16},{"text":"or","start":878.38,"end":879.28},{"text":"actions","start":880.48,"end":881.14},{"text":"that","start":881.14,"end":881.84},{"text":"may","start":881.84,"end":882.02},{"text":"have","start":882.02,"end":882.5},{"text":"harmed","start":882.5,"end":882.82},{"text":"ourselves","start":882.82,"end":883.54},{"text":"knowingly","start":883.54,"end":884.54},{"text":"or","start":885.64,"end":885.86},{"text":"unknowingly