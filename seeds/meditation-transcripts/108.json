.64},{"text":"force","start":497.64,"end":498},{"text":"which","start":498,"end":498.34},{"text":"protects","start":498.34,"end":498.76},{"text":"me.","start":498.76,"end":499.48}]},{"text":"Please awaken in me that force which gives me security. Then we can put our hand back on our lap.","start":518.12,"end":553.96,"words":[{"text":"Please","start":518.12,"end":518.36},{"text":"awaken","start":518.36,"end":518.76},{"text":"in","start":518.76,"end":519.02},{"text":"me","start":519.02,"end":519.12},{"text":"that","start":519.12,"end":519.38},{"text":"force","start":519.38,"end":519.68},{"text":"which","start":519.68,"end":519.98},{"text":"gives","start":519.98,"end":520.22},{"text":"me","start":520.22,"end":520.44},{"text":"security.","start":520.44,"end":521.34},{"text":"Then","start":522.52,"end":523.42},{"text":"we","start":552.34,"end":552.52},{"text":"can","start":552.52,"end":552.7},{"text":"put","start":552.7,"end":552.82},{"text":"our","start":552.82,"end":553.04},{"text":"hand","start":553.04,"end":553.22},{"text":"back","start":553.22,"end":553.5},{"text":"on","start":553.5,"end":553.54},{"text":"our","start":553.54,"end":553.62},{"text":"lap.","start":553.62,"end":553.96}]},{"text":"Once again, take our right hand and place it on the left side of our neck, sort of between shoulder and neck, and move our head slightly to the right side.","start":555.22,"end":566.72,"words":[{"text":"Once","start":555.22,"end":555.52},{"text":"again,","start":555.52,"end":556.04},{"text":"take","start":556.04,"end":556.08},{"text":"our","start":556.08,"end":556.34},{"text":"right","start":556.34,"end":556.58},{"text":"hand","start":556.58,"end":556.86},{"text":"and","start":556.86,"end":557.1},{"text":"place","start":557.1,"end":557.34},{"text":"it","start":557.34,"end":557.6},{"text":"on","start":557.6,"end":557.8},{"text":"the","start":557.8,"end":558.2},{"text":"left","start":558.2,"end":558.4},{"text":"side","start":558.4,"end":558.66},{"text":"of","start":558.66,"end":5