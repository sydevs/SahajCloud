7.52},{"text":"we","start":577.52,"end":577.76},{"text":"create.","start":577.76,"end":578.36}]},{"text":"So for that, we put our left hand on our ego, which is located on the left side of our head,","start":579.12,"end":584.48,"words":[{"text":"So","start":579.12,"end":579.22},{"text":"for","start":579.22,"end":579.34},{"text":"that,","start":579.34,"end":579.66},{"text":"we","start":579.66,"end":579.68},{"text":"put","start":579.68,"end":579.9},{"text":"our","start":579.9,"end":580.1},{"text":"left","start":580.1,"end":580.34},{"text":"hand","start":580.34,"end":580.56},{"text":"on","start":580.56,"end":580.8},{"text":"our","start":580.8,"end":581.04},{"text":"ego,","start":581.04,"end":581.58},{"text":"which","start":581.58,"end":581.66},{"text":"is","start":581.66,"end":581.86},{"text":"located","start":581.86,"end":582.18},{"text":"on","start":582.18,"end":582.56},{"text":"the","start":582.56,"end":582.8},{"text":"left","start":582.8,"end":583.1},{"text":"side","start":583.1,"end":583.42},{"text":"of","start":583.42,"end":583.64},{"text":"our","start":583.64,"end":583.94},{"text":"head,","start":583.94,"end":584.48}]},{"text":"just above our ear.","start":585.06,"end":586.62,"words":[{"text":"just","start":585.06,"end":585.4},{"text":"above","start":585.4,"end":585.62},{"text":"our","start":585.62,"end":585.96},{"text":"ear.","start":585.96,"end":586.62}]},{"text":"And here again, we say, I am not the doer.","start":590.86,"end":593,"words":[{"text":"And","start":590.86,"end":591.04},{"text":"here","start":591.04,"end":591.18},{"text":"again,","start":591.18,"end":591.44},{"text":"we","start":591.44,"end":591.68},{"text":"say,","start":591.68,"end":592.04},{"text":"I","start":592.04,"end":592.04},{"text":"am","start":592.04,"end":592.22},{"text":"not","start":592.22,"end":592.36},{"text":"the","start":592.36,"end":592.52},{"text":"doer.","start":592.52,"end":593}]},{"text":"There is a creative force much greater and it can flow through me and create beautiful objects, beautiful sound, beautiful words, beautiful actions.","start":598.5,"end":614.14,"words":[{"text":"There","start":598.5,"end":598.68},{"text":"is","start":598.68,"end":598.9},{"text":"a","start":598.9,"end":599.06},{"text":"creative","start":599.06,"end":599.38},{"text":"force","start":599.38,"end":599.82},{"text":"much","start":599.82,"end":600.08},{"text":"greater","start":600.08,"end":600.64},{"text":"and","start":600.64,"end":601.16},{"text":"it","start":602.58,"end":602.68},{"text":"can","start":602.68,"end":602.84},{"text":"flow","start":602.84,"end":603.08},{"text":"through","start":603.08,"end":603.4},{"text":"me","start":603.4,"end":603.64},{"text":"and","start":603.64,"end":603.84},{"text":"create","start":603.84,"end":604.32},{"text":"beautiful","start":604.32,"end":604.94},{"text":"objects,","start":604.94,"end":606.34},{"text":"beautiful","start":607.02,"end":607.28},{"text":"sound,","start":607.28,"end":608.44},{"text":"beautiful","start":609.14,"end":609.46},{"text":"words,","start":609.46,"end":610.44},{"text":"beautiful","start":612.72,"end":612.98},{"text":"actions.","start":612.98,"end":614.14}]},{"text":"I'm not here to judge what I create. We can place our left hand back on our lap.","start":618.02,"end":640.5,"words":[{"text":"I'm","start":618.02,"end":618.16},{"text":"not","start":618.16,"end":618.26},{"text":"here","start":618.26,"end":618.44},{"text":"to","start":618.44,"end":618.68},{"text":"judge","start":618.68,"end":618.88},{"text":"what","start":618.88,"end":619.18},{"text":"I","start":619.18,"end":619.4},{"text":"create.","start":619.4,"end":620.3},{"text":"We","start":638.24,"end":638.42},{"text":"can","start":638.42,"end":638.42},{"text":"place","start":638.42,"end":638.68},{"text":"our","start":638.68,"end":638.92},{"text":"left","start":638.92,"end":639.1},{"text":"hand","start":639.1,"end":639.32},{"text":"back","start":639.32,"end":639.58},{"text":"on","start":639.58,"end":639.74},{"text":"our","start":639.74,"end":639.84},{"text":"lap.","start":639.84,"end":640.5}]},{"text":"Now to reinforce our connection with the whole we can lift our right hand in front of our body,","start":645.34,"end":651.28,"words":[{"text":"Now","start":645.34,"end":645.52},{"text":"to","start":645.52,"end":645.74},{"text":"reinforce","start":645.74,"end":646.08},{"text":"our","start":646.08,"end":646.42},{"text":"connection","start":646.42,"end":646.8},{"text":"with","start":646.8,"end":647.12},{"text":"the","start":647.12,"end":647.24},{"text":"whole","start":647.24,"end":647.36},{"text":"we","start":647.36,"end":647.5},{"text":"can","start":647.5,"end":647.72},{"text":"lift","start":647.72,"end":647.96},{"text":"our","start":647.96,"end":648.24},{"text":"right","start":648.24,"end":648.52},{"text":"hand","start":648.52,"end":648.98},{"text":"in","start":648.98,"end":649.44},{"text":"front","start":650,"end":650.22},{"text":"of","start":650.22,"end":650.44},{"text":"our","start":650.44,"end":650.54},{"text":"body,","start":650.54,"end":651.28}]},{"text":"along the central path, upwards, towards the Sahasrara, above our head. We can do this seven times","start":651.28,"end":662.96,"words":[{"text":"along","start":651.28,"end":651.64},{"text":"the","start":651.64,"end":651.96},{"text":"central","start":651.96,"end":652.32},{"text":"path,","start":652.32,"end":653.3},{"text":"upwards,","start":656.08,"end":656.98},{"text":"towards","start":656.98,"end":657.14},{"text":"the","start":657.14,"end":657.4},{"text":"Sahasrara,","start":657.4,"end":658.5},{"text":"above","start":658.5,"end":658.7},{"text":"our","start":658.7,"end":659},{"text":"head.","start":659,"end":659.32},{"text":"We","start":661.3,"end":661.58},{"text":"can","start":661.58,"end":661.76},{"text":"do","start":661.76,"end":661.9},{"text":"this","start":661.9,"end":662.26},{"text":"seven","start":662.26,"end":662.5},{"text":"times","start":662.5,"end":662.96}]},{"text":"With this movement we're helping our Kundalini to rise. We're kind of lifting her up.","start":673.16,"end":678.48,"words":[{"text":"With","start":673.16,"end":673.3},{"text":"this","start":673.3,"end":673.5},{"text":"movement","start":673.5,"end":673.84},{"text":"we're","start":673.84,"end":674.12},{"text":"helping","start":674.12,"end":674.36},{"text":"our","start":674.36,"end":674.72},{"text":"Kundalini","start":674.72,"end":675.12},{"text":"to","start":675.12,"end":675.5},{"text":"rise.","start":675.5,"end":676.4},{"text":"We're","start":676.86,"end":677.12},{"text":"kind","start":677.12,"end":677.12},{"text":"of","start":677.12,"end":677.24},{"text":"lifting","start":677.24,"end":677.52},{"text":"her","start":677.52,"end":677.94},{"text":"up.","start":677.94,"end":678.48}]},{"text":"Now attention should also be lifted along our spine, up through the fontanel bone area and beyond it.","start":681.5,"end":689.4,"words":[{"text":"Now","start":681.5,"end":681.66},{"text":"attention","start":681.66,"end":681.96},{"text":"should","start":681.96,"end":682.32},{"text":"also","start":682.32,"end":682.64},{"text":"be","start":682.64,"end":682.96},{"text":"lifted","start":682.96,"end":683.46},{"text":"along","start":683.46,"end":684.2},{"text":"our","start":684.64,"end":685.02},{"text":"spine,","start":685.02,"end":685.68},{"text":"up","start":685.68,"end":685.92},{"text":"through","start":686.24,"end":686.64},{"text":"the","start":686.64,"end":686.8},{"text":"fontanel","start":686.8,"end":687.26},{"text":"bone","start":687.26,"end":687.52},{"text":"area","start":687.52,"end":687.9},{"text":"and","start":687.9,"end":688.62},{"text":"beyond","start":688.62,"end":688.82},{"text":"it.","start":688.82,"end":689.4}]},{"text":"And then we can place the palm of our right hand on the fontanel bone area.","start":711.98,"end":715.48,"words":[{"text":"And","start":711.98,"end":712.14},{"text":"then","start":712.14,"end":712.34},{"text":"we","start":712.34,"end":712.38},{"text":"can","start":712.38,"end":712.5},{"text":"place","start":712.5,"end":712.76},{"text":"the","start":712.76,"end":713.02},{"text":"palm","start":713.02,"end":713.16},{"text":"of","start":713.16,"end":713.42},{"text":"our","start":713.42,"end":713.56},{"text":"right","start":713.56,"end":713.7},{"text":"hand","start":713.7,"end":713.88},{"text":"on","start":713.88,"end":714.14},{"text":"the","start":714.14,"end":714.3},{"text":"fontanel","start":714.3,"end":714.72},{"text":"bone","start":714.72,"end":715},{"text":"area.","start":715,"end":715.48}]},{"text":"Just stretch our fingers back so we create a slight pressure and then massage our scalp seven times clockwise.","start":716.64,"end":723.08,"words":[{"text":"Just","start":716.64,"end":716.92},{"text":"stretch","start":716.92,"end":717.26},{"text":"our","start":717.26,"end":717.6},{"text":"fingers","start":717.6,"end":717.9},{"text":"back","start":717.9,"end":718.48},{"text":"so","start":718.48,"end":718.74},{"text":"we","start":718.74,"end":718.92},{"text":"create","start":718.92,"end":719.18},{"text":"a","start":719.18,"end":719.4},{"text":"slight","start":719.4,"end":719.6},{"text":"pressure","start":719.6,"end":719.94},{"text":"and","start":719.94,"end":720.32},{"text":"then","start":720.32,"end":720.58},{"text":"massage","start":720.58,"end":720.92},{"text":"our","start":720.92,"end":721.3},{"text":"scalp","start":721.3,"end":721.56},{"text":"seven","start":721.56,"end":721.96},{"text":"times","start":721.96,"end":722.26},{"text":"clockwise.","start":722.26,"end":723.08}]},{"text":"We can ask again, Mother Kundalini please connect me to the all-pervading power of love.","start":736.46,"end":742.92,"words":[{"text":"We","start":736.46,"end":736.64},{"text":"can","start":736.64,"end":736.64},{"text":"ask","start":736.64,"end":736.84},{"text":"again,","start":736.84,"end":737.28},{"text":"Mother","start":737.28,"end":737.44},{"text":"Kundalini","start":737.44,"end":738.04},{"text":"please","start":738.04,"end":738.42},{"text":"connect","start":738.42,"end":738.72},{"text":"me","start":738.72,"end":739.3},{"text":"to","start":739.3,"end":739.72},{"text":"the","start":741.12,"end":741.26},{"text":"all-pervading","start":741.26,"end":741.9},{"text":"power","start":741.9,"end":742.34},{"text":"of","start":742.34,"end":742.64},{"text":"love.","start":742.64,"end":742.92}]},{"text":"And let me be an instrument of that love in everything I create.","start":746.42,"end":750.2,"words":[{"text":"And","start":746.42,"end":746.58},{"text":"let","start":746.58,"end":746.76},{"text":"me","start":746.76,"end":746.94},{"text":"be","start":746.94,"end":747.1},{"text":"an","start":747.1,"end":747.26},{"text":"instrument","start":747.26,"end":747.62},{"text":"of","start":747.62,"end":748},{"text":"that","start":748,"end":748.24},{"text":"love","start":748.24,"end":748.48},{"text":"in","start":748.48,"end":748.72},{"text":"everything","start":748.72,"end":749.02},{"text":"I","start":749.02,"end":749.32},{"text":"create.","start":749.32,"end":750.2}]},{"text":"And then we can slowly lift our hand just some five, seven centimeters above our head and see what we feel.","start":759.54,"end":767.6,"words":[{"text":"And","start":759.54,"end":759.64},{"text":"then","start":759.64,"end":759.74},{"text":"we","start":759.74,"end":759.8},{"text":"can","start":759.8,"end":760.02},{"text":"slowly","start":760.02,"end":760.36},{"text":"lift","start":760.36,"end":760.74},{"text":"our","start":760.74,"end":761.04},{"text":"hand","start":761.04,"end":761.56},{"text":"just","start":761.56,"end":762.16},{"text":"some","start":763.48,"end":764.12},{"text":"five,","start":764.12,"end":764.66},{"text":"seven","start":764.66,"end":764.88},{"text":"centimeters","start":764.88,"end":765.48},{"text":"above","start":765.48,"end":765.92},{"text":"our","start":765.92,"end":766.22},{"text":"head","start":766.22,"end":766.4},{"text":"and","start":766.4,"end":766.66},{"text":"see","start":766.66,"end":766.82},{"text":"what","start":766.82,"end":767},{"text":"we","start":767,"end":767.22},{"text":"feel.","start":767.22,"end":767.6}]},{"text":"After taking that hand down, we can try with our left hand just to feel above our head.","start":774.54,"end":779.16,"words":[{"text":"After","start":774.54,"end":774.84},{"text":"taking","start":774.84,"end":775.18},{"text":"that","start":775.18,"end":775.5},{"text":"hand","start":775.5,"end":775.72},{"text":"down,","start":775.72,"end":776.08},{"text":"we","start":776.08,"end":776.1},{"text":"can","start":776.1,"end":776.3},{"text":"try","start":776.3,"end":776.54},{"text":"with","start":776.54,"end":776.74},{"text":"our","start":776.74,"end":776.86},{"text":"left","start":776.86,"end":777.1},{"text":"hand","start":777.1,"end":777.5},{"text":"just","start":777.5,"end":777.86},{"text":"to","start":777.86,"end":778.02},{"text":"feel","start":778.02,"end":778.18},{"text":"above","start":778.18,"end":778.5},{"text":"our","start":778.5,"end":778.88},{"text":"head.","start":778.88,"end":779.16}]},{"text":"When the kundalini pierces our seventh center and comes through the fontanel bone area,","start":787.54,"end":792.7,"words":[{"text":"When","start":787.54,"end":787.76},{"text":"the","start":787.76,"end":787.92},{"text":"kundalini","start":787.92,"end":788.4},{"text":"pierces","start":788.4,"end":788.88},{"text":"our","start":788.88,"end":789.28},{"text":"seventh","start":789.28,"end":789.94},{"text":"center","start":789.94,"end":790.42},{"text":"and","start":790.42,"end":790.66},{"text":"comes","start":790.66,"end":790.88},{"text":"through","start":790.88,"end":791.24},{"text":"the","start":791.24,"end":791.46},{"text":"fontanel","start":791.46,"end":791.98},{"text":"bone","start":791.98,"end":792.24},{"text":"area,","start":792.24,"end":792.7}]},{"text":"we should reach a state of thoughtless awareness.","start":793.22,"end":795.68,"words":[{"text":"we","start":793.22,"end":793.4},{"text":"should","start":793.4,"end":793.54},{"text":"reach","start":793.54,"end":793.8},{"text":"a","start":793.8,"end":794.1},{"text":"state","start":794.1,"end":794.28},{"text":"of","start":794.28,"end":794.52},{"text":"thoughtless","start":794.52,"end":794.98},{"text":"awareness.","start":794.98,"end":795.68}]},{"text":"And if we create in that state of thoughtless awareness,","start":797.7,"end":800.44,"words":[{"text":"And","start":797.7,"end":797.82},{"text":"if","start":797.82,"end":797.98},{"text":"we","start":797.98,"end":798.06},{"text":"create","start":798.06,"end":798.46},{"text":"in","start":798.46,"end":798.7},{"text":"that","start":798.7,"end":798.8},{"text":"state","start":798.8,"end":799.06},{"text":"of","start":799.06,"end":799.3},{"text":"thoughtless","start":799.3,"end":799.74},{"text":"awareness,","start":799.74,"end":800.44}]},{"text":"Our creations are filled with good energy that other people can also feel.","start":801.38,"end":806.52,"words":[{"text":"Our","start":801.38,"end":801.62},{"text":"creations","start":801.62,"end":802.14},{"text":"are","start":802.14,"end":802.64},{"text":"filled","start":802.64,"end":802.9},{"text":"with","start":802.9,"end":803.2},{"text":"good","start":803.2,"end":803.44},{"text":"energy","start":803.44,"end":803.86},{"text":"that","start":803.86,"end":804.48},{"text":"other","start":804.74,"end":804.94},{"text":"people","start":804.94,"end":805.26},{"text":"can","start":805.26,"end":805.58},{"text":"also","start":805.58,"end":805.82},{"text":"feel.","start":805.82,"end":806.52}]},{"text":"So you can enjoy the silence, enjoy this connection and then use it to create something.","start":828.14,"end":835,"words":[{"text":"So","start":828.14,"end":828.32},{"text":"you","start":828.32,"end":828.32},{"text":"can","start":828.32,"end":828.52},{"text":"enjoy","start":828.52,"end":828.86},{"text":"the","start":828.86,"end":829.14},{"text":"silence,","start":829.14,"end":830.2},{"text":"enjoy","start":830.66,"end":830.84},{"text":"this","start":830.84,"end":831.12},{"text":"connection","start":831.12,"end":831.68},{"text":"and","start":831.68,"end":832.36},{"text":"then","start":832.36,"end":832.74},{"text":"use","start":832.74,"end":833.24},{"text":"it","start":833.24,"end":833.58},{"text":"to","start":833.58,"end":834},{"text":"create","start":834,"end":834.36},{"text":"something.","start":834.36,"end":835}]}]}
