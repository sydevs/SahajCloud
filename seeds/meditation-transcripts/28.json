:267.56,"end":267.8},{"text":"just","start":267.8,"end":268.06},{"text":"where","start":268.06,"end":268.24},{"text":"the","start":268.24,"end":268.34},{"text":"ribs","start":268.34,"end":268.58},{"text":"end,","start":268.58,"end":269.54},{"text":"you","start":271.02,"end":271.02},{"text":"can","start":271.02,"end":271.1},{"text":"even","start":271.1,"end":271.3},{"text":"apply","start":271.3,"end":271.6},{"text":"a","start":271.6,"end":271.76},{"text":"bit","start":271.76,"end":271.88},{"text":"of","start":271.88,"end":272.1},{"text":"pressure.","start":272.1,"end":272.48}]},{"text":"The center gets blocked when we worry, when we're restless, dissatisfied.","start":276.18,"end":283.94,"words":[{"text":"The","start":276.18,"end":276.38},{"text":"center","start":276.38,"end":276.72},{"text":"gets","start":276.72,"end":277.14},{"text":"blocked","start":277.14,"end":277.66},{"text":"when","start":277.66,"end":278.14},{"text":"we","start":278.14,"end":278.32},{"text":"worry,","start":278.32,"end":279.16},{"text":"when","start":279.72,"end":279.9},{"text":"we're","start":279.9,"end":280.66},{"text":"restless,","start":281.44,"end":282.76},{"text":"dissatisfied.","start":282.76,"end":283.94}]},{"text":"So here we can say, Mother Kundalini, please settle my mind.","start":286.58,"end":292.98,"words":[{"text":"So","start":286.58,"end":286.66},{"text":"here","start":286.66,"end":286.8},{"text":"we","start":286.8,"end":286.98},{"text":"can","start":286.98,"end":287.2},{"text":"say,","start":287.2,"end":287.98},{"text":"Mother","start":289.04,"end":289.2},{"text":"Kundalini,","start":289.2,"end":289.92},{"text":"please","start":289.92,"end":290.34},{"text":"settle","start":290.34,"end":291.26},{"text":"my","start":291.26,"end":292.14},{"text":"mind.","start":292.14,"end":292.98}]},{"text":"Let there be no worries on my mind about family or money issues.","start":296.06,"end":300.12,"words":[{"text":"Let","start":296.06,"end":296.16},{"text":"there","start":296.16,"end":296.32},{"text":"be","start":296.32,"end":296.44},{"text":"no","start":296.44,"end":296.66},{"text":"worries","start":296.66,"end":297.02},{"text":"on","start":297.02,"end":297.32},{"text":"my","start":297.32,"end":297.48},{"text":"mind","start":297.48,"end":297.76},{"text":"about","start":297.76,"end":298.14},{"text":"family","start":298.14,"end":298.56},{"text":"or","start":298.56,"end":299.16},{"text":"money","start":299.16,"end":299.44},{"text":"issues.","start":299.44,"end":300.12}]},{"text":"Let me be peaceful and satisfied from within.","start":305.24,"end":308.82,"words":[{"text":"Let","start":305.24,"end":305.32},{"text":"me","start":305.32,"end":305.52},{"text":"be","start":305.52,"end":305.7},{"text":"peaceful","start":305.7,"end":306.08},{"text":"and","start":306.08,"end":306.38},{"text":"satisfied","start":306.38,"end":306.8},{"text":"from","start":306.8,"end":307.58},{"text":"within.","start":308.16,"end":308.82}]},{"text":"Next, we place our right hand on the center of our chest.","start":323.3,"end":326.98,"words":[{"text":"Next,","start":323.3,"end":323.8},{"text":"we","start":323.8,"end":323.8},{"text":"place","start":323.8,"end":324.14},{"text":"our","start":324.14,"end":324.4},{"text":"right","start":324.4,"end":324.6},{"text":"hand","start":324.6,"end":324.74},{"text":"on","start":324.74,"end":325.02},{"text":"the","start":325.02,"end":325.14},{"text":"center","start":325.14,"end":325.52},{"text":"of","start":325.52,"end":325.86},{"text":"our","start":325.86,"end":326.04},{"text":"chest.","start":326.04,"end":326.98}]},{"text":"It's called the center heart. We can breathe in deeply, hold our breath.","start":328.56,"end":337.56,"words":[{"text":"It's","start":328.56,"end":328.68},{"text":"called","start":328.68,"end":328.82},{"text":"the","start":328.82,"end":329.02},{"text":"center","start":329.02,"end":329.28},{"text":"heart.","start":329.28,"end":329.96},{"text":"We","start":333.76,"end":334.02},{"text":"can","start":334.02,"end":334.16},{"text":"b