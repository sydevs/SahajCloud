},{"text":"of","start":92.98,"end":93.24},{"text":"our","start":93.24,"end":93.42},{"text":"head.","start":93.42,"end":93.78}]},{"text":"With a bit of pressure just gently massage our scalp, clockwise seven times.","start":94.4,"end":100,"words":[{"text":"With","start":94.4,"end":94.62},{"text":"a","start":94.62,"end":94.74},{"text":"bit","start":94.74,"end":94.88},{"text":"of","start":94.88,"end":95.1},{"text":"pressure","start":95.1,"end":95.4},{"text":"just","start":95.4,"end":96.12},{"text":"gently","start":96.12,"end":96.74},{"text":"massage","start":96.74,"end":97.26},{"text":"our","start":97.26,"end":97.66},{"text":"scalp,","start":97.66,"end":98.4},{"text":"clockwise","start":98.4,"end":98.96},{"text":"seven","start":98.96,"end":99.4},{"text":"times.","start":99.4,"end":100}]},{"text":"And we can ask inside, Mother Kundalini, please give me the yoga, the union with my true self and with the whole.","start":104.32,"end":115.66,"words":[{"text":"And","start":104.32,"end":104.56},{"text":"we","start":104.56,"end":104.62},{"text":"can","start":104.62,"end":104.84},{"text":"ask","start":104.84,"end":105.1},{"text":"inside,","start":105.1,"end":106.12},{"text":"Mother","start":106.52,"end":106.7},{"text":"Kundalini,","start":106.7,"end":107.9},{"text":"please","start":107.9,"end":107.9},{"text":"give","start":107.9,"end":108.26},{"text":"me","start":108.26,"end":108.48},{"text":"the","start":108.48,"end":108.6},{"text":"yoga,","start":108.6,"end":109.62},{"text":"the","start":109.96,"end":109.96},{"text":"union","start":109.96,"end":110.3},{"text":"with","start":110.3,"end":111.04},{"text":"my","start":111.68,"end":111.92},{"text":"true","start":111.92,"end":112.08},{"text":"self","start":112.08,"end":112.68},{"text":"and","start":112.68,"end":113.18},{"text":"with","start":115,"end":115.14},{"text":"the","start":115.14,"end":115.34},{"text":"whole.","start":115.34,"end":115.66}]},{"text":"Please give me my Self-realization.","start":116.6,"end":118.7,"words":[{"t