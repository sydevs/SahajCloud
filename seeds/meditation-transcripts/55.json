{"meditationId":55,"audioFilename":"step-2-thoughtless-awareness-meditation-sander-processed-k7eotn34o1.mp3","language":"english","provider":"lemonfox","segments":[{"text":"To start this meditation, sit down either on a chair or on the floor, however is most comfortable for you.","start":4.76,"end":13.08,"words":[{"text":"To","start":4.76,"end":4.88},{"text":"start","start":4.88,"end":5.16},{"text":"this","start":5.16,"end":5.42},{"text":"meditation,","start":5.42,"end":6.7},{"text":"sit","start":6.7,"end":6.88},{"text":"down","start":6.88,"end":7.42},{"text":"either","start":7.42,"end":7.8},{"text":"on","start":7.8,"end":8.02},{"text":"a","start":8.02,"end":8.14},{"text":"chair","start":8.14,"end":8.48},{"text":"or","start":8.48,"end":8.9},{"text":"on","start":8.9,"end":9.06},{"text":"the","start":9.06,"end":9.18},{"text":"floor,","start":9.18,"end":9.98},{"text":"however","start":10.98,"end":11.24},{"text":"is","start":11.24,"end":11.56},{"text":"most","start":11.56,"end":11.78},{"text":"comfortable","start":11.78,"end":12.18},{"text":"for","start":12.18,"end":12.5},{"text":"you.","start":12.5,"end":13.08}]},{"text":"Try to keep your back straight, not in a stiff way, but not slouching.","start":14.96,"end":22.22,"words":[{"text":"Try","start":14.96,"end":15.02},{"text":"to","start":15.02,"end":15.2},{"text":"keep","start":15.2,"end":15.4},{"text":"your","start":15.4,"end":15.62},{"text":"back","start":15.62,"end":15.92},{"text":"straight,","start":15.92,"end":16.96},{"text":"not","start":17.98,"end":18.08},{"text":"in","start":18.08,"end":18.32},{"text":"a","start":18.32,"end":18.4},{"text":"stiff","start":18.4,"end":18.64},{"text":"way,","start":18.64,"end":19.34},{"text":"but","start":20.82,"end":20.98},{"text":"not","start":20.98,"end":21.24},{"text":"slouching.","start":21.24,"end":22.22}]},{"text":"Open both of your hands out onto your lap, the palms facing upwards.","start":24.7,"end":28.86,"words":[{"text":"Open","start":24.7,"end":25.02},{"text":"both","start":25.02,"end":25.3},{"text":"of","start":25.3,"end":25.38},{"text":"your","start":25.38,"end":25.58},{"text":"hands","start":25.58,"end":25.8},{"text":"out","start":25.8,"end":26.08},{"text":"onto","start":26.08,"end":26.32},{"text":"your","start":26.32,"end":26.5},{"text":"lap,","start":26.5,"end":27.1},{"text":"the","start":27.42,"end":27.52},{"text":"palms","start":27.52,"end":27.78},{"text":"facing","start":27.78,"end":28.14},{"text":"upwards.","start":28.14,"end":28.86}]},{"text":"Relax your shoulders, close your eyes, and take a few deep breaths in and out.","start":30.34,"end":36.2,"words":[{"text":"Relax","start":30.34,"end":30.68},{"text":"your","start":30.68,"end":30.98},{"text":"shoulders,","start":30.98,"end":31.92},{"text":"close","start":32.4,"end":32.68},{"text":"your","start":32.68,"end":32.96},{"text":"eyes,","start":32.96,"end":34.02},{"text":"and","start":34.02,"end":34.16},{"text":"take","start":34.16,"end":34.34},{"text":"a","start":34.34,"end":34.58},{"text":"few","start":34.58,"end":34.8},{"text":"deep","start":34.8,"end":35.1},{"text":"breaths","start":35.1,"end":35.46},{"text":"in","start":35.46,"end":35.72},{"text":"and","start":35.72,"end":35.88},{"text":"out.","start":35.88,"end":36.2}]},{"text":"In this meditation, we will try to raise our Kundalini within.","start":66.06,"end":70.34,"words":[{"text":"In","start":66.06,"end":66.32},{"text":"this","start":66.32,"end":66.52},{"text":"meditation,","start":66.52,"end":67.74},{"text":"we","start":67.74,"end":67.76},{"text":"will","start":67.76,"end":68},{"text":"try","start":68,"end":68.24},{"text":"to","start":68.24,"end":68.76},{"text":"raise","start":68.76,"end":69.08},{"text":"our","start":69.08,"end":69.3},{"text":"Kundalini","start":69.3,"end":69.78},{"text":"within.","start":69.78,"end":70.34}]},{"text":"So that she may bring us to a state of thoughtless awareness, a pure state of meditation,","start":71.18,"end":78.58,"words":[{"text":"So","start":71.18,"end":71.38},{"text":"that","start":71.38,"end":71.6},{"text":"she","start":71.6,"end":71.86},{"text":"may","start":71.86,"end":72.24},{"text":"bring","start":72.24,"end":72.5},{"text":"us","start":72.5,"end":72.92},{"text":"to","start":72.92,"end":73.2},{"text":"a","start":73.2,"end":73.28},{"text":"state","start":73.28,"end":73.66},{"text":"of","start":73.66,"end":74.16},{"text":"thoughtless","start":74.16,"end":74.66},{"text":"awareness,","start":74.66,"end":75.7},{"text":"a","start":76.44,"end":76.48},{"text":"pure","start":76.48,"end":76.76},{"text":"state","start":76.76,"end":77.18},{"text":"of","start":77.18,"end":77.5},{"text":"meditation,","start":77.5,"end":78.58}]},{"text":"where our mind is silent but we are completely conscious and aware of ourselves and our surroundings.","start":79.24,"end":85.32,"words":[{"text":"where","start":79.24,"end":79.38},{"text":"our","start":79.38,"end":79.54},{"text":"mind","start":79.54,"end":79.8},{"text":"is","start":79.8,"end":80.06},{"text":"silent","start":80.06,"end":80.48},{"text":"but","start":80.48,"end":80.98},{"text":"we","start":81.36,"end":81.46},{"text":"are","start":81.46,"end":81.68},{"text":"completely","start":81.68,"end":82.02},{"text":"conscious","start":82.02,"end":82.62},{"text":"and","start":82.62,"end":82.98},{"text":"aware","start":82.98,"end":83.26},{"text":"of","start":83.26,"end":83.54},{"text":"ourselves","start":83.54,"end":84.02},{"text":"and","start":84.02,"end":84.3},{"text":"our","start":84.3,"end":84.44},{"text":"surroundings.","start":84.44,"end":85.32}]},{"text":"This state of thoughtless awareness can only occur when we are truly in the present and we","start":89.64,"end":95.7,"words":[{"text":"This","start":89.64,"end":89.98},{"text":"state","start":89.98,"end":90.24},{"text":"of","start":90.24,"end":90.46},{"text":"thoughtless","start":90.46,"end":90.88},{"text":"awareness","start":90.88,"end":91.4},{"text":"can","start":91.4,"end":91.68},{"text":"only","start":91.68,"end":91.96},{"text":"occur","start":91.96,"end":92.66},{"text":"when","start":92.66,"end":93.24},{"text":"we","start":93.24,"end":93.32},{"text":"are","start":93.32,"end":93.52},{"text":"truly","start":93.52,"end":93.76},{"text":"in","start":93.76,"end":94.04},{"text":"the","start":94.04,"end":94.18},{"text":"present","start":94.18,"end":94.58},{"text":"and","start":94.58,"end":95.1},{"text":"we","start":95.64,"end":95.7}]},{"text":"do not have thoughts which are either reflecting on the past or anticipating the future.","start":95.88,"end":101.58,"words":[{"text":"do","start":95.88,"end":95.88},{"text":"not","start":95.88,"end":96.14},{"text":"have","start":96.14,"end":96.34},{"text":"thoughts","start":96.34,"end":96.76},{"text":"which","start":96.76,"end":97.34},{"text":"are","start":97.6,"end":97.8},{"text":"either","start":97.8,"end":97.98},{"text":"reflecting","start":97.98,"end":98.36},{"text":"on","start":98.36,"end":98.66},{"text":"the","start":98.66,"end":98.8},{"text":"past","start":98.8,"end":99.22},{"text":"or","start":99.22,"end":99.76},{"text":"anticipating","start":100.16,"end":100.64},{"text":"the","start":100.64,"end":101},{"text":"future.","start":101,"end":101.58}]},{"text":"To help bring us into this state we will cleanse our left and right channels","start":106.34,"end":112.04,"words":[{"text":"To","start":106.34,"end":106.56},{"text":"help","start":106.56,"end":106.78},{"text":"bring","start":106.78,"end":106.96},{"text":"us","start":106.96,"end":107.26},{"text":"into","start":107.26,"end":107.5},{"text":"this","start":107.5,"end":107.8},{"text":"state","start":107.8,"end":108.16},{"text":"we","start":108.16,"end":108.56},{"text":"will","start":109.5,"end":109.74},{"text":"cleanse","start":109.74,"end":110.22},{"text":"our","start":110.22,"end":110.8},{"text":"left","start":110.8,"end":111.08},{"text":"and","start":111.08,"end":111.36},{"text":"right","start":111.36,"end":111.6},{"text":"channels","start":111.6,"end":112.04}]},{"text":"Thus calming down the activity within which comes from our attention on the past or the future.","start":113.88,"end":120.62,"words":[{"text":"Thus","start":113.88,"end":113.94},{"text":"calming","start":113.94,"end":114.38},{"text":"down","start":114.38,"end":114.76},{"text":"the","start":114.76,"end":114.92},{"text":"activity","start":114.92,"end":115.26},{"text":"within","start":115.26,"end":115.86},{"text":"which","start":115.86,"end":116.46},{"text":"comes","start":117.42,"end":117.78},{"text":"from","start":117.78,"end":118.04},{"text":"our","start":118.04,"end":118.18},{"text":"attention","start":118.18,"end":118.58},{"text":"on","start":118.58,"end":118.96},{"text":"the","start":118.96,"end":119.12},{"text":"past","start":119.12,"end":119.42},{"text":"or","start":119.42,"end":119.64},{"text":"the","start":119.64,"end":119.74},{"text":"future.","start":119.74,"end":120.62}]},{"text":"Keep your left hand open on your lap and place your right hand either on the ground or towards the ground if you are seated on a chair.","start":123.18,"end":131.02,"words":[{"text":"Keep","start":123.18,"end":123.36},{"text":"your","start":123.36,"end":123.6},{"text":"left","start":123.6,"end":123.8},{"text":"hand","start":123.8,"end":124.14},{"text":"open","start":124.14,"end":124.52},{"text":"on","start":124.52,"end":124.76},{"text":"your","start":124.76,"end":124.88},{"text":"lap","start":124.88,"end":125.2},{"text":"and","start":125.2,"end":125.58},{"text":"place","start":125.92,"end":126.12},{"text":"your","start":126.12,"end":126.36},{"text":"right","start":126.36,"end":126.62},{"text":"hand","start":126.62,"end":127.12},{"text":"either","start":127.12,"end":127.6},{"text":"on","start":127.6,"end":127.9},{"text":"the","start":127.9,"end":128.02},{"text":"ground","start":128.02,"end":128.32},{"text":"or","start":128.32,"end":128.58},{"text":"towards","start":128.58,"end":128.88},{"text":"the","start":128.88,"end":129.1},{"text":"ground","start":129.1,"end":129.34},{"text":"if","start":129.34,"end":129.56},{"text":"you","start":129.56,"end":129.74},{"text":"are","start":129.74,"end":129.84},{"text":"seated","start":129.84,"end":130.08},{"text":"on","start":130.08,"end":130.34},{"text":"a","start":130.34,"end":130.44},{"text":"chair.","start":130.44,"end":131.02}]},{"text":"Bring your attention to the left side of your body.","start":135.04,"end":137.84,"words":[{"text":"Bring","start":135.04,"end":135.18},{"text":"your","start":135.18,"end":135.4},{"text":"attention","start":135.4,"end":135.8},{"text":"to","start":135.8,"end":136.16},{"text":"the","start":136.16,"end":136.28},{"text":"left","start":136.28,"end":136.46},{"text":"side","start":136.46,"end":136.8},{"text":"of","start":136.8,"end":137},{"text":"your","start":137,"end":137.12},{"text":"body.","start":137.12,"end":137.84}]},{"text":"The activity on the left side of our body governs our connection to our past.","start":141.18,"end":147.94,"words":[{"text":"The","start":141.18,"end":141.36},{"text":"activity","start":141.36,"end":141.7},{"text":"on","start":141.7,"end":142.1},{"text":"the","start":142.1,"end":142.18},{"text":"left","start":142.18,"end":142.46},{"text":"side","start":142.46,"end":142.98},{"text":"of","start":142.98,"end":143.3},{"text":"our","start":143.3,"end":143.5},{"text":"body","start":143.5,"end":143.86},{"text":"governs","start":143.86,"end":144.82},{"text":"our","start":146.3,"end":146.42},{"text":"connection","start":146.42,"end":146.76},{"text":"to","start":146.76,"end":147.18},{"text":"our","start":147.18,"end":147.32},{"text":"past.","start":147.32,"end":147.94}]},{"text":"When our attention is on the past it is not in the present.","start":153.2,"end":156.18,"words":[{"text":"When","start":153.2,"end":153.4},{"text":"our","start":153.4,"end":153.54},{"text":"attention","start":153.54,"end":153.86},{"text":"is","start":153.86,"end":154.16},{"text":"on","start":154.16,"end":154.24},{"text":"the","start":154.24,"end":154.42},{"text":"past","start":154.42,"end":154.72},{"text":"it","start":154.72,"end":154.9},{"text":"is","start":154.9,"end":155.16},{"text":"not","start":155.16,"end":155.32},{"text":"in","start":155.32,"end":155.5},{"text":"the","start":155.5,"end":155.62},{"text":"present.","start":155.62,"end":156.18}]},{"text":"Especially if it is on any negative occurrences in the past.","start":157.12,"end":161.46,"words":[{"text":"Especially","start":157.12,"end":157.9},{"text":"if","start":157.9,"end":158.22},{"text":"it","start":158.22,"end":158.42},{"text":"is","start":158.42,"end":158.58},{"text":"on","start":158.58,"end":158.88},{"text":"any","start":158.88,"end":159.16},{"text":"negative","start":159.16,"end":159.66},{"text":"occurrences","start":159.66,"end":160.4},{"text":"in","start":160.4,"end":160.66},{"text":"the","start":160.66,"end":160.7},{"text":"past.","start":160.7,"end":161.46}]},{"text":"With our attention on the left side of our body, we can ask within,","start":163.76,"end":167.2,"words":[{"text":"With","start":163.76,"end":163.94},{"text":"our","start":163.94,"end":164.02},{"text":"attention","start":164.02,"end":164.4},{"text":"on","start":164.4,"end":164.64},{"text":"the","start":164.64,"end":164.72},{"text":"left","start":164.72,"end":164.92},{"text":"side","start":164.92,"end":165.18},{"text":"of","start":165.18,"end":165.36},{"text":"our","start":165.36,"end":165.42},{"text":"body,","start":165.42,"end":166.04},{"text":"we","start":166.04,"end":166.04},{"text":"can","start":166.04,"end":166.28},{"text":"ask","start":166.28,"end":166.54},{"text":"within,","start":166.54,"end":167.2}]},{"text":"Mother Kundalini, please bring my attention away from the past.","start":167.92,"end":173.34,"words":[{"text":"Mother","start":167.92,"end":168.28},{"text":"Kundalini,","start":168.28,"end":169.36},{"text":"please","start":170.24,"end":170.64},{"text":"bring","start":170.64,"end":171.04},{"text":"my","start":171.04,"end":171.34},{"text":"attention","start":171.34,"end":171.7},{"text":"away","start":171.7,"end":172.08},{"text":"from","start":172.08,"end":172.42},{"text":"the","start":172.42,"end":172.62},{"text":"past.","start":172.62,"end":173.34}]},{"text":"Mother Kundalini, please cleanse me of any heavy or negative emotions","start":175.22,"end":180.46,"words":[{"text":"Mother","start":175.22,"end":175.5},{"text":"Kundalini,","start":175.5,"end":176.58},{"text":"please","start":177.18,"end":177.42},{"text":"cleanse","start":177.42,"end":177.82},{"text":"me","start":177.82,"end":178.2},{"text":"of","start":178.2,"end":178.46},{"text":"any","start":178.46,"end":178.66},{"text":"heavy","start":178.66,"end":179},{"text":"or","start":179,"end":179.48},{"text":"negative","start":179.48,"end":179.74},{"text":"emotions","start":179.74,"end":180.46}]},{"text":"which keep my attention lingering in the past.","start":181.66,"end":184.34,"words":[{"text":"which","start":181.66,"end":181.9},{"text":"keep","start":181.9,"end":182.14},{"text":"my","start":182.14,"end":182.4},{"text":"attention","start":182.4,"end":182.82},{"text":"lingering","start":182.82,"end":183.16},{"text":"in","start":183.16,"end":183.5},{"text":"the","start":183.5,"end":183.6},{"text":"past.","start":183.6,"end":184.34}]},{"text":"Please remove any guilt or sadness that I have within.","start":189.02,"end":193.4,"words":[{"text":"Please","start":189.02,"end":189.34},{"text":"remove","start":189.34,"end":189.92},{"text":"any","start":189.92,"end":190.32},{"text":"guilt","start":190.32,"end":190.8},{"text":"or","start":190.8,"end":191.5},{"text":"sadness","start":191.5,"end":191.9},{"text":"that","start":191.9,"end":192.32},{"text":"I","start":192.32,"end":192.44},{"text":"have","start":192.44,"end":192.6},{"text":"within.","start":192.6,"end":193.4}]},{"text":"You can affirm within, I am not my past.","start":199.58,"end":203.12,"words":[{"text":"You","start":199.58,"end":199.76},{"text":"can","start":199.76,"end":199.9},{"text":"affirm","start":199.9,"end":200.26},{"text":"within,","start":200.26,"end":201.02},{"text":"I","start":201.58,"