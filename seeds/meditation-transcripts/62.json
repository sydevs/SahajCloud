 present.","start":459.84,"end":462.42,"words":[{"text":"so","start":459.84,"end":460.18},{"text":"that","start":460.18,"end":460.36},{"text":"we","start":460.36,"end":460.5},{"text":"can","start":460.5,"end":460.74},{"text":"be","start":460.74,"end":461.16},{"text":"in","start":461.16,"end":461.44},{"text":"the","start":461.44,"end":461.56},{"text":"present.","start":461.56,"end":462.42}]},{"text":"Mother Kundalini,","start":465.84,"end":467,"words":[{"text":"Mother","start":465.84,"end":466.12},{"text":"Kundalini,","start":466.12,"end":467}]},{"text":"Please forgive any mistakes that I have made knowingly or unknowingly.","start":469.02,"end":474.92,"words":[{"text":"Please","start":469.02,"end":469.62},{"text":"forgive","start":469.62,"end":470.2},{"text":"any","start":470.2,"end":470.6},{"text":"mistakes","start":470.6,"end":471.12},{"text":"that","start":471.12,"end":471.88},{"text":"I","start":472.18,"end":472.42},{"text":"have","start":472.42,"end":472.6},{"text":"made","start":472.6,"end":472.86},{"text":"knowingly","start":472.86,"end":473.5},{"text":"or","start":473.5,"end":473.78},{"text":"unknowingly.","start":473.78,"end":474.92}]},{"text":"Finally, we can place the palm of the right hand on the top of the head on the fontanelle area,","start":498,"end":505.28,"words":[{"text":"Finally,","start":498,"end":499.14},{"text":"we","start":499.14,"end":499.24},{"text":"can","start":499.24,"end":499.4},{"text":"place","start":499.4,"end":499.7},{"text":"the","start":499.7,"end":499.96},{"text":"palm","start":499.96,"end":500.12},{"text":"of","start":500.12,"end":500.36},{"text":"the","start":500.36,"end":500.48},{"text":"right","start":500.48,"end":500.7},{"text":"hand","start":500.7,"end":501.18},{"text":"on","start":501.18,"end":501.5},{"text":"the","start":501.5,"end":501.6},{"text":"top","start":501.6,"end":501.8},{"text":"of","start":501.8,"end":502.04},{"text":"the","start":502.04,"end":502.2},{"text":"head","start":502.2,"end":502.48},{"text":"on","star