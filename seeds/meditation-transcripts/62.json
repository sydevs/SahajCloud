9.04},{"text":"I","start":349.54,"end":349.8},{"text":"am","start":349.8,"end":350.04},{"text":"the","start":350.04,"end":350.2},{"text":"pure","start":350.2,"end":350.48},{"text":"spirit,","start":350.48,"end":351.54},{"text":"not","start":352.36,"end":352.6},{"text":"my","start":352.6,"end":352.88},{"text":"mistakes.","start":352.88,"end":353.82}]},{"text":"Therefore I am not guilty.","start":355.76,"end":357.84,"words":[{"text":"Therefore","start":355.76,"end":356.14},{"text":"I","start":356.14,"end":356.56},{"text":"am","start":356.56,"end":356.76},{"text":"not","start":356.76,"end":357.08},{"text":"guilty.","start":357.08,"end":357.84}]},{"text":"Now we can place the right hand across the forehead","start":372.2,"end":374.72,"words":[{"text":"Now","start":372.2,"end":372.46},{"text":"we","start":372.46,"end":372.56},{"text":"can","start":372.56,"end":372.7},{"text":"place","start":372.7,"end":373.04},{"text":"the","start":373.04,"end":373.34},{"text":"right","start":373.34,"end":373.48},{"text":"hand","start":373.48,"end":373.74},{"text":"across","start":373.74,"end":374.08},{"text":"the","start":374.08,"end":374.28},{"text":"forehead","start":374.28,"end":374.72}]},{"text":"and tilt the head forward slightly so that it rests in the hand.","start":375.72,"end":379.66,"words":[{"text":"and","start":375.72,"end":376},{"text":"tilt","start":376,"end":376.22},{"text":"the","start":376.22,"end":376.46},{"text":"head","start":376.46,"end":376.64},{"text":"forward","start":376.64,"end":376.94},{"text":"slightly","start":376.94,"end":377.52},{"text":"so","start":377.52,"end":378.1},{"text":"that","start":378.1,"end":378.26},{"text":"it","start":378.26,"end":378.42},{"text":"rests","start":378.42,"end":378.76},{"text":"in","start":378.76,"end":379.06},{"text":"the","start":379.06,"end":379.16},{"text":"hand.","start":379.16,"end":379.66}]},{"text":"To rid ourselves of thoughts of the future and of the past.","start":388.02,"end":391.94,"words":[{"text":"To","start":388.02,"end":388.22},{"text":"rid","start":388.22,"end":388.36},{"text":"ourselves","start":388.36,"end":388.9},{"text":"of","start":388.9,"end":389.38},{"text":"thoughts","start":389.38,"end":389.66},{"text":"of","start":389.66,"end":389.98},{"text":"the","start":389.98,"end":390.1},{"text":"future","start":390.1,"end":390.56},{"text":"and","start":390.56,"end":391.14},{"text":"of","start":391.14,"end":391.3},{"text":"the","start":391.3,"end":391.52},{"text":"past.","start":391.52,"end":391.94}]},{"text":"Here we can affirm","start":394.26,"end":395.24,"words":[{"text":"Here","start":394.26,"end":394.6},{"text":"we","start":394.6,"end":394.7},{"text":"can","start":394.7,"end":394.88},{"text":"affirm","start":394.88,"end":395.24}]},{"text":"Mother Kundalini, I forgive everyone and I forgive myself.","start":397.02,"end":402.24,"words":[{"text":"Mother","start":397.02,"end":397.02},{"text":"Kundalini,","start":397.02,"end":398.24},{"text":"I","start":398.94,"end":399.08},{"text":"forgive","start":399.08,"end":399.4},{"text":"everyone","start":399.4,"end":400.04},{"text":"and","start":400.04,"end":400.72},{"text":"I","start":400.72,"end":400.9},{"text":"forgive","start":400.9,"end":401.3},{"text":"myself.","start":401.3,"end":402.24}]},{"text":"We can repeat this several times inside.","start":410.16,"end":412.74,"words":[{"text":"We","start":410.16,"end":410.22},{"text":"can","start":410.22,"end":410.38},{"text":"repeat","start":410.38,"end":410.66},{"text":"this","start":410.66,"end":410.96},{"text":"several","start":410.96,"end":411.26},{"text":"times","start":411.26,"end":411.7},{"text":"inside.","start":411.7,"end":412.74}]},{"text":"I forgive, I forgive.","start":414.94,"end":420.92,"words":[{"text":"I","start":414.94,"end":415.08},{"text":"forgive,","start":415.08,"end":416.1},{"text":"I","start":419.98,"end":420.14},{"text":"forgive.","start":420.14,"end":420.92}]},{"text":"Now we can place the right hand across the back of the head","start":439.58,"end":442.92,"w