t":434.4,"end":434.94},{"text":"within.","start":434.94,"end":435.88}]},{"text":"We can affirm, Mother Kundalini, I am not guilty.","start":436.5,"end":442.06,"words":[{"text":"We","start":436.5,"end":436.6},{"text":"can","start":436.6,"end":436.8},{"text":"affirm,","start":436.8,"end":437.26},{"text":"Mother","start":437.26,"end":438.14},{"text":"Kundalini,","start":438.76,"end":439.88},{"text":"I","start":440.34,"end":440.6},{"text":"am","start":440.6,"end":440.8},{"text":"not","start":440.8,"end":441.18},{"text":"guilty.","start":441.18,"end":442.06}]},{"text":"Please remove all negative thoughts and emotions which would have me feel that I am guilty.","start":445.56,"end":452.32,"words":[{"text":"Please","start":445.56,"end":445.86},{"text":"remove","start":445.86,"end":446.36},{"text":"all","start":446.36,"end":446.78},{"text":"negative","start":446.78,"end":447.12},{"text":"thoughts","start":447.12,"end":447.64},{"text":"and","start":447.64,"end":447.94},{"text":"emotions","start":447.94,"end":448.48},{"text":"which","start":448.48,"end":449.14},{"text":"would","start":449.92,"end":450.2},{"text":"have","start":450.2,"end":450.4},{"text":"me","start":450.4,"end":450.58},{"text":"feel","start":450.58,"end":450.84},{"text":"that","start":450.84,"end":451.2},{"text":"I","start":451.2,"end":451.26},{"text":"am","start":451.26,"end":451.42},{"text":"guilty.","start":451.42,"end":452.32}]},{"text":"All mistakes that I have made are in the past.","start":467.6,"end":470.16,"words":[{"text":"All","start":467.6,"end":467.78},{"text":"mistakes","start":467.78,"end":468.18},{"text":"that","start":468.18,"end":468.52},{"text":"I","start":468.52,"end":468.62},{"text":"have","start":468.62,"end":468.72},{"text":"made","start":468.72,"end":469.02},{"text":"are","start":469.02,"end":469.26},{"text":"in","start":469.26,"end":469.4},{"text":"the","start":469.4,"end":469.56},{"text":"past.","start":469.56,"end":470.16}]},{"text":"But in the present, in this moment, I am not thes