for","start":162.78,"end":163.26},{"text":"food,","start":163.26,"end":164.12}]},{"text":"then for shelter and our family's welfare. Once these things are fulfilled,","start":164.82,"end":171.8,"words":[{"text":"then","start":164.82,"end":165.12},{"text":"for","start":165.12,"end":165.52},{"text":"shelter","start":165.52,"end":165.9},{"text":"and","start":165.9,"end":166.64},{"text":"our","start":167.04,"end":167.16},{"text":"family's","start":167.16,"end":167.76},{"text":"welfare.","start":167.76,"end":168.68},{"text":"Once","start":170.42,"end":170.54},{"text":"these","start":170.54,"end":170.84},{"text":"things","start":170.84,"end":171.1},{"text":"are","start":171.1,"end":171.32},{"text":"fulfilled,","start":171.32,"end":171.8}]},{"text":"We hunger for something more in order to feel fulfilled.","start":173.24,"end":176.88,"words":[{"text":"We","start":173.24,"end":173.42},{"text":"hunger","start":173.42,"end":173.8},{"text":"for","start":173.8,"end":174.06},{"text":"something","start":174.06,"end":174.4},{"text":"more","start":174.4,"end":175},{"text":"in","start":175,"end":175.28},{"text":"order","start":175.28,"end":175.48},{"text":"to","start":175.48,"end":175.68},{"text":"feel","start":175.68,"end":175.88},{"text":"fulfilled.","start":175.88,"end":176.88}]},{"text":"We can ask within,","start":181.12,"end":182.52,"words":[{"text":"We","start":181.12,"end":181.16},{"text":"can","start":181.16,"end":181.38},{"text":"ask","start":181.38,"end":181.7},{"text":"within,","start":181.7,"end":182.52}]},{"text":"Mother Kundalini, please help me to feel completely satisfied within.","start":183.1,"end":189.3,"words":[{"text":"Mother","start":183.1,"end":183.52},{"text":"Kundalini,","start":183.52,"end":184.42},{"text":"please","start":185.56,"end":185.96},{"text":"help","start":185.96,"end":186.28},{"text":"me","start":186.28,"end":186.5},{"text":"to","start":186.5,"end":186.68},{"text":"feel","start":186.68,"end":186.98},{"text":"completely","start":186.98,"end":187.