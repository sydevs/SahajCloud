ever changes.","start":307.24,"end":312.24,"words":[{"text":"That","start":307.24,"end":307.6},{"text":"part","start":307.6,"end":307.96},{"text":"which","start":307.96,"end":308.26},{"text":"is","start":308.26,"end":308.38},{"text":"eternal,","start":308.38,"end":309.4},{"text":"which","start":310.78,"end":310.86},{"text":"never","start":310.86,"end":311.18},{"text":"changes.","start":311.18,"end":312.24}]},{"text":"When we are connected to our spirit, we do not need anything else in order to feel good within.","start":316.04,"end":324.68,"words":[{"text":"When","start":316.04,"end":316.16},{"text":"we","start":316.16,"end":316.28},{"text":"are","start":316.28,"end":316.44},{"text":"connected","start":316.44,"end":316.82},{"text":"to","start":316.82,"end":317.2},{"text":"our","start":317.2,"end":317.36},{"text":"spirit,","start":317.36,"end":318.24},{"text":"we","start":318.94,"end":318.98},{"text":"do","start":318.98,"end":319.12},{"text":"not","start":319.12,"end":319.32},{"text":"need","start":319.32,"end":319.66},{"text":"anything","start":319.66,"end":320.08},{"text":"else","start":320.08,"end":320.7},{"text":"in","start":320.7,"end":321.16},{"text":"order","start":321.8,"end":322.36},{"text":"to","start":322.36,"end":322.82},{"text":"feel","start":323.12,"end":323.4},{"text":"good","start":323.4,"end":323.74},{"text":"within.","start":323.74,"end":324.68}]},{"text":"Therefore we can ask, Mother Kundalini, please clean my heart.","start":328.84,"end":335.04,"words":[{"text":"Therefore","start":328.84,"end":329.18},{"text":"we","start":329.18,"end":329.38},{"text":"can","start":329.38,"end":329.6},{"text":"ask,","start":329.6,"end":330.22},{"text":"Mother","start":330.8,"end":331.22},{"text":"Kundalini,","start":331.22,"end":332.28},{"text":"please","start":333.22,"end":333.52},{"text":"clean","start":333.52,"end":333.96},{"text":"my","start":333.96,"end":334.3},{"text":"heart.","start":334.3,"end":335.04}]},{"text":"Please cleanse it and soothe it and remove anything that hides the beauty of my true nature.","start":336.52,"end":344.94,"words":[{"text":"Please","start":336.52,"end":336.68},{"text":"cleanse","start":336.68,"end":337.16},{"text":"it","start":337.16,"end":337.9},{"text":"and","start":337.9,"end":338.16},{"text":"soothe","start":338.16,"end":338.56},{"text":"it","start":338.56,"end":338.98},{"text":"and","start":340,"end":340.36},{"text":"remove","start":340.36,"end":340.7},{"text":"anything","start":340.7,"end":341.34},{"text":"that","start":341.34,"end":342.16},{"text":"hides","start":342.56,"end":342.94},{"text":"the","start":342.94,"end":343.4},{"text":"beauty","start":343.4,"end":343.66},{"text":"of","start":343.66,"end":343.96},{"text":"my","start":343.96,"end":344.12},{"text":"true","start":344.12,"end":344.36},{"text":"nature.","start":344.36,"end":344.94}]},{"text":"Mother Kundalini, I am the pure spirit.","start":354.46,"end":357.56,"words":[{"text":"Mother","start":354.46,"end":354.84},{"text":"Kundalini,","start":354.84,"end":355.86},{"text":"I","start":355.86,"end":355.86},{"text":"am","start":355.86,"end":356.44},{"text":"the","start":356.44,"end":356.62},{"text":"pure","start":356.62,"end":356.96},{"text":"spirit.","start":356.96,"end":357.56}]},{"text":"We can affirm this silently within several times.","start":360.52,"end":363.64,"words":[{"text":"We","start":360.52,"end":360.64},{"text":"can","start":360.64,"end":360.82},{"text":"affirm","start":360.82,"end":361.18},{"text":"this","start":361.18,"end":361.54},{"text":"silently","start":361.54,"end":361.9},{"text":"within","start":361.9,"end":362.42},{"text":"several","start":362.42,"end":362.9},{"text":"times.","start":362.9,"end":363.64}]},{"text":"I am the pure spirit. I do not need anything else to fulfill me.","start":365.8,"end":375.7,"words":[{"text":"I","start":365.8,"end":366.28},{"text":"am","start":366.28,"end":366.84},{"text":"the","start":366.84,"end":367.1},{"text":"pure","start":367.1,"end":367.4},{"text":"spirit.","start":367