,{"text":"myself.","start":518.26,"end":519.14}]},{"text":"And here we try not to think of any particular episode.","start":525.26,"end":529.04,"words":[{"text":"And","start":525.26,"end":525.38},{"text":"here","start":525.38,"end":525.4},{"text":"we","start":525.4,"end":525.56},{"text":"try","start":525.56,"end":525.78},{"text":"not","start":525.78,"end":526},{"text":"to","start":526,"end":526.18},{"text":"think","start":526.18,"end":526.4},{"text":"of","start":526.4,"end":526.6},{"text":"any","start":526.6,"end":527.12},{"text":"particular","start":527.12,"end":528},{"text":"episode.","start":528,"end":529.04}]},{"text":"We just have faith in our words.","start":530.8,"end":533.04,"words":[{"text":"We","start":530.8,"end":530.88},{"text":"just","start":530.88,"end":531.18},{"text":"have","start":531.18,"end":531.54},{"text":"faith","start":531.54,"end":532},{"text":"in","start":532,"end":532.22},{"text":"our","start":532.22,"end":532.46},{"text":"words.","start":532.46,"end":533.04}]},{"text":"Mother Kundalini, I forgive.","start":535.64,"end":538.72,"words":[{"text":"Mother","start":535.64,"end":535.96},{"text":"Kundalini,","start":535.96,"end":537.24},{"text":"I","start":537.74,"end":537.98},{"text":"forgive.","start":537.98,"end":538.72}]},{"text":"I forgive everyone and everything and I also forgive myself.","start":543.02,"end":550.54,"words":[{"text":"I","start":543.02,"end":543.3},{"text":"forgive","start":543.3,"end":543.76},{"text":"everyone","start":543.76,"end":544.54},{"text":"and","start":544.54,"end":545.24},{"text":"everything","start":545.58,"end":546.3},{"text":"and","start":546.3,"end":547.1},{"text":"I","start":548.58,"end":548.84},{"text":"also","start":548.84,"end":549.24},{"text":"forgive","start":549.24,"end":549.86},{"text":"myself.","start":549.86,"end":550.54}]},{"text":"And now we put our right hand on the top of our head, on the Sahasrara,","start":558.66,"end":563.78,"words":[{"text":"And","start":558.66,"end":558.9},{"text":"now","start":558.9,"end":559.1},{"text":"we","start":559.1,"end":559.24},{"text":"put","start":559.24,"end":559.52},{"text":"our","start":559.52,"end":559.72},{"text":"right","start":559.72,"end":559.94},{"text":"hand","start":559.94,"end":560.42},{"text":"on","start":560.42,"end":560.84},{"text":"the","start":561.2,"end":561.32},{"text":"top","start":561.32,"end":561.48},{"text":"of","start":561.48,"end":561.68},{"text":"our","start":561.68,"end":561.9},{"text":"head,","start":561.9,"end":562.78},{"text":"on","start":562.78,"end":562.82},{"text":"the","start":562.82,"end":563},{"text":"Sahasrara,","start":563,"end":563.78}]},{"text":"And we can give a gentle clockwise rotation of our scalp.","start":566.66,"end":571.62,"words":[{"text":"And","start":566.66,"end":566.84},{"text":"we","start":566.84,"end":566.86},{"text":"can","start":566.86,"end":567.02},{"text":"give","start":567.02,"end":567.24},{"text":"a","start":567.24,"end":567.4},{"text":"gentle","start":567.4,"end":567.78},{"text":"clockwise","start":567.78,"end":568.5},{"text":"rotation","start":568.5,"end":569.7},{"text":"of","start":569.7,"end":570.36},{"text":"our","start":570.66,"end":570.94},{"text":"scalp.","start":570.94,"end":571.62}]},{"text":"Mother Kundalini, please awaken yourself within me.","start":574.88,"end":579.04,"words":[{"text":"Mother","start":574.88,"end":575.18},{"text":"Kundalini,","start":575.18,"end":575.78},{"text":"please","start":575.78,"end":576.22},{"text":"awaken","start":576.22,"end":577.26},{"text":"yourself","start":577.54,"end":578.2},{"text":"within","start":578.2,"end":578.5},{"text":"me.","start":578.5,"end":579.04}]},{"text":"Mother Kundalini, allow me to feel your presence within me.","start":582.08,"end":586.6,"words":[{"text":"Mother","start":582.08,"end":582.34},{"text":"Kundalini,","start":582.34,"end":583.32},{"text":"allow","start":583.64,"end":584.1},{"text":"me","start":584.1,"end":584.4},{"text":"to","start":584.4,"end":584.68},{"text":"feel","start":584.68,"end":584.9},{"text":"your","start":584.9,"end":585.24},{"text":"presence","start":585.24,"end":585.7},{"text":"within","start":585.7,"end":586.12},{"text":"me.","start":586.12,"end":586.6}]},{"text":"And we can slowly bring our hand back on our lap.","start":592.36,"end":595.94,"words":[{"text":"And","start":592.36,"end":592.6},{"text":"we","start":592.6,"end":592.6},{"text":"can","start":592.6,"end":592.8},{"text":"slowly","start":592.8,"end":593.04},{"text":"bring","start":593.04,"end":593.34},{"text":"our","start":593.34,"end":593.64},{"text":"hand","start":593.64,"end":593.96},{"text":"back","start":593.96,"end":594.62},{"text":"on","start":594.98,"end":595.14},{"text":"our","start":595.14,"end":595.34},{"text":"lap.","start":595.34,"end":595.94}]},{"text":"Eyes are closed, both hands open on our lap, and we try to sit in silent meditation.","start":597.48,"end":617.26,"words":[{"text":"Eyes","start":597.48,"end":597.84},{"text":"are","start":597.84,"end":598.32},{"text":"closed,","start":598.32,"end":599.44},{"text":"both","start":600.52,"end":600.68},{"text":"hands","start":600.68,"end":601.12},{"text":"open","start":601.12,"end":601.62},{"text":"on","start":601.62,"end":601.84},{"text":"our","start":601.84,"end":602},{"text":"lap,","start":602,"end":602.66},{"text":"and","start":613.92,"end":614.12},{"text":"we","start":614.12,"end":614.16},{"text":"try","start":614.16,"end":614.36},{"text":"to","start":614.36,"end":614.68},{"text":"sit","start":614.68,"end":614.98},{"text":"in","start":614.98,"end":615.8},{"text":"silent","start":615.8,"end":616.14},{"text":"meditation.","start":616.14,"end":617.26}]},{"text":"We try not to fight our thoughts. It's just like a river","start":622.92,"end":629.9,"words":[{"text":"We","start":622.92,"end":623.16},{"text":"try","start":623.16,"end":623.32},{"text":"not","start":623.32,"end":623.5},{"text":"to","start":623.5,"end":623.78},{"text":"fight","start":623.78,"end":624.02},{"text":"our","start":624.02,"end":624.36},{"text":"thoughts.","start":624.36,"end":625.16},{"text":"It's","start":628.72,"end":629.14},{"text":"just","start":629.14,"end":629.34},{"text":"like","start":629.34,"end":629.52},{"text":"a","start":629.52,"end":629.7},{"text":"river","start":629.7,"end":629.9}]},{"text":"And the water that flows, we don't follow them, but we just let them go.","start":630.9,"end":637.58,"words":[{"text":"And","start":630.9,"end":631.24},{"text":"the","start":631.24,"end":631.44},{"text":"water","start":631.44,"end":631.6},{"text":"that","start":631.6,"end":631.82},{"text":"flows,","start":631.82,"end":632.86},{"text":"we","start":635,"end":635.02},{"text":"don't","start":635.02,"end":635.3},{"text":"follow","start":635.3,"end":635.58},{"text":"them,","start":635.58,"end":635.94},{"text":"but","start":635.94,"end":636.12},{"text":"we","start":636.12,"end":636.18},{"text":"just","start":636.18,"end":636.4},{"text":"let","start":636.4,"end":636.62},{"text":"them","start":636.62,"end":636.84},{"text":"go.","start":636.84,"end":637.58}]},{"text":"And if we're having trouble, we can also just say inside of us, I forgive.","start":641.32,"end":645.96,"words":[{"text":"And","start":641.32,"end":641.42},{"text":"if","start":641.42,"end":641.5},{"text":"we're","start":641.5,"end":641.8},{"text":"having","start":641.8,"end":641.8},{"text":"trouble,","start":641.8,"end":642.3},{"text":"we","start":642.3,"end":642.32},{"text":"can","start":642.32,"end":642.52},{"text":"also","start":642.52,"end":642.72},{"text":"just","start":642.72,"end":643.22},{"text":"say","start":643.76,"end":644.22},{"text":"inside","start":644.22,"end":644.44},{"text":"of","start":644.44,"end":644.7},{"text":"us,","start":644.7,"end":644.94},{"text":"I","start":644.94,"end":645.08},{"text":"forgive.","start":645.08,"end":645.96}]},{"text":"And today we can try to really keep this state.","start":699.94,"end":704.68,"words":[{"text":"And","start":699.94,"end":700.1},{"text":"today","start":700.1,"end":700.4},{"text":"we","start":700.4,"end":700.6},{"text":"can","start":700.6,"end":701.12},{"text":"try","start":701.88,"end":702.34},{"text":"to","start":702.34,"end":702.6},{"text":"really","start":702.6,"end":702.88},{"text":"keep","start":702.88,"end":703.32},{"text":"this","start":703.32,"end":704.06},{"text":"state.","start":704.06,"end":704.68}]},{"text":"We make sure that we open our hearts to everything.","start":705.7,"end":711.18,"words":[{"text":"We","start":705.7,"end":705.86},{"text":"make","start":705.86,"end":706.1},{"text":"sure","start":706.1,"end":706.38},{"text":"that","start":706.38,"end":707.02},{"text":"we","start":708.04,"end":708.48},{"text":"open","start":708.48,"end":709.24},{"text":"our","start":709.72,"end":710.02},{"text":"hearts","start":710.02,"end":710.26},{"text":"to","start":710.26,"end":710.5},{"text":"everything.","start":710.5,"end":711.18}]},{"text":"We make sure that we try to be as peaceful as we can inside.","start":713.56,"end":717.04,"words":[{"text":"We","start":713.56,"end":713.88},{"text":"make","start":713.88,"end":713.88},{"text":"sure","start":713.88,"end":714.1},{"text":"that","start":714.1,"end":714.34},{"text":"we","start":714.34,"end":714.56},{"text":"try","start":714.56,"end":714.82},{"text":"to","start":714.82,"end":715},{"text":"be","start":715,"end":715.02},{"text":"as","start":715.02,"end":715.22},{"text":"peaceful","start":715.22,"end":715.54},{"text":"as","start":715.54,"end":715.82},{"text":"we","start":715.82,"end":716},{"text":"can","start":716,"end":716.34},{"text":"inside.","start":716.34,"end":717.04}]},{"text":"And with this, we can conclude our meditation.","start":726.14,"end":729.32,"words":[{"text":"And","start":726.14,"end":726.46},{"text":"with","start":726.46,"end":726.54},{"text":"this,","start":726.54,"end":727.82},{"text":"we","start":727.82,"end":727.82},{"text":"can","start":727.82,"end":727.82},{"text":"conclude","start":727.82,"end":728.26},{"text":"our","start":728.26,"end":728.48},{"text":"meditation.","start":728.48,"end":729.32}]},{"text":"And to do so, we can raise our Kundalini three times.","start":752.32,"end":758.48,"words":[{"text":"And","start":752.32,"end":752.76},{"text":"to","start":752.76,"end":752.88},{"text":"do","start":752.88,"end":753.08},{"text":"so,","start":753.08,"end":753.52},{"text":"we","start":753.52,"end":753.52},{"text":"can","start":753.52,"end":753.8},{"text":"raise","start":753.8,"end":754.4},{"text":"our","start":754.92,"end":755.2},{"text":"Kundalini","start":755.2,"end":755.72},{"text":"three","start":755.72,"end":756.36},{"text":"times.","start":757.5,"end":758.48}]},{"text":"We bring our hands above our head and we tie one knot.","start":762.8,"end":768.74,"words":[{"text":"We","start":762.8,"end":762.86},{"text":"bring","start":762.86,"end":763.04},{"text":"our","start":763.04,"end":763.28},{"text":"hands","start":763.28,"end":763.72},{"text":"above","start":763.72,"end":764.12},{"text":"our","start":764.12,"end":764.46},{"text":"head","start":764.46,"end":764.86},{"text":"and","start":765.96,"end":766.34},{"text":"we","start":766.34,"end":766.54},{"text":"tie","start":766.54,"end":766.9},{"text":"one","start":766.9,"end":767.48},{"text":"knot.","start":767.8,"end":768.74}]},{"text":"We do this three times and on the second time we tie two knots and the last time we tie three knots.","start":771.02,"end":783.86,"words":[{"text":"We","start":771.02,"end":771.18},{"text":"do","start":771.18,"end":771.2},{"text":"this","start":771.2,"end":771.52},{"text":"three","start":771.52,"end":771.84},{"text":"times","start":771.84,"end":772.44},{"text":"and","start":772.44,"end":773},{"text":"on","start":773.76,"end":773.9},{"text":"the","start":773.9,"end":774.04},{"text":"second","start":774.04,"end":774.26},{"text":"time","start":774.26,"end":774.6},{"text":"we","start":774.6,"end":774.98},{"text":"tie","start":774.98,"end":775.16},{"text":"two","start":775.16,"end":775.44},{"text":"knots","start":775.44,"end":775.9},{"text":"and","start":775.9,"end":776.46},{"text":"the","start":780.72,"end":780.86},{"text":"last","start":780.86,"end":781.12},{"text":"time","start":781.12,"end":781.42},{"text":"we","start":781.42,"end":781.8},{"text":"tie","start":782.12,"end":782.56},{"text":"three","start":782.56,"end":782.92},{"text":"knots.","start":782.92,"end":783.86}]},{"text":"We can also give ourselves seven bandhan to protect ourselves and our chakras.","start":789.28,"end":796.26,"words":[{"text":"We","start":789.28,"end":789.34},{"text":"can","start":789.34,"end":789.5},{"text":"also","start":789.5,"end":789.66},{"text":"give","start":789.66,"end":789.8},{"text":"ourselves","start":789.8,"end":790.28},{"text":"seven","start":790.28,"end":790.84},{"text":"bandhan","start":790.84,"end":791.44},{"text":"to","start":791.44,"end":792.02},{"text":"protect","start":793.78,"end":794.2},{"text":"ourselves","start":794.2,"end":794.84},{"text":"and","start":794.84,"end":795.22},{"text":"our","start":795.22,"end":795.44},{"text":"chakras.","start":795.44,"end":796.26}]},{"text":"And we do this with complete desire and complete understanding.","start":804.92,"end":810.86,"words":[{"text":"And","start":804.92,"end":805.08},{"text":"we","start":805.08,"end":805.16},{"text":"do","start":805.16,"end":805.36},{"text":"this","start":805.36,"end":805.68},{"text":"with","start":805.68,"end":806.24},{"text":"complete","start":806.58,"end":807.12},{"text":"desire","start":807.12,"end":808.34},{"text":"and","start":808.34,"end":809.08},{"text":"complete","start":809.52,"end":809.9},{"text":"understanding.","start":809.9,"end":810.86}]},{"text":"And we can put our hands together and thank our Kundalini for always being with us.","start":816.14,"end":827.08,"words":[{"text":"And","start":816.14,"end":816.34},{"text":"we","start":816.34,"end":816.38},{"text":"can","start":816.38,"end":816.54},{"text":"put","start":816.54,"end":816.7},{"text":"our","start":816.7,"end":816.92},{"text":"hands","start":816.92,"end":817.2},{"text":"together","start":817.2,"end":817.62},{"text":"and","start":817.62,"end":818.3},{"text":"thank","start":818.6,"end":818.94},{"text":"our","start":818.94,"end":819.5},{"text":"Kundalini","start":819.5,"end":820.08},{"text":"for","start":820.08,"end":820.72},{"text":"always","start":826.08,"end":826.32},{"text":"being","start":826.32,"end":826.62},{"text":"with","start":826.62,"end":826.76},{"text":"us.","start":826.76,"end":827.08}]}]}
