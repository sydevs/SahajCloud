"end":53.28},{"text":"where","start":53.28,"end":53.74},{"text":"our","start":53.74,"end":54.04},{"text":"Nabhi","start":54.04,"end":54.36},{"text":"chakra","start":54.36,"end":54.74},{"text":"is","start":54.74,"end":55.14},{"text":"situated,","start":55.14,"end":56.2},{"text":"which","start":56.58,"end":56.76},{"text":"governs","start":56.76,"end":57.24},{"text":"our","start":57.24,"end":57.4},{"text":"sense","start":57.4,"end":57.74},{"text":"of","start":57.74,"end":58},{"text":"satisfaction","start":58,"end":58.56},{"text":"and","start":58.56,"end":59.34},{"text":"seeking.","start":59.34,"end":60.16}]},{"text":"To nourish this center we can ask,","start":63.34,"end":65.44,"words":[{"text":"To","start":63.34,"end":63.5},{"text":"nourish","start":63.5,"end":63.84},{"text":"this","start":63.84,"end":64.12},{"text":"center","start":64.12,"end":64.52},{"text":"we","start":64.52,"end":64.76},{"text":"can","start":64.76,"end":65},{"text":"ask,","start":65,"end":65.44}]},{"text":"Mother Kundalini, please allow me to feel completely satisfied within.","start":66.24,"end":72.6,"words":[{"text":"Mother","start":66.24,"end":66.62},{"text":"Kundalini,","start":66.62,"end":67.7},{"text":"please","start":68.58,"end":69.02},{"text":"allow","start":69.02,"end":69.58},{"text":"me","start":69.58,"end":69.88},{"text":"to","start":69.88,"end":70.06},{"text":"feel","start":70.06,"end":70.32},{"text":"completely","start":70.32,"end":70.88},{"text":"satisfied","start":70.88,"end":71.62},{"text":"within.","start":71.62,"end":72.6}]},{"text":"Please settle my seeking for material satisfaction and bring my attention to something higher.","start":76.64,"end":87.24,"words":[{"text":"Please","start":76.64,"end":76.98},{"text":"settle","start":76.98,"end":77.54},{"text":"my","start":77.54,"end":78.2},{"text":"seeking","start":78.2,"end":78.66},{"text":"for","start":78.66,"end":79.48},{"text":"material","start":80.38,"end":81.14},{"text":"satisfaction","start":81.14,"end":82.06},{"text":"and","