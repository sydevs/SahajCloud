t":113.7,"end":113.96},{"text":"body?","start":113.96,"end":114.8},{"text":"Or","start":117.72,"end":117.88},{"text":"am","start":117.88,"end":118.06},{"text":"I","start":118.06,"end":118.24},{"text":"something","start":118.24,"end":118.58},{"text":"more?","start":118.58,"end":119.26},{"text":"Am","start":122.84,"end":123.26},{"text":"I","start":123.26,"end":123.48},{"text":"a","start":123.48,"end":123.64},{"text":"part","start":123.64,"end":123.86},{"text":"of","start":123.86,"end":124.14},{"text":"something","start":124.14,"end":124.48},{"text":"greater?","start":124.48,"end":125.56}]},{"text":"Can I go beyond my mind, beyond my thoughts and my emotions?","start":131.78,"end":138.46,"words":[{"text":"Can","start":131.78,"end":131.96},{"text":"I","start":131.96,"end":132.2},{"text":"go","start":132.2,"end":132.58},{"text":"beyond","start":132.58,"end":133.02},{"text":"my","start":133.02,"end":133.34},{"text":"mind,","start":133.34,"end":134.24},{"text":"beyond","start":135.72,"end":135.98},{"text":"my","start":135.98,"end":136.34},{"text":"thoughts","start":136.34,"end":136.76},{"text":"and","start":136.76,"end":137.34},{"text":"my","start":137.34,"end":137.52},{"text":"emotions?","start":137.52,"end":138.46}]},{"text":"Now you take this right hand and place it across your left hip where the leg joins the body","start":157.28,"end":165.1,"words":[{"text":"Now","start":157.28,"end":157.56},{"text":"you","start":157.56,"end":157.72},{"text":"take","start":157.72,"end":157.9},{"text":"this","start":157.9,"end":158.24},{"text":"right","start":158.24,"end":158.46},{"text":"hand","start":158.46,"end":158.94},{"text":"and","start":158.94,"end":159.36},{"text":"place","start":159.9,"end":160.12},{"text":"it","start":160.12,"end":160.68},{"text":"across","start":161.3,"end":161.86},{"text":"your","start":161.86,"end":162.46},{"text":"left","start":162.46,"end":162.7},{"text":"hip","start":162.7,"end":163.26},{"text":"where","start":163.26,"end":163.82},{"text":"the","start"