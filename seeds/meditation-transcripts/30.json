28},{"text":"let","start":305.28,"end":305.44},{"text":"go","start":305.44,"end":305.58},{"text":"of","start":305.58,"end":305.7},{"text":"my","start":305.7,"end":305.8},{"text":"past.","start":305.8,"end":306.4}]},{"text":"We can place our hand on our forehead, bowing our head into our hand.","start":321.34,"end":328.28,"words":[{"text":"We","start":321.34,"end":321.52},{"text":"can","start":321.52,"end":321.66},{"text":"place","start":321.66,"end":321.84},{"text":"our","start":321.84,"end":322.06},{"text":"hand","start":322.06,"end":322.32},{"text":"on","start":322.32,"end":322.48},{"text":"our","start":322.48,"end":322.7},{"text":"forehead,","start":322.7,"end":323.42},{"text":"bowing","start":326.92,"end":327.3},{"text":"our","start":327.3,"end":327.42},{"text":"head","start":327.42,"end":327.6},{"text":"into","start":327.6,"end":327.78},{"text":"our","start":327.78,"end":327.98},{"text":"hand.","start":327.98,"end":328.28}]},{"text":"Mother Kundalini, please take away all my thoughts.","start":333.94,"end":336.72,"words":[{"text":"Mother","start":333.94,"end":333.98},{"text":"Kundalini,","start":333.98,"end":334.9},{"text":"please","start":334.9,"end":335.06},{"text":"take","start":335.06,"end":335.34},{"text":"away","start":335.34,"end":335.52},{"text":"all","start":335.52,"end":335.72},{"text":"my","start":335.72,"end":335.92},{"text":"thoughts.","start":335.92,"end":336.72}]},{"text":"Mother Kundalini, let my thoughts be of none other than the work that is at hand.","start":355.24,"end":362.58,"words":[{"text":"Mother","start":355.24,"end":355.44},{"text":"Kundalini,","start":355.44,"end":356.48},{"text":"let","start":356.96,"end":357.14},{"text":"my","start":357.14,"end":357.42},{"text":"thoughts","start":357.42,"end":357.84},{"text":"be","start":357.84,"end":358.62},{"text":"of","start":358.62,"end":359.12},{"text":"none","start":359.12,"end":359.36},{"text":"other","start":359.36,"end":359.82},{"text":"than","start":359.82,"end":360.44},{"text":"the","sta