":327.38},{"text":"for","start":327.38,"end":327.64},{"text":"everyone,","start":327.64,"end":328.52},{"text":"pure","start":330.42,"end":330.62},{"text":"love.","start":330.62,"end":331.3}]},{"text":"Then we can place our right hand back on our lap and put our left hand on the right side of our chest, the heart level.","start":352.62,"end":360.76,"words":[{"text":"Then","start":352.62,"end":352.76},{"text":"we","start":352.76,"end":352.9},{"text":"can","start":352.9,"end":353.04},{"text":"place","start":353.04,"end":353.32},{"text":"our","start":353.32,"end":353.6},{"text":"right","start":353.6,"end":353.76},{"text":"hand","start":353.76,"end":353.92},{"text":"back","start":353.92,"end":354.18},{"text":"on","start":354.18,"end":354.34},{"text":"our","start":354.34,"end":354.46},{"text":"lap","start":354.46,"end":354.68},{"text":"and","start":354.68,"end":354.92},{"text":"put","start":354.92,"end":355.1},{"text":"our","start":355.1,"end":355.36},{"text":"left","start":355.36,"end":355.6},{"text":"hand","start":355.6,"end":356.08},{"text":"on","start":356.08,"end":356.58},{"text":"the","start":356.94,"end":357.22},{"text":"right","start":357.22,"end":357.5},{"text":"side","start":357.5,"end":357.84},{"text":"of","start":357.84,"end":358.04},{"text":"our","start":358.04,"end":358.2},{"text":"chest,","start":358.2,"end":359.12},{"text":"the","start":359.76,"end":359.88},{"text":"heart","start":359.88,"end":360.16},{"text":"level.","start":360.16,"end":360.76}]},{"text":"Here we can say, Mother Kundalini, please awaken in me the force which protects me.","start":374.26,"end":379.64,"words":[{"text":"Here","start":374.26,"end":374.5},{"text":"we","start":374.5,"end":374.62},{"text":"can","start":374.62,"end":374.82},{"text":"say,","start":374.82,"end":375.16},{"text":"Mother","start":375.16,"end":375.32},{"text":"Kundalini,","start":375.32,"end":376},{"text":"please","start":376,"end":376.26},{"text":"awaken","start":376.26,"end":376.7},{"text":"in","start":376.7,"end":377.3},{"text":"me","start":377.3,"end":377.52},{"text":"the","start":377.52,"end":377.76},{"text":"force","start":377.76,"end":378.1},{"text":"which","start":378.1,"end":378.46},{"text":"protects","start":378.46,"end":378.88},{"text":"me.","start":378.88,"end":379.64}]},{"text":"Please awaken in me that force which gives me security, a backbone. Then we can put our hand back on our lap.","start":389.86,"end":412.68,"words":[{"text":"Please","start":389.86,"end":390.1},{"text":"awaken","start":390.1,"end":390.48},{"text":"in","start":390.48,"end":390.74},{"text":"me","start":390.74,"end":390.86},{"text":"that","start":390.86,"end":391.12},{"text":"force","start":391.12,"end":391.42},{"text":"which","start":391.42,"end":391.72},{"text":"gives","start":391.72,"end":391.96},{"text":"me","start":391.96,"end":392.18},{"text":"security,","start":392.18,"end":393.36},{"text":"a","start":394.54,"end":394.54},{"text":"backbone.","start":394.54,"end":395.12},{"text":"Then","start":410.8,"end":411.22},{"text":"we","start":411.22,"end":411.28},{"text":"can","start":411.28,"end":411.42},{"text":"put","start":411.42,"end":411.56},{"text":"our","start":411.56,"end":411.78},{"text":"hand","start":411.78,"end":412.02},{"text":"back","start":412.02,"end":412.18},{"text":"on","start":412.18,"end":412.3},{"text":"our","start":412.3,"end":412.36},{"text":"lap.","start":412.36,"end":412.68}]},{"text":"Once again, take our right hand and place it on the left side of our neck, sort of between shoulder and neck, and move our head slightly to the right side.","start":413.96,"end":425.54,"words":[{"text":"Once","start":413.96,"end":414.24},{"text":"again,","start":414.24,"end":414.76},{"text":"take","start":414.76,"end":414.82},{"text":"our","start":414.82,"end":415.08},{"text":"right","start":415.08,"end":415.34},{"text":"hand","start":415.34,"end":415.6},{"text":"and","start":415.6,"end":415.84},{"text":"place","start":415.84,"end":416.08},{"text":"it","start":416.08,"end":416.34},{"text":"on","start":416.34,"end":416.54},{"text":"the","start":416.54,"end":416.7},{"text":"left","start":416.7,"end":417.14},{"text":"side","start":417.14,"end":417.4},{"text":"of","start":417.4,"end":417.6},{"text":"our","start":417.6,"end":417.74},{"text":"neck,","start":417.74,"end":418.28},{"text":"sort","start":420.2,"end":420.34},{"text":"of","start":420.34,"end":420.46},{"text":"between","start":420.46,"end":420.82},{"text":"shoulder","start":420.82,"end":421.2},{"text":"and","start":421.2,"end":421.48},{"text":"neck,","start":421.48,"end":422},{"text":"and","start":422.98,"end":423.24},{"text":"move","start":423.24,"end":423.46},{"text":"our","start":423.46,"end":423.7},{"text":"head","start":423.7,"end":423.92},{"text":"slightly","start":423.92,"end":424.2},{"text":"to","start":424.2,"end":424.5},{"text":"the","start":424.5,"end":424.66},{"text":"right","start":424.66,"end":424.86},{"text":"side.","start":424.86,"end":425.54}]},{"text":"This is the actual center for self-esteem and the knowledge of one's own worth, and it gets constricted by our feelings of guilt.","start":438.92,"end":449.66,"words":[{"text":"This","start":438.92,"end":439.14},{"text":"is","start":439.14,"end":439.44},{"text":"the","start":439.44,"end":439.96},{"text":"actual","start":439.96,"end":440.26},{"text":"center","start":440.26,"end":440.74},{"text":"for","start":440.74,"end":441.02},{"text":"self-esteem","start":441.02,"end":441.7},{"text":"and","start":441.7,"end":442.3},{"text":"the","start":443.9,"end":444.06},{"text":"knowledge","start":444.06,"end":444.3},{"text":"of","start":444.3,"end":444.62},{"text":"one's","start":444.62,"end":444.94},{"text":"own","start":444.94,"end":445.1},{"text":"worth,","start":445.1,"end":445.88},{"text":"and","start":446.92,"end":447.02},{"text":"it","start":447.02,"end":447.1},{"text":"gets","start":447.1,"end":447.26},{"text":"constricted","start":447.26,"end":447.98},{"text":"by","start":447.98,"end":448.14},{"text":"our","start":448.14,"end":448.34},{"text":"feelings","start":448.34,"end":448.58},{"text":"of","start":448.58,"end":448.9},{"text":"guilt.","start":448.9,"end":449.66}]},{"text":"So here we can say, I am not guilty. Mother Kundalini, I am not guilty at all.","start":451.4,"end":456.64,"words":[{"text":"So","start":451.4,"end":451.54},{"text":"here","start":451.54,"end":451.68},{"text":"we","start":451.68,"end":451.86},{"text":"can","start":451.86,"end":452.08},{"text":"say,","start":452.08,"end":452.56},{"text":"I","start":452.56,"end":452.6},{"text":"am","start":452.6,"end":452.82},{"text":"not","start":452.82,"end":453.02},{"text":"guilty.","start":453.02,"end":453.8},{"text":"Mother","start":454.28,"end":454.52},{"text":"Kundalini,","start":454.52,"end":455},{"text":"I","start":455,"end":455.3},{"text":"am","start":455.3,"end":455.5},{"text":"not","start":455.5,"end":455.7},{"text":"guilty","start":455.7,"end":455.9},{"text":"at","start":455.9,"end":456.26},{"text":"all.","start":456.26,"end":456.64}]},{"text":"We can repeat this several times, and we can ask, Mother Kundalini, please awaken in me self-esteem.","start":457.3,"end":480.66,"words":[{"text":"We","start":457.3,"end":457.56},{"text":"can","start":457.56,"end":457.56},{"text":"repeat","start":457.56,"end":457.78},{"text":"this","start":457.78,"end":458.12},{"text":"several","start":458.12,"end":458.36},{"text":"times,","start":458.36,"end":459.34},{"text":"and","start":476.1,"end":476.3},{"text":"we","start":476.3,"end":476.3},{"text":"can","start":476.3,"end":476.64},{"text":"ask,","start":476.64,"end":476.92},{"text":"Mother","start":476.92,"end":477.12},{"text":"Kundalini,","start":477.12,"end":478.02},{"text":"please","start":478.02,"end":478.02},{"text":"awaken","start":478.02,"end":478.5},{"text":"in","start":478.5,"end":478.74},{"text":"me","start":478.74,"end":479.12},{"text":"self-esteem.","start":479.52,"end":480.66}]},{"text":"Let me know my own worth and then we can put our right hand on the right side of our head, just ab