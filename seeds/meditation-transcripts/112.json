},{"text":"spine","start":33.36,"end":33.8},{"text":"where","start":33.8,"end":34.32},{"text":"lies","start":34.6,"end":34.84},{"text":"our","start":34.84,"end":35.12},{"text":"sacrum","start":35.12,"end":35.48},{"text":"bone,","start":35.48,"end":36.18},{"text":"the","start":37.16,"end":37.26},{"text":"seat","start":37.26,"end":37.52},{"text":"of","start":37.52,"end":37.84},{"text":"our","start":37.84,"end":38},{"text":"mother","start":38,"end":38.2},{"text":"Kundalini,","start":38.2,"end":39.28},{"text":"the","start":39.28,"end":39.38},{"text":"mothering","start":39.38,"end":39.82},{"text":"energy","start":39.82,"end":40.2},{"text":"that","start":40.2,"end":40.74},{"text":"lies","start":41.32,"end":41.52},{"text":"dormant","start":41.52,"end":42},{"text":"within","start":42,"end":42.2},{"text":"us.","start":42.2,"end":42.66}]},{"text":"Here we can ask, Mother Kundalini, please rise through my central channel.","start":59.88,"end":67.16,"words":[{"text":"Here","start":59.88,"end":60.12},{"text":"we","start":60.12,"end":60.3},{"text":"can","start":60.3,"end":60.6},{"text":"ask,","start":60.6,"end":61.18},{"text":"Mother","start":62.52,"end":62.96},{"text":"Kundalini,","start":62.96,"end":63.78},{"text":"please","start":63.78,"end":64.1},{"text":"rise","start":64.1,"end":65.16},{"text":"through","start":65.16,"end":65.92},{"text":"my","start":65.92,"end":66.24},{"text":"central","start":66.24,"end":66.7},{"text":"channel.","start":66.7,"end":67.16}]},{"text":"Up to the top of my head, to the chakra called Sahasrara Chakra, and please make me a balanced person.","start":68.74,"end":76.96,"words":[{"text":"Up","start":68.74,"end":69},{"text":"to","start":69,"end":69.22},{"text":"the","start":69.22,"end":69.26},{"text":"top","start":69.26,"end":69.46},{"text":"of","start":69.46,"end":69.64},{"text":"my","start":69.64,"end":69.78},{"text":"head,","start":69.78,"end":70.52},{"text":"to","start":70.52,"end":70.6},{"text":"the","start":70.6,"end":70.74},{"text":"chakra","st