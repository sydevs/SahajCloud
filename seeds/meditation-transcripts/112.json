":"While","start":619.12,"end":619.18},{"text":"doing","start":619.18,"end":619.42},{"text":"this,","start":619.42,"end":620.28},{"text":"we","start":620.58,"end":620.6},{"text":"can","start":620.6,"end":620.74},{"text":"do","start":620.74,"end":620.88},{"text":"it","start":620.88,"end":621},{"text":"three","start":621,"end":621.2},{"text":"times","start":621.2,"end":621.64},{"text":"while","start":621.64,"end":622.02},{"text":"slowly","start":622.02,"end":622.38},{"text":"saying","start":622.38,"end":622.78},{"text":"Aum","start":622.78,"end":623.22},{"text":"three","start":623.22,"end":623.6},{"text":"times.","start":623.6,"end":624.34}]},{"text":"And we can keep our right hand on the top of our heads and give a small massage clockwise around our head","start":664.76,"end":672.24,"words":[{"text":"And","start":664.76,"end":664.82},{"text":"we","start":664.82,"end":664.84},{"text":"can","start":664.84,"end":665.02},{"text":"keep","start":665.02,"end":665.22},{"text":"our","start":665.22,"end":665.44},{"text":"right","start":665.44,"end":665.68},{"text":"hand","start":665.68,"end":666.08},{"text":"on","start":666.08,"end":666.5},{"text":"the","start":667,"end":667.1},{"text":"top","start":667.1,"end":667.24},{"text":"of","start":667.24,"end":667.4},{"text":"our","start":667.4,"end":667.56},{"text":"heads","start":667.56,"end":667.94},{"text":"and","start":667.94,"end":668.44},{"text":"give","start":669.36,"end":669.5},{"text":"a","start":669.5,"end":669.7},{"text":"small","start":669.7,"end":669.94},{"text":"massage","start":669.94,"end":670.52},{"text":"clockwise","start":670.52,"end":671.2},{"text":"around","start":671.2,"end":671.72},{"text":"our","start":671.72,"end":671.96},{"text":"head","start":671.96,"end":672.24}]},{"text":"using the center of our palm in the center of our head.","start":673.62,"end":676.22,"words":[{"text":"using","start":673.62,"end":673.88},{"text":"the","start":673.88,"end":674.16},{"text":"center","start":674.16,"end":674.36},{"text":"