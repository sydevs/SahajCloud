1.58},{"text":"I","start":531.58,"end":531.78},{"text":"have","start":531.78,"end":531.98},{"text":"done","start":531.98,"end":532.14},{"text":"anything","start":532.14,"end":532.4},{"text":"wrong","start":532.4,"end":532.66},{"text":"to","start":532.66,"end":532.9},{"text":"anyone,","start":532.9,"end":533.54},{"text":"please","start":534.5,"end":534.76},{"text":"forgive","start":534.76,"end":535.14},{"text":"me.","start":535.14,"end":535.6}]},{"text":"Mother Kundalini, with your soothing light of love, please take away all my thoughts.","start":567.48,"end":576.48,"words":[{"text":"Mother","start":567.48,"end":567.76},{"text":"Kundalini,","start":567.76,"end":568.8},{"text":"with","start":570.08,"end":570.2},{"text":"your","start":570.2,"end":570.46},{"text":"soothing","start":570.46,"end":570.82},{"text":"light","start":570.82,"end":571.24},{"text":"of","start":571.24,"end":571.4},{"text":"love,","start":571.4,"end":572.34},{"text":"please","start":574.94,"end":574.94},{"text":"take","start":574.94,"end":575.16},{"text":"away","start":575.16,"end":575.42},{"text":"all","start":575.42,"end":575.56},{"text":"my","start":575.56,"end":575.72},{"text":"thoughts.","start":575.72,"end":576.48}]},{"text":"We can raise our hand to our Sahasrara, massaging our head clockwise.","start":614.04,"end":619.44,"words":[{"text":"We","start":614.04,"end":614.2},{"text":"can","start":614.2,"end":614.36},{"text":"raise","start":614.36,"end":614.52},{"text":"our","start":614.52,"end":614.88},{"text":"hand","start":614.88,"end":614.88},{"text":"to","start":614.88,"end":615},{"text":"our","start":615,"end":615.16},{"text":"Sahasrara,","start":615.16,"end":616.14},{"text":"massaging","start":617.78,"end":618.34},{"text":"our","start":618.34,"end":618.56},{"text":"head","start":618.56,"end":618.6},{"text":"clockwise.","start":618.6,"end":619.44}]},{"text":"If a hand is tired then you can place it back on your lap.","start":630.68,"end":633.36,"words":[{"text":"If","start":630.68,"end":630.9},{"text":"a","start":630.9,"end":631.06},{"text":"hand","start":631.06,"end":631.18},{"text":"is","start":631.18,"end":631.4},{"text":"tired","start":631.4,"end":631.6},{"text":"then","start":631.6,"end":631.84},{"text":"you","start":631.84,"end":631.94},{"text":"can","start":631.94,"end":632.02},{"text":"place","start":632.02,"end":632.22},{"text":"it","start":632.22,"end":632.42},{"text":"back","start":632.42,"end":632.5},{"text":"on","start":632.5,"end":632.58},{"text":"your","start":632.58,"end":632.72},{"text":"lap.","start":632.72,"end":633.36}]},{"text":"Here we can say, Mother I am the eternal light of love, that is joy.","start":636.9,"end":643.72,"words":[{"text":"Here","start":636.9,"end":637.08},{"text":"we","start":637.08,"end":637.16},{"text":"can","start":637.16,"end":637.32},{"text":"say,","start":637.32,"end":638.08},{"text":"Mother","start":639.82,"end":640},{"text":"I","start":640,"end":640.26},{"text":"am","start":640.26,"end":640.38},{"text":"the","start":640.38,"end":640.52},{"text":"eternal","start":640.52,"end":640.84},{"text":"light","start":640.84,"end":641.14},{"text":"of","start":641.14,"end":641.38},{"text":"love,","start":641.38,"end":641.94},{"text":"that","start":642.68,"end":642.9},{"text":"is","start":642.9,"end":643.12},{"text":"joy.","start":643.12,"end":643.72}]},{"text":"I can just say seven times inside, I am joy.","start":645.64,"end":650.5,"words":[{"text":"I","start":645.64,"end":645.76},{"text":"can","start":645.76,"end":645.9},{"text":"just","start":645.9,"end":646.16},{"text":"say","start":646.16,"end":646.7},{"text":"seven","start":647.06,"end":647.52},{"text":"times","start":647.52,"end":647.8},{"text":"inside,","start":647.8,"end":648.56},{"text":"I","start":649.36,"end":649.68},{"text":"am","start":649.68,"end":649.92},{"text":"joy.","start":649.92,"end":650.5}]},{"text":"We can place our hand back on our lap and we can pray inside.","start":685.92,"end":694.06,"words":[{"text":"We","start":685.92,"end":686.02},{"text":"can","start":686.02,"end":686.18},{"text":"place","start":686.18,"end":686.4},{"text":"our","start":686.4,"end":686.58},{"text":"hand","start":686.58,"end":686.74},{"text":"back","start":686.74,"end":686.96},{"text":"on","start":686.96,"end":687.14},{"text":"our","start":687.14,"end":687.18},{"text":"lap","start":687.18,"end":687.48},{"text":"and","start":692.6,"end":693.06},{"text":"we","start":693.06,"end":693.16},{"text":"can","start":693.16,"end":693.16},{"text":"pray","start":693.16,"end":693.32},{"text":"inside.","start":693.32,"end":694.06}]},{"text":"Mother Kundalini, let your light of joy spread to my face so that it can shine.","start":698.08,"end":707.48,"words":[{"text":"Mother","start":698.08,"end":698.28},{"text":"Kundalini,","start":698.28,"end":699.32},{"text":"let","start":701.64,"end":701.76},{"text":"your","start":701.76,"end":702},{"text":"light","start":702,"end":702.3},{"text":"of","start":702.3,"end":702.52},{"text":"joy","start":702.52,"end":702.94},{"text":"spread","start":702.94,"end":703.6},{"text":"to","start":704.64,"end":704.82},{"text":"my","start":704.82,"end":705},{"text":"face","start":705,"end":705.56},{"text":"so","start":705.56,"end":706.14},{"text":"that","start":706.14,"end":706.42},{"text":"it","start":706.42,"end":706.6},{"text":"can","start":706.6,"end":706.78},{"text":"shine.","start":706.78,"end":707.48}]},{"text":"Spread to my eyes so that they are pure and joy-giving.","start":709.42,"end":714.2,"words":[{"text":"Spread","start":709.42,"end":709.64},{"text":"to","start":709.64,"end":709.82},{"text":"my","start":709.82,"end":709.92},{"text":"eyes","start":709.92,"end":710.7},{"text":"so","start":710.7,"end":711.22},{"text":"that","start":712.32,"end":712.44},{"text":"they","start":712.44,"end":712.56},{"text":"are","start":712.56,"end":712.64},{"text":"pure","start":712.64,"end":712.98},{"text":"and","start":712.98,"end":713.3},{"text":"joy-giving.","start":713.3,"end":714.2}]},{"text":"Spread to my actions so that I am generous and kind.","start":717.5,"end":722.4,"words":[{"text":"Spread","start":717.5,"end":717.68},{"text":"to","start":717.68,"end":717.86},{"text":"my","start":717.86,"end":717.96},{"text":"actions","start":717.96,"end":718.44},{"text":"so","start":718.44,"end":719.26},{"text":"that","start":721.12,"end":721.24},{"text":"I","start":721.24,"end":721.36},{"text":"am","start":721.36,"end":721.64},{"text":"generous","start":721.64,"end":721.82},{"text":"and","start":721.82,"end":722.08},{"text":"kind.","start":722.08,"end":722.4}]},{"text":"And spread to my whole being so that I am a joyful person who is completely still inside and outside.","start":726.52,"end":748.38,"words":[{"text":"And","start":726.52,"end":726.66},{"text":"spread","start":726.66,"end":726.9},{"text":"to","start":726.9,"end":727.04},{"text":"my","start":727.04,"end":727.2},{"text":"whole","start":727.2,"end":727.4},{"text":"being","start":727.4,"end":727.96},{"text":"so","start":733.12,"end":733.56},{"text":"that","start":733.56,"end":733.72},{"text":"I","start":733.72,"end":733.76},{"text":"am","start":733.76,"end":733.88},{"text":"a","start":733.88,"end":733.92},{"text":"joyful","start":733.92,"end":734.18},{"text":"person","start":734.18,"end":734.84},{"text":"who","start":734.84,"end":735.28},{"text":"is","start":738.24,"end":738.38},{"text":"completely","start":738.38,"end":738.74},{"text":"still","start":738.74,"end":739.48},{"text":"inside","start":743.58,"end":744.36},{"text":"and","start":744.36,"end":745},{"text":"outside.","start":747.42,"end":748.38}]},{"text":"Being joyful is not being happy or excited. It is a state that is beyond. You do not have to smile all the time.","start":781,"end":795.16,"words":[{"text":"Being","start":781,"end":781.18},{"text":"joyful","start":781.18,"end":781.52},{"text":"is","start":781.52,"end":781.86},{"text":"not","start":781.86,"end":782.08},{"text":"being","start":782.08,"end":782.34},{"text":"happy","start":782.34,"end":782.74},{"text":"or","start":782.74,"end":783.02},{"text":"excited.","start":783.02,"end":783.92},{"text":"It","start":787.26,"end":787.44},{"text":"is","start":787.44,"end":787.54},{"text":"a","start":787.54,"end":787.8},{"text":"state","start":787.8,"end":788.14},{"text":"that","start":788.14,"end":788.64},{"text":"is","start":789.76,"end":789.9},{"text":"beyond.","start":789.9,"end":790.5},{"text":"You","start":792.8,"end":793},{"text":"do","start":793,"end":793.16},{"text":"not","start":793.16,"end":793.26},{"text":"have","start":793.26,"end":793.44},{"text":"to","start":793.44,"end":793.62},{"text":"smile","start":793.62,"end":793.98},{"text":"all","start":793.98,"end":794.34},{"text":"the","start":794.34,"end":794.46},{"text":"time.","start":794.46,"end":795.16}]},{"text":"It is a state of peace you feel, a state of satisfaction, a state of inner contentment that can only be fulfilled by the spirit.","start":797.66,"end":812,"words":[{"text":"It","start":797.66,"end":797.72},{"text":"is","start":797.72,"end":797.9},{"text":"a","start":797.9,"end":798.04},{"text":"state","start":798.04,"end":798.14},{"text":"of","start":798.14,"end":798.4},{"text":"peace","start":798.4,"end":798.84},{"text":"you","start":798.84,"end":799.16},{"text":"feel,","start":799.16,"end":800.02},{"text":"a","start":801.64,"end":801.64},{"text":"state","start":801.64,"end":801.74},{"text":"of","start":801.74,"end":801.94},{"text":"satisfaction,","start":801.94,"end":803.18},{"text":"a","start":805.46,"end":805.46},{"text":"state","start":805.46,"end":805.58},{"text":"of","start":805.58,"end":805.9},{"text":"inner","start":805.9,"end":806.06},{"text":"contentment","start":806.06,"end":806.8},{"text":"that","start":806.8,"end":807.16},{"text":"can","start":809.44,"end":809.64},{"text":"only","start":809.64,"end":809.92},{"text":"be","start":809.92,"end":810.24},{"text":"fulfilled","start":810.24,"end":810.62},{"text":"by","start":810.62,"end":811.26},{"text":"the","start":811.26,"end":811.46},{"text":"spirit.","start":811.46,"end":812}]},{"text":"We can just sit in meditation on these words.","start":821.58,"end":824.46,"words":[{"text":"We","start":821.58,"end":821.6},{"text":"can","start":821.6,"end":821.74},{"text":"just","start":821.74,"end":822},{"text":"sit","start":822,"end":822.22},{"text":"in","start":822.22,"end":822.34},{"text":"meditation","start":822.34,"end":822.8},{"text":"on","start":822.8,"end":823.72},{"text":"these","start":823.72,"end":823.92},{"text":"words.","start":823.92,"end":824.46}]},{"text":"Thank you for listening. I wish you a joyful day and if you feel the desire, you can continue meditating, feeling the joy in your heart.","start":858.42,"end":871.6,"words":[{"text":"Thank","start":858.42,"end":858.68},{"text":"you","start":858.68,"end":858.9},{"text":"for","start":858.9,"end":858.96},{"text":"listening.","start":858.96,"end":859.92},{"text":"I","start":859.92,"end":860.06},{"text":"wish","start":860.06,"end":860.28},{"text":"you","start":860.28,"end":860.46},{"text":"a","start":860.46,"end":860.52},{"text":"joyful","start":860.52,"end":860.8},{"text":"day","start":860.8,"end":861.28},{"text":"and","start":862.76,"end":863.16},{"text":"if","start":863.16,"end":863.32},{"text":"you","start":863.32,"end":863.36},{"text":"feel","start":863.36,"end":863.62},{"text":"the","start":863.62,"end":863.76},{"text":"desire,","start":863.76,"end":864.8},{"text":"you","start":865.7,"end":865.7},{"text":"can","start":865.7,"end":866.02},{"text":"continue","start":866.02,"end":866.42},{"text":"meditating,","start":866.42,"end":867.56},{"text":"feeling","start":870.14,"end":870.38},{"text":"the","start":870.38,"end":870.64},{"text":"joy","start":870.64,"end":870.88},{"text":"in","start":870.88,"end":871.12},{"text":"your","start":871.12,"end":871.36},{"text":"heart.","start":871.36,"end":871.6}]}]}
