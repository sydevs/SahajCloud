","start":488.24,"end":488.34},{"text":"just","start":488.34,"end":488.62},{"text":"face","start":488.62,"end":488.88},{"text":"myself.","start":488.88,"end":489.68}]},{"text":"Mother Kundalini, I am not guilty of anything.","start":495.56,"end":499,"words":[{"text":"Mother","start":495.56,"end":495.82},{"text":"Kundalini,","start":495.82,"end":496.72},{"text":"I","start":496.72,"end":496.84},{"text":"am","start":496.84,"end":497.06},{"text":"not","start":497.06,"end":497.34},{"text":"guilty","start":497.34,"end":497.66},{"text":"of","start":497.66,"end":498.3},{"text":"anything.","start":498.3,"end":499}]},{"text":"Mother Kundalini, please dissolve this false sense of guilt that only clouds my spirit.","start":512.76,"end":520.86,"words":[{"text":"Mother","start":512.76,"end":513.06},{"text":"Kundalini,","start":513.06,"end":514},{"text":"please","start":514,"end":514},{"text":"dissolve","start":514,"end":515.06},{"text":"this","start":515.06,"end":516.12},{"text":"false","start":516.12,"end":516.62},{"text":"sense","start":516.62,"end":516.98},{"text":"of","start":516.98,"end":517.26},{"text":"guilt","start":517.26,"end":517.66},{"text":"that","start":517.66,"end":518.18},{"text":"only","start":518.74,"end":519.4},{"text":"clouds","start":519.4,"end":520},{"text":"my","start":520,"end":520.42},{"text":"spirit.","start":520.42,"end":520.86}]},{"text":"We move our right hand across our forehead.","start":542.68,"end":545.84,"words":[{"text":"We","start":542.68,"end":542.78},{"text":"move","start":542.78,"end":543.06},{"text":"our","start":543.06,"end":543.28},{"text":"right","start":543.28,"end":543.54},{"text":"hand","start":543.54,"end":543.86},{"text":"across","start":543.86,"end":544.42},{"text":"our","start":544.42,"end":544.8},{"text":"forehead.","start":544.8,"end":545.84}]},{"text":"Mother Kundalini, I forgive.","start":550.48,"end":554.2,"words":[{"text":"Mother","start":550.48,"end":550.82},{"text":"Kundalini,","start":550.82,"end":552.08},{"text":"I","sta