ence within.","start":744.66,"end":748.14,"words":[{"text":"Please","start":744.66,"end":744.92},{"text":"continue","start":744.92,"end":745.46},{"text":"and","start":745.46,"end":746.12},{"text":"find","start":746.86,"end":747.06},{"text":"that","start":747.06,"end":747.3},{"text":"confidence","start":747.3,"end":747.62},{"text":"within.","start":747.62,"end":748.14}]}]}
