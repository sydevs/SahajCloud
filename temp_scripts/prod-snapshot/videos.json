    "subtitles": [
      {
        "content": "A footsoak is a technique done",
        "endTimeMs": 1680,
        "durationMs": 1520,
        "startTimeMs": 160
      },
      {
        "content": "to remove any imbalance",
        "endTimeMs": 3000,
        "durationMs": 1320,
        "startTimeMs": 1680
      },
      {
        "content": "or stress you could have",
        "endTimeMs": 3960,
        "durationMs": 960,
        "startTimeMs": 3000
      },
      {
        "content": "accumulated over the day.",
        "endTimeMs": 5280,
        "durationMs": 1320,
        "startTimeMs": 3960
      },
      {
        "content": "For this you will need",
        "endTimeMs": 6859,
        "durationMs": 920,
        "startTimeMs": 5939
      },
      {
        "content": "a bucket, a jug,",
        "endTimeMs": 8819,
        "durationMs": 1960,
        "startTimeMs": 6859
      },
      {
        "content": "a towel and some salt.",
        "endTimeMs": 10500,
        "durationMs": 1681,
        "startTimeMs": 8819
      },
      {
        "content": "Put some salt into the bucket.",
        "endTimeMs": 13939,
        "durationMs": 2239,
        "startTimeMs": 11700
      },
      {
        "content": "The salt symbolizes the earth",
        "endTimeMs": 17180,
        "durationMs": 1961,
        "startTimeMs": 15219
      },
      {
        "content": "and has the power to absorb",
        "endTimeMs": 18660,
        "durationMs": 1480,
        "startTimeMs": 17180
      },
      {
        "content": "just like the sea does.",
        "endTimeMs": 19779,
        "durationMs": 1119,
        "startTimeMs": 18660
      },
      {
        "content": "Now place your feet",
        "endTimeMs": 21740,
        "durationMs": 920,
        "startTimeMs": 20820
      },
      {
        "content": "in the bucket and put your",
        "endTimeMs": 26696,
        "durationMs": 4956,
        "startTimeMs": 21740
      },
      {
        "content": "hands on your lap,",
        "endTimeMs": 27896,
        "durationMs": 1200,
        "startTimeMs": 26696
      },
      {
        "content": "palm facing upwards.",
        "endTimeMs": 28936,
        "durationMs": 1040,
        "startTimeMs": 27896
      },
      {
        "content": "Ask the water to please",
        "endTimeMs": 33256,
        "durationMs": 1520,
        "startTimeMs": 31736
      },
      {
        "content": "absorb all the imbalances",
        "endTimeMs": 34816,
        "durationMs": 1560,
        "startTimeMs": 33256
      },
      {
        "content": "and tensions of the day.",
        "endTimeMs": 36136,
        "durationMs": 1320,
        "startTimeMs": 34816
      },
      {
        "content": "Feel how the water gently",
        "endTimeMs": 41095,
        "durationMs": 1439,
        "startTimeMs": 39656
      },
      {
        "content": "absorbs all your stress.",
        "endTimeMs": 42456,
        "durationMs": 1361,
        "startTimeMs": 41095
      },
      {
        "content": "Once you feel balanced or",
        "endTimeMs": 46486,
        "durationMs": 2190,
        "startTimeMs": 44296
      },
      {
        "content": "After five to ten minutes",
        "endTimeMs": 47896,
        "durationMs": 1410,
        "startTimeMs": 46486
      },
      {
        "content": "rinse your feet with",
        "endTimeMs": 50256,
        "durationMs": 1080,
        "startTimeMs": 49176
      },
      {
        "content": "the clean water in the jug.",
        "endTimeMs": 51736,
        "durationMs": 1480,
        "startTimeMs": 50256
      },
      {
        "content": "At the end.",
        "endTimeMs": 56646,
        "durationMs": 800,
        "startTimeMs": 55846
      },
      {
        "content": "Throw your dirty footsoak",
        "endTimeMs": 57606,
        "durationMs": 960,
        "startTimeMs": 56646
      },
      {
        "content": "water in the toilet",
        "endTimeMs": 58966,
        "durationMs": 1360,
        "startTimeMs": 57606
      },
      {
        "content": "and rinse your bucket.",
        "endTimeMs": 60966,
        "durationMs": 1200,
        "startTimeMs": 59766
      },
      {
        "content": "It is best not to use",
        "endTimeMs": 63206,
        "durationMs": 1520,
        "startTimeMs": 61686
      },
      {
        "content": "the bucket for other purposes.",
        "endTimeMs": 64726,
        "durationMs": 1520,
        "startTimeMs": 63206
      },
      {
        "content": "Keep it exclusively",
        "endTimeMs": 66486,
        "durationMs": 1200,
        "startTimeMs": 65286
      },
      {
        "content": "for foot soaking.",
        "endTimeMs": 67446,
        "durationMs": 960,
        "startTimeMs": 66486
      },
      {
        "content": "You can put your hands",
        "endTimeMs": 69886,
        "durationMs": 1080,
        "startTimeMs": 68806
